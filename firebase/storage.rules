rules_version = '2';
// Lesson Studio's Storage. The server (Admin SDK: scripts/darsi/push.ts, the functions) bypasses these rules.
//
// media/<sha256>.<ext>: lessons' narration and scenes' voice clips, named by their content (packages/ops/src/media.ts,
// voice.ts). Anyone may fetch a file by its name, because an <audio> element can't send a sign-in; a name is a
// 64-character hash that only appears in a lesson's manifest or voice documents, which only the lesson's members can
// read. Nobody may list the files, and only the server writes them.
//
// uploads/<uid>/<name>: a recording or audio file on its way to the voiceClip function, which reads it with the Admin
// SDK and deletes it. Only its owner, with access to the studio, may put one there: audio (or a video's sound), up to
// 25 MB, never replacing a file. Nobody reads them back.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{file} {
      allow get: if file.matches('^[0-9a-f]{64}[.][a-z0-9]{1,8}$');
    }
    match /uploads/{uid}/{name} {
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.studio == true
        && name.matches('^[A-Za-z0-9._-]{1,100}$')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(audio|video)/[A-Za-z0-9.+-]+');
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
