{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lessonstudio.dev/schema/0.2/manifest.schema.json",
  "title": "Lesson Package manifest v0.2",
  "description": "Shape only. Cross-file rules (timing durations, cue targets, Arabic separators) live in validatePackage() in packages/spec/src/validate.ts.",
  "type": "object",
  "required": [
    "spec",
    "version",
    "id",
    "rev",
    "title",
    "defaultLang",
    "languages",
    "provenance",
    "ai"
  ],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "const": "lesson-package"
    },
    "version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "rev": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "topic": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "defaultLang": {
      "$ref": "#/$defs/lang"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "dir",
          "name",
          "duration",
          "timing"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/$defs/lang"
          },
          "dir": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600
          },
          "timing": {
            "$ref": "#/$defs/path"
          },
          "audio": {
            "$ref": "#/$defs/path"
          },
          "audioFallback": {
            "$ref": "#/$defs/path"
          },
          "captions": {
            "$ref": "#/$defs/path"
          },
          "quality": {
            "enum": [
              "reviewed",
              "machine",
              "draft"
            ]
          },
          "voice": {
            "type": "object",
            "required": [
              "provider",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "style": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "brand": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "stage": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ]
    },
    "poster": {
      "$ref": "#/$defs/path"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "licences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "licence"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "createdAt",
        "createdBy",
        "tool"
      ],
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://\\S+$"
              }
            }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "required": [
        "script",
        "translation",
        "narration",
        "visuals",
        "avatar"
      ],
      "additionalProperties": false,
      "properties": {
        "script": {
          "$ref": "#/$defs/origin"
        },
        "translation": {
          "enum": [
            "human",
            "ai-assisted",
            "ai",
            "none"
          ]
        },
        "narration": {
          "enum": [
            "human",
            "synthetic",
            "none"
          ]
        },
        "visuals": {
          "$ref": "#/$defs/origin"
        },
        "avatar": {
          "enum": [
            "none",
            "stylised",
            "photo",
            "live"
          ]
        }
      }
    },
    "reviewed": {
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        }
      }
    }
  },
  "$defs": {
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "origin": {
      "enum": [
        "human",
        "ai-assisted",
        "ai"
      ]
    },
    "text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/lang"
          }
        }
      ]
    }
  }
}
