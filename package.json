{
  "name": "lessonstudio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/spec",
    "packages/ops",
    "packages/narrate",
    "packages/player",
    "apps/playground",
    "apps/server",
    "apps/studio"
  ],
  "scripts": {
    "build": "npm run build -w @lessonstudio/spec && npm run build -w @lessonstudio/player",
    "typecheck": "tsc -p packages/spec && tsc -p packages/ops && tsc -p packages/narrate && tsc -p packages/player && tsc -p apps/playground && tsc -p apps/server && tsc -p apps/studio",
    "test": "vitest run",
    "timing": "node scripts/make-timing.mjs",
    "narrate": "node --env-file-if-exists=.env.local scripts/narrate.mjs",
    "check": "node scripts/check-examples.mjs",
    "size": "node scripts/size.mjs",
    "dev": "npm run dev -w @lessonstudio/playground",
    "e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-lessonstudio --only auth,firestore",
    "studio": "npm run dev -w @lessonstudio/studio"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.0",
    "ajv": "8.20.0",
    "esbuild": "0.27.7",
    "ffmpeg-static": "5.3.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.33.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
