# Copy to .env.local (gitignored) and fill in what you use. Never commit real values.

# Narration (npm run narrate)
GEMINI_API_KEY=

# --- The server (npm start -w @lessonstudio/server) ---
# Lessons: "file" keeps them in .data/ on this PC; "firestore" uses the Firebase project.
# LS_STORE=firestore
# LS_FIREBASE_PROJECT=your-project-id
# The Admin SDK key file goes to .secrets/firebase-admin.json (or set LS_FIREBASE_KEY to its path).
# LS_PORT=4320
# The account stdio and local HTTP clients act as: your Firebase uid, so online and local share lessons.
# LS_LOCAL_UID=local

# --- Online through ngrok (ChatGPT, claude.ai) ---
# LS_PUBLIC_URL=https://your-domain.ngrok.app
# 32+ random characters; signs access tokens. Changing it signs everyone out.
# MCP_TOKEN_SECRET=
# Google sign-in: comma-separated emails allowed to approve, and the Firebase web config.
# LS_ALLOWED_EMAILS=you@example.com
# LS_FIREBASE_API_KEY=
# LS_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Or, before Firebase exists: approve sign-ins with a passcode (12+ characters); you sign in as LS_LOCAL_UID.
# LS_APPROVE_PASSCODE=
# LS_STUDIO_URL=https://your-project-id.web.app

# --- The studio (npm run studio) ---
# The Firebase web config (public; it ships in the app). Without it, or with VITE_EMULATORS=1, the studio uses the emulators.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# VITE_FIREBASE_APP_ID=
# VITE_EMULATORS=1
