      "arrows": true,
      "cards": [
        {
          "icon": "phone",
          "text": {
            "en": "7 am: a parent calls",
            "ar-EG": "7 الصبح: ولي أمر بيتصل"
          },
          "s": 0
        },
        {
          "icon": "megaphone",
          "text": {
            "en": "The page sells “laptops”",
            "ar-EG": "الصفحة بتبيع «لابتوبات»"
          },
          "tone": "danger",
          "s": 1
        },
        {
          "icon": "help",
          "text": {
