{
  "scenes": {
    "1": {
      "quote": {
        "en": "A detector said: ninety per cent AI. The pupil had written every word herself, in her second language.",
        "ar-EG": "برنامج كشف قال: تسعين في المية ذكاء اصطناعي. والتلميذة كانت كاتبة كل كلمة بنفسها، بلغتها التانية."
      },
      "mood": "curious",
      "cards": [
        {
          "icon": "gauge",
          "tone": "danger",
          "text": {
            "en": "“90% AI”",
            "ar-EG": "«90% ذكاء اصطناعي»"
          },
          "s": 0
        },
        {
          "icon": "pencil",
          "tone": "ok",
          "text": {
            "en": "She wrote every word",
            "ar-EG": "كتبت كل كلمة بنفسها"
          },
          "s": 1
        },
        {
          "icon": "language",
          "text": {
            "en": "In her second language",
            "ar-EG": "بلغتها التانية"
          },
          "s": 1,
          "o": 2.5
        }
      ]
    },
    "3": {
      "list": [
        {
          "icon": "search",
