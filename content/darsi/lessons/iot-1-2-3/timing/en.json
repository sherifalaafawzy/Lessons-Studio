.39},{"w":"than","s":39.39,"e":39.83},{"w":"a","s":39.83,"e":39.95},{"w":"narrow","s":39.95,"e":40.19},{"w":"one.","s":40.19,"e":40.47},{"w":"But","s":41.07,"e":41.29},{"w":"if","s":41.29,"e":41.51},{"w":"both","s":41.51,"e":41.79},{"w":"have","s":41.79,"e":42.05},{"w":"straight","s":42.05,"e":42.45},{"w":"sides,","s":42.45,"e":42.85},{"w":"the","s":42.85,"e":43.35},{"w":"water","s":43.35,"e":43.65},{"w":"stands","s":43.65,"e":44.09},{"w":"at","s":44.09,"e":44.27},{"w":"the","s":44.27,"e":44.41},{"w":"same","s":44.41,"e":44.71},{"w":"depth","s":44.71,"e":45.03},{"w":"in","s":45.03,"e":45.37},{"w":"each.","s":45.37,"e":45.55}]},{"id":"s05","start":46.52,"end":55.54,"sentences":[{"text":"A rain gauge is a container that collects rain so you can measure its depth.","start":46.87,"end":51.59},{"text":"And you can make one from a clear plastic bottle.","start":52.04,"end":54.84}],"words":[{"w":"A","s":46.87,"e":46.99},{"w":"rain","s":46.99,"e":47.29},{"w":"gauge","s":47.29,"e":47.61},{"w":"is","s":47.61,"e":48.05},{"w":"a","s":48.05,"e":48.15},{"w":"container","s":48.15,"e":48.39},{"w":"that","s":48.39,"e":48.87},{"w":"collects","s":48.87,"e":49.23},{"w":"rain","s":49.23,"e":49.67},{"w":"so","s":49.67,"e":50.25},{"w":"you","s":50.25,"e":50.45},{"w":"can","s":50.45,"e":50.61},{"w":"measure","s":50.61,"e":50.89},{"w":"its","s":50.89,"e":51.13},{"w":"depth.","s":51.13,"e":51.37},{"w":"And","s":52.04,"e":52.24},{"w":"you","s":52.24,"e":52.44},{"w":"can","s":52.44,"e":52.62},{"w":"make","s":52.62,"e":52.84},{"w":"one","s":52.84,"e":53.08},{"w":"from","s":53.08,"e":53.3},{"w":"a","s":53.3,"e":53.46},{"w":"clear","s":53.46,"e":53.76},{"w":"plastic","s":53.76,"e":54.26},{"w":"bottle.","s":54.26,"e":54.66}]},{"id":"s06","start":55.54,"end":76.68,"sentences":[{"text":"Choose a bottle with straight sides.","start":55.89,"end":58.25},{"text":"An adult cuts off the top where it starts to curve, and tapes the sharp edge.","start":58.7,"end":63.55},{"text":"Add a few stones, then water just to cover them — mark that level zero.","start":64,"end":69.59},{"text":"Tape a millimetre scale up from zero.","start":70.04,"end":73},{"text":"Turn the top upside down to make a funnel.","start":73.45,"end":75.98}],"words":[{"w":"Choose","s":55.89,"e":56.17},{"w":"a","s":56.17,"e":56.43},{"w":"bottle","s":56.43,"e":56.75},{"w":"with","s":56.75,"e":57.09},{"w":"straight","s":57.09,"e":57.51},{"w":"sides.","s":57.51,"e":57.91},{"w":"An","s":58.7,"e":58.88},{"w":"adult","s":58.88,"e":59.18},{"w":"cuts","s":59.18,"e":59.52},{"w":"off","s":59.52,"e":59.74},{"w":"the","s":59.74,"e":59.9},{"w":"top","s":59.9,"e":60.18},{"w":"where","s":60.18,"e":60.54},{"w":"it","s":60.54,"e":60.68},{"w":"starts","s":60.68,"e":60.88},{"w":"to","s":60.88,"e":61.14},{"w":"curve,","s":61.14,"e":61.46},{"w":"and","s":62.06,"e":62.2},{"w":"tapes","s":62.2,"e":62.66},{"w":"the","s":62.66,"e":62.78},{"w":"sharp","s":62.78,"e":63},{"w":"edge.","s":63,"e":63.3},{"w":"Add","s":64,"e":64.34},{"w":"a","s":64.34,"e":64.48},{"w":"few","s":64.48,"e":64.7},{"w":"stones,","s":64.7,"e":65.02},{"w":"then","s":65.02,"e":65.92},{"w":"water","s":65.92,"e":66.36},{"w":"just","s":66.36,"e":66.76},{"w":"to","s":66.76,"e":67},{"w":"cover","s":67,"e":67.26},{"w":"them","s":67.26,"e":67.48},{"w":"—","s":67.48,"e":68.12},{"w":"mark","s":68.12,"e":68.38},{"w":"that","s":68.38,"e":68.66},{"w":"level","s":68.66,"e":68.9},{"w":"zero.","s":68.9,"e":69.34},{"w":"Tape","s":70.04,"e":70.44},{"w":"a","s":70.44,"e":70.56},{"w":"millimetre","s":70.56,"e":71.24},{"w":"scale","s":71.24,"e":71.58},{"w":"up","s":71.58,"e":72.02},{"w":"from","s":72.02,"e":72.42},{"w":"zero.","s":72.42,"e":72.74},{"w":"Turn","s":73.45,"e":73.63},{"w":"the","s":73.63,"e":73.81},{"w":"top","s":73.81,"e":74.15},{"w":"upside","s":74.15,"e":74.57},{"w":"down","s":74.57,"e":74.95},{"w":"to","s":74.95,"e":75.33},{"w":"make","s":75.33,"e":75.51},{"w":"a","s":75.51,"e":75.63},{"w":"funnel.","s":75.63,"e":75.85}]},{"id":"s07","start":76.68,"end":86.33,"s