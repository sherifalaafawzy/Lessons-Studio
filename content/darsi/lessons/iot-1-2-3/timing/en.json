"w":"the","s":94.32,"e":94.64},{"w":"reading","s":94.64,"e":95},{"w":"is","s":95,"e":95.42},{"w":"too","s":95.42,"e":95.66},{"w":"high.","s":95.66,"e":95.92},{"w":"Straight","s":96.56,"e":96.9},{"w":"sides","s":96.9,"e":97.38},{"w":"keep","s":97.38,"e":97.86},{"w":"every","s":97.86,"e":98.44},{"w":"millimetre","s":98.44,"e":99.22},{"w":"true.","s":99.22,"e":99.54}]},{"id":"s09","start":100.31,"end":118.01,"sentences":[{"text":"Now, where to put it.","start":100.66,"end":102.58},{"text":"Choose open ground, well away from roofs, walls and trees.","start":103.03,"end":108.03},{"text":"Trees block the rain.","start":108.48,"end":110.03},{"text":"Roofs drip extra water in.","start":110.48,"end":112.69},{"text":"Stand it upright and firm, with stones around it if it’s windy.","start":113.14,"end":117.31}],"words":[{"w":"Now,","s":100.66,"e":100.98},{"w":"where","s":101.3,"e":101.62},{"w":"to","s":101.62,"e":102},{"w":"put","s":102,"e":102.24},{"w":"it.","s":102.24,"e":102.4},{"w":"Choose","s":103.03,"e":103.43},{"w":"open","s":103.43,"e":103.99},{"w":"ground,","s":103.99,"e":104.49},{"w":"well","s":104.91,"e":105.19},{"w":"away","s":105.19,"e":105.59},{"w":"from","s":105.59,"e":105.85},{"w":"roofs,","s":105.85,"e":106.25},{"w":"walls","s":106.59,"e":106.99},{"w":"and","s":106.99,"e":107.43},{"w":"trees.","s":107.43,"e":107.93},{"w":"Trees","s":108.48,"e":108.94},{"w":"block","s":108.94,"e":109.32},{"w":"the","s":109.32,"e":109.56},{"w":"rain.","s":109.56,"e":109.78},{"w":"Roofs","s":110.48,"e":111.06},{"w":"drip","s":111.06,"e":111.38},{"w":"extra","s":111.38,"e":111.86},{"w":"water","s":111.86,"e":112.22},{"w":"in.","s":112.22,"e":112.54},{"w":"Stand","s":113.14,"e":113.52},{"w":"it","s":113.52,"e":113.74},{"w":"upright","s":113.74,"e":114.14},{"w":"and","s":114.14,"e":114.66},{"w":"firm,","s":114.66,"e":115.02},{"w":"with","s":115.38,"e":115.66},{"w":"stones","s":115.66,"e":116.02},{"w":"around","s":116.02,"e":116.28},{"w":"it","s":116.28,"e":116.52},{"w":"if","s":116.