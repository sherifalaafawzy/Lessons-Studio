,"e":135.1},{"w":"empty","s":135.46,"e":135.74},{"w":"it","s":135.74,"e":135.92},{"w":"fully","s":135.92,"e":136.32},{"w":"and","s":136.32,"e":136.96},{"w":"refill","s":136.96,"e":137.38},{"w":"to","s":137.38,"e":137.74},{"w":"zero,","s":137.74,"e":138.14},{"w":"so","s":138.7,"e":138.92},{"w":"mosquitoes","s":138.92,"e":139.34},{"w":"can’t","s":139.34,"e":139.96},{"w":"breed.","s":139.96,"e":140.12}]},{"id":"s11","start":141.06,"end":150.02,"sentences":[{"text":"Your turn.","start":141.41,"end":142.11},{"text":"My pupils want to put the gauge under the big neem tree, where it’s safe from goats.","start":142.56,"end":147.91},{"text":"Good idea?","start":148.36,"end":149.32}],"words":[{"w":"Your","s":141.41,"e":141.69},{"w":"turn.","s":141.69,"e":141.95},{"w":"My","s":142.56,"e":143.04},{"w":"pupils","s":143.04,"e":143.46},{"w":"want","s":143.46,"e":143.86},{"w":"to","s":143.86,"e":144.08},{"w":"put","s":144.08,"e":144.26},{"w":"the","s":144.26,"e":144.44},{"w":"gauge","s":144.44,"e":144.8},{"w":"under","s":144.8,"e":145.14},{"w":"the","s":145.14,"e":145.34},{"w":"big","s":145.34,"e":145.58},{"w":"neem","s":145.58,"e":145.9},{"w":"tree,","s":145.9,"e":146.18},{"w":"where","s":146.44,"e":146.6},{"w":"it’s","s":146.6,"e":146.92},{"w":"safe","s":146.92,"e":147.1},{"w":"from","s":147.1,"e":147.34},{"w":"goats.","s":147.34,"e":147.58},{"w":"Good","s":148.36,"e":148.62},{"w":"idea?","s":148.62,"e":149.02}]},{"id":"s12","start":150.02,"end":167.57,"sentences":[{"text":"Not a good idea — the leaves catch the rain.","start":150.37,"end":153.59},{"text":"Choose an open spot, and keep goats away another way.","start":154.04,"end":158.16},{"text":"Remember: straight sides, a funnel, a millimetre scale, open ground, same time every day.","start":158.61,"end":166.87}],"words":[{"w":"Not","s":150.37,"e":150.69},{"w":"a","s":150.69,"e":150.95},{"w":"good","s":150.95,"e":151.07},{"w":"idea","s":151.07,"e":151.45},{"w":"—","s":151.45,"e":151.45},{"w":"the","s":151.45,"e":152.21},{"w":"