{"version":"0.1","lang":"en","source":"aligned","duration":180.18,"scenes":[{"id":"s01","start":0,"end":13.8,"sentences":[{"text":"Musa says it rained a lot last night.","start":0.35,"end":3.48},{"text":"Zainab says only a little.","start":3.93,"end":6.11},{"text":"Both families farm, so it matters.","start":6.56,"end":9.56},{"text":"Who’s right?","start":10.01,"end":10.82},{"text":"Today we stop guessing.","start":11.27,"end":13.1}],"words":[{"w":"Musa","s":0.35,"e":1.09},{"w":"says","s":1.09,"e":1.35},{"w":"it","s":1.35,"e":1.63},{"w":"rained","s":1.63,"e":1.97},{"w":"a","s":1.97,"e":2.23},{"w":"lot","s":2.23,"e":2.59},{"w":"last","s":2.59,"e":2.89},{"w":"night.","s":2.89,"e":3.23},{"w":"Zainab","s":3.93,"e":4.53},{"w":"says","s":4.53,"e":4.81},{"w":"only","s":4.81,"e":5.43},{"w":"a","s":5.43,"e":5.63},{"w":"little.","s":5.63,"e":5.87},{"w":"Both","s":6.56,"e":7.04},{"w":"families","s":7.04,"e":7.48},{"w":"farm,","s":7.48,"e":7.94},{"w":"so","s":8.22,"e":8.44},{"w":"it","s":8.44,"e":8.88},{"w":"matters.","s":8.88,"e":9.26},{"w":"Who’s","s":10.01,"e":10.33},{"w":"right?","s":10.33,"e":10.51},{"w":"Today","s":11.27,"e":11.63},{"w":"we","s":11.63,"e":12.13},{"w":"stop","s":12.13,"e":12.51},{"w":"guessing.","s":12.51,"e":12.87}]},{"id":"s02","start":13.8,"end":20.68,"sentences":[{"text":"Today: build a rain gauge from a plastic bottle — and measure rain in millimetres.","start":14.15,"end":19.98}],"words":[{"w":"Today:","s":14.15,"e":14.49},{"w":"build","s":14.97,"e":15.35},{"w":"a","s":15.35,"e":15.59},{"w":"rain","s":15.59,"e":15.87},{"w":"gauge","s":15.87,"e":16.17},{"w":"from","s":16.17,"e":16.45},{"w":"a","s":16.45,"e":16.57},{"w":"plastic","s":16.57,"e":16.93},{"w":"bottle","s":16.93,"e":17.39},{"w":"—","s":17.39,"e":17.59},{"w":"and","s":17.59,"e":17.93},{"w":"measure","s":17.93,"e":18.29},{"w":"rain","s":18.29,"e":18.71},{"w":"in","s":18.71,"e":19.01},{"w":"millimetres.","s":19.01,"e":19.77}]},{"id":"s03","start":20.68,"end":33.82,"sentences":[{"text":"Rainfal