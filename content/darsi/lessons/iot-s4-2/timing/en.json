{"version":"0.1","lang":"en","source":"aligned","duration":182.7,"scenes":[{"id":"s01","start":0,"end":15.89,"sentences":[{"text":"Our far-field sensor could never reach the school office.","start":0.35,"end":3.71},{"text":"Its radio reaches two hundred metres; the office is six hundred away.","start":4.16,"end":8.91},{"text":"So we didn't buy a bigger radio.","start":9.36,"end":11.95},{"text":"We asked its neighbours to pass the message on.","start":12.4,"end":15.19}],"words":[{"w":"Our","s":0.35,"e":0.53},{"w":"far-field","s":0.53,"e":1.23},{"w":"sensor","s":1.23,"e":1.67},{"w":"could","s":1.67,"e":1.95},{"w":"never","s":1.95,"e":2.45},{"w":"reach","s":2.45,"e":2.75},{"w":"the","s":2.75,"e":2.95},{"w":"school","s":2.95,"e":3.19},{"w":"office.","s":3.19,"e":3.45},{"w":"Its","s":4.16,"e":4.34},{"w":"radio","s":4.34,"e":4.82},{"w":"reaches","s":4.82,"e":5.2},{"w":"two","s":5.2,"e":5.58},{"w":"hundred","s":5.58,"e":5.92},{"w":"metres;","s":5.92,"e":6.3},{"w":"the","s":6.88,"e":6.94},{"w":"office","s":6.94,"e":7.34},{"w":"is","s":7.34,"e":7.62},{"w":"six","s":7.62,"e":7.94},{"w":"hundred","s":7.94,"e":8.32},{"w":"away.","s":8.32,"e":8.64},{"w":"So","s":9.36,"e":9.76},{"w":"we","s":9.76,"e":10.24},{"w":"didn't","s":10.24,"e":10.64},{"w":"buy","s":10.64,"e":10.84},{"w":"a","s":10.84,"e":11},{"w":"bigger","s":11,"e":11.32},{"w":"radio.","s":11.32,"e":11.74},{"w":"We","s":12.4,"e":12.6},{"w":"asked","s":12.6,"e":12.96},{"w":"its","s":12.96,"e":13.22},{"w":"neighbours","s":13.22,"e":13.52},{"w":"to","s":13.52,"e":13.92},{"w":"pass","s":13.92,"e":14.24},{"w":"the","s":14.24,"e":14.42},{"w":"message","s":14.42,"e":14.7},{"w":"on.","s":14.7,"e":15}]},{"id":"s02","start":15.89,"end":22.58,"sentences":[{"text":"Today: mesh networks, where devices pass messages along to get them home.","start":16.24,"end":21.88}],"words":[{"w":"Today:","s":16.24,"e":16.64},{"w":"mesh","s":17.14,"e":17.48},{"w":"networks,","s":17.48,"e":18.04},{"w":"where","s":18.4,"e":18.66},{"w":"devices","s":18