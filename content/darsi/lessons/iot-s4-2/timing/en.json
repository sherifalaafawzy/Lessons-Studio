w":"ball","s":57.14,"e":57.42},{"w":"from","s":57.42,"e":57.7},{"w":"one","s":57.7,"e":58.1},{"w":"end","s":58.1,"e":58.48},{"w":"straight","s":58.48,"e":58.94},{"w":"into","s":58.94,"e":59.26},{"w":"the","s":59.26,"e":59.42},{"w":"goal.","s":59.42,"e":59.7},{"w":"The","s":60.31,"e":60.45},{"w":"team","s":60.45,"e":60.91},{"w":"passes","s":60.91,"e":61.37},{"w":"it,","s":61.37,"e":61.67},{"w":"player","s":62.01,"e":62.25},{"w":"to","s":62.25,"e":62.53},{"w":"player.","s":62.53,"e":62.79},{"w":"And","s":63.47,"e":63.63},{"w":"if","s":63.63,"e":63.81},{"w":"one","s":63.81,"e":64.09},{"w":"player","s":64.09,"e":64.39},{"w":"is","s":64.39,"e":64.63},{"w":"marked,","s":64.63,"e":64.95},{"w":"the","s":65.21,"e":65.63},{"w":"ball","s":65.63,"e":65.85},{"w":"goes","s":65.85,"e":66.07},{"w":"another","s":66.07,"e":66.33},{"w":"way.","s":66.33,"e":66.59}]},{"id":"s06","start":67.4,"end":77.11,"sentences":[{"text":"Quick check!","start":67.75,"end":68.42},{"text":"A goat knocks over a sensor in the middle of the field.","start":68.87,"end":72.54},{"text":"What happens to messages from the sensors behind it?","start":72.99,"end":76.41}],"words":[{"w":"Quick","s":67.75,"e":67.93},{"w":"check!","s":67.93,"e":68.21},{"w":"A","s":68.87,"e":69.01},{"w":"goat","s":69.01,"e":69.39},{"w":"knocks","s":69.39,"e":69.91},{"w":"over","s":69.91,"e":70.27},{"w":"a","s":70.27,"e":70.49},{"w":"sensor","s":70.49,"e":70.95},{"w":"in","s":70.95,"e":71.41},{"w":"the","s":71.41,"e":71.51},{"w":"middle","s":71.51,"e":71.73},{"w":"of","s":71.73,"e":71.91},{"w":"the","s":71.91,"e":72.03},{"w":"field.","s":72.03,"e":72.37},{"w":"What","s":72.99,"e":73.19},{"w":"happens","s":73.19,"e":73.59},{"w":"to","s":73.59,"e":73.93},{"w":"messages","s":73.93,"e":74.37},{"w":"from","s":74.37,"e":74.71},{"w":"the","s":74.71,"e":75.01},{"w":"sensors","s":75.01,"e":75.49},{"w":"behind","s":75.49,"e":75.89},{"w":"it?","s":75.89,"e":76.25}]},{"id":"s07","start":77.11,"end":89.67,"sentences":[{"text":"They take another route, through neighbours that still work.","start":77.46,"end":80.74},{"text":"It may cost an extra hop, but they get through.","start":81.19,"end":84.55},{"text":"That's why a mesh keeps working when one device fails.","start":85,"end":88.97}],"words":[{"w":"They","s":77.46,"e":77.62},{"w":"take","s":77.62,"e":77.92},{"w":"another","s":77.92,"e":78.18},{"w":"route,","s":78.18,"e":78.52},{"w":"through","s":78.52,"e":79.22},{"w":"neighbours","s":79.22,"e":79.52},{"w":"that","s":79.52,"e":80},{"w":"still","s":80,"e":80.26},{"w":"work.","s":80.26,"e":80.52},{"w":"It","s":81.19,"e":81.39},{"w":"may","s":81.39,"e":81.59},{"w":"cost","s":81.59,"e":81.95},{"w":"an","s":81.95,"e":82.17},{"w":"extra","s":82.17,"e":82.55},{"w":"hop,","s":82.55,"e":82.99},{"w":"but","s":83.39,"e":83.63},{"w":"they","s":83.63,"e":83.91},{"w":"get","s":83.91,"e":84.07},{"w":"through.","s":84.07,"e":84.31},{"w":"That's","s":85,"e":85.42},{"w":"why","s":85.42,"e":85.66},{"w":"a","s":85.66,"e":85.88},{"w":"mesh","s":85.88,"e":86.2},{"w":"keeps","s":86.2,"e":86.66},{"w":"working","s":86.66,"e":87.12},{"w":"when","s":87.12,"e":87.52},{"w":"one","s":87.52,"e":87.84},{"w":"device","s":87.84,"e":88.18},{"w":"fails.","s":88.18,"e":88.6}]},{"id":"s08","start":89.67,"end":106.72,"sentences":[{"text":"But a mesh still has weak points.","start":90.02,"end":92.59},{"text":"A sensor with only one neighbour hangs by a thread.","start":93.04,"end":96.76},{"text":"A gap wider than the radio's range splits the network in two.","start":97.21,"end":101.85},{"text":"And if the gateway fails, nothing gets out at all.","start":102.3,"end":106.02}],"words":[{"w":"But","s":90.02,"e":90.26},{"w":"a","s":90.26,"e":90.42},{"w":"mesh","s":90.42,"e":90.72},{"w":"still","s":90.72,"e":91.22},{"w":"has","s":91.22,"e":91.62},{"w":"weak","s":91.62,"e":91.92},{"w":"points.","s":91.92,"e":92.3},{"w":"A","s":93.04,"e":93.18},{"w":"sensor","s":93.18,"e":93.58},{"w":"with","s":93.58,"e":94},{"w":"only","s":94,"e":94.34},{"w":"one","s":9