136.8,"end":137.46},{"text":"Zainab's sensor by the river has only one neighbour, and floods keep knocking that neighbour over.","start":137.91,"end":144.02},{"text":"What's the best fix?","start":144.47,"end":145.72}],"words":[{"w":"Your","s":136.8,"e":137.06},{"w":"turn.","s":137.06,"e":137.3},{"w":"Zainab's","s":137.91,"e":138.73},{"w":"sensor","s":138.73,"e":139.05},{"w":"by","s":139.05,"e":139.33},{"w":"the","s":139.33,"e":139.47},{"w":"river","s":139.47,"e":139.75},{"w":"has","s":139.75,"e":140.27},{"w":"only","s":140.27,"e":140.57},{"w":"one","s":140.57,"e":140.99},{"w":"neighbour,","s":140.99,"e":141.31},{"w":"and","s":141.71,"e":141.83},{"w":"floods","s":141.83,"e":142.21},{"w":"keep","s":142.21,"e":142.53},{"w":"knocking","s":142.53,"e":142.93},{"w":"that","s":142.93,"e":143.27},{"w":"neighbour","s":143.27,"e":143.51},{"w":"over.","s":143.51,"e":143.81},{"w":"What's","s":144.47,"e":144.85},{"w":"the","s":144.85,"e":144.95},{"w":"best","s":144.95,"e":145.17},{"w":"fix?","s":145.17,"e":145.41}]},{"id":"s12","start":146.42,"end":164.67,"sentences":[{"text":"Add a relay on higher ground: a second neighbour means a second route.","start":146.77,"end":151.46},{"text":"Remember: messages hop from neighbour to neighbour to the gateway.","start":151.91,"end":156.42},{"text":"When one device fails, they find another way.","start":156.87,"end":160.14},{"text":"Fill gaps with relays, and look after the gateway.","start":160.59,"end":163.97}],"words":[{"w":"Add","s":146.77,"e":147.03},{"w":"a","s":147.03,"e":147.15},{"w":"relay","s":147.15,"e":147.51},{"w":"on","s":147.51,"e":147.87},{"w":"higher","s":147.87,"e":148.17},{"w":"ground:","s":148.17,"e":148.63},{"w":"a","s":149.13,"e":149.31},{"w":"second","s":149.31,"e":149.65},{"w":"neighbour","s":149.65,"e":150.07},{"w":"means","s":150.07,"e":150.57},{"w":"a","s":150.57,"e":150.77},{"w":"second","s":150.77,"e":150.99},{"w":"route.","s":150.99,"e":151.27},{"w":"Remember:","s":151.91,"e":152.27},{"w":"messages","s":152.81