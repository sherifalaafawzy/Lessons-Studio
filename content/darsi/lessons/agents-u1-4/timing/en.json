ly the tools and scopes its task needs.","start":44.87,"end":48.77},{"text":"A reminder agent needs to email one student, not the whole list.","start":49.22,"end":53.9},{"text":"Narrow, per-task permissions turn a disaster into a refused request.","start":54.35,"end":59.66}],"words":[{"w":"Give","s":44.87,"e":45.13},{"w":"the","s":45.13,"e":45.33},{"w":"agent","s":45.33,"e":45.73},{"w":"only","s":45.73,"e":46.15},{"w":"the","s":46.15,"e":46.43},{"w":"tools","s":46.43,"e":46.77},{"w":"and","s":46.77,"e":47.01},{"w":"scopes","s":47.01,"e":47.55},{"w":"its","s":47.55,"e":47.77},{"w":"task","s":47.77,"e":48.19},{"w":"needs.","s":48.19,"e":48.49},{"w":"A","s":49.22,"e":49.34},{"w":"reminder","s":49.34,"e":49.86},{"w":"agent","s":49.86,"e":50.4},{"w":"needs","s":50.4,"e":50.82},{"w":"to","s":50.82,"e":51.12},{"w":"email","s":51.12,"e":51.38},{"w":"one","s":51.38,"e":51.94},{"w":"student,","s":51.94,"e":52.46},{"w":"not","s":52.78,"e":52.98},{"w":"the","s":52.98,"e":53.2},{"w":"whole","s":53.2,"e":53.38},{"w":"list.","s":53.38,"e":53.76},{"w":"Narrow,","s":54.35,"e":54.99},{"w":"per-task","s":55.05,"e":55.75},{"w":"permissions","s":55.75,"e":56.03},{"w":"turn","s":56.03,"e":56.75},{"w":"a","s":56.75,"e":56.89},{"w":"disaster","s":56.89,"e":57.45},{"w":"into","s":57.45,"e":58.05},{"w":"a","s":58.05,"e":58.37},{"w":"refused","s":58.37,"e":58.89},{"w":"request.","s":58.89,"e":59.37}]},{"id":"s05","start":60.36,"end":74.24,"sentences":[{"text":"Route irreversible or wide-reaching actions through a human.","start":60.71,"end":65.18},{"text":"The agent drafts the message and shows who will receive it.","start":65.63,"end":69.33},{"text":"A person approves or rejects it, and the decision is logged.","start":69.78,"end":73.54}],"words":[{"w":"Route","s":60.71,"e":61.09},{"w":"irreversible","s":61.09,"e":62.11},{"w":"or","s":62.11,"e":62.43},{"w":"wide-reaching","s":62.43,"e":63.35},{"w":"actions","s":63.35,"e":63.75},{"w":"through","s":63.75,"e":64.45},{"w":"a","s":64.45,"e":64.71},{"w":"human.","s":64.71,"e":64.95},{"w":"The","s":65.63,"e":65.79},{"w":"agent","s":65.79,"e":66.19},{"w":"drafts","s":66.19,"e":66.91},{"w":"the","s":66.91,"e":67.01},{"w":"message","s":67.01,"e":67.41},{"w":"and","s":67.41,"e":67.95},{"w":"shows","s":67.95,"e":68.31},{"w":"who","s":68.31,"e":68.55},{"w":"will","s":68.55,"e":68.69},{"w":"receive","s":68.69,"e":68.99},{"w":"it.","s":68.99,"e":69.21},{"w":"A","s":69.78,"e":69.9},{"w":"person","s":69.9,"e":70.22},{"w":"approves","s":70.22,"e":70.94},{"w":"or","s":70.94,"e":71.22},{"w":"rejects","s":71.22,"e":71.7},{"w":"it,","s":71.7,"e":71.84},{"w":"and","s":72.14,"e":72.34},{"w":"the","s":72.34,"e":72.58},{"w":"decision","s":72.58,"e":72.92},{"w":"is","s":72.92,"e":73.14},{"w":"logged.","s":73.14,"e":73.36}]},{"id":"s06","start":74.24,"end":92.36,"sentences":[{"text":"Frameworks such as the NIST AI Risk Management Framework ask teams to map, measure, manage and govern risks.","start":74.59,"end":83.27},{"text":"For agents this means naming who is accountable, logging every action, and planning how to stop the system.","start":83.72,"end":91.66}],"words":[{"w":"Frameworks","s":74.59,"e":75.21},{"w":"such","s":75.21,"e":75.49},{"w":"as","s":75.49,"e":75.75},{"w":"the","s":75.75,"e":75.93},{"w":"NIST","s":75.93,"e":76.39},{"w":"AI","s":76.39,"e":76.73},{"w":"Risk","s":76.73,"e":77.19},{"w":"Management","s":77.19,"e":77.59},{"w":"Framework","s":77.59,"e":78.21},{"w":"ask","s":78.21,"e":78.77},{"w":"teams","s":78.77,"e":79.29},{"w":"to","s":79.29,"e":79.45},{"w":"map,","s":79.45,"e":79.79},{"w":"measure,","s":80.07,"e":80.77},{"w":"manage","s":81.13,"e":81.63},{"w":"and","s":81.63,"e":82.13},{"w":"govern","s":82.13,"e":82.57},{"w":"risks.","s":82.57,"e":83.03},{"w":"For","s":83.72,"e":83.96},{"w":"agents","s":83.96,"e":84.34},{"w":"this","s":84.34,"e":84.96},{"w":"means","s":84.96,"e":85.34},{"w":"naming","s":85.34,"e":85.88},{"w":"who","s":85.88,"e":86.36},{"w":"is","s":86.36,"e":86.52},{"w":"accountable,","s":86.52,"