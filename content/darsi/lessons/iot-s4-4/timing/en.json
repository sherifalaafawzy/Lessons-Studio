{"version":"0.1","lang":"en","source":"aligned","duration":198.44,"scenes":[{"id":"s01","start":0,"end":15.91,"sentences":[{"text":"Every rainy season, the road to Musa's school floods at the low bridge.","start":0.35,"end":5.96},{"text":"Last year a minibus drove in and got stuck.","start":6.41,"end":9.52},{"text":"Nobody was hurt, but nobody had known how deep the water was.","start":9.97,"end":15.21}],"words":[{"w":"Every","s":0.35,"e":1.03},{"w":"rainy","s":1.03,"e":1.47},{"w":"season,","s":1.47,"e":1.91},{"w":"the","s":1.91,"e":2.59},{"w":"road","s":2.59,"e":2.95},{"w":"to","s":2.95,"e":3.23},{"w":"Musa's","s":3.23,"e":3.77},{"w":"school","s":3.77,"e":4.05},{"w":"floods","s":4.05,"e":4.59},{"w":"at","s":4.59,"e":5.07},{"w":"the","s":5.07,"e":5.19},{"w":"low","s":5.19,"e":5.41},{"w":"bridge.","s":5.41,"e":5.67},{"w":"Last","s":6.41,"e":6.65},{"w":"year","s":6.65,"e":7.01},{"w":"a","s":7.01,"e":7.25},{"w":"minibus","s":7.25,"e":7.89},{"w":"drove","s":7.89,"e":8.17},{"w":"in","s":8.17,"e":8.45},{"w":"and","s":8.45,"e":8.71},{"w":"got","s":8.71,"e":8.93},{"w":"stuck.","s":8.93,"e":9.25},{"w":"Nobody","s":9.97,"e":10.35},{"w":"was","s":10.35,"e":10.73},{"w":"hurt,","s":10.73,"e":11.05},{"w":"but","s":11.53,"e":11.81},{"w":"nobody","s":11.81,"e":12.55},{"w":"had","s":12.55,"e":12.85},{"w":"known","s":12.85,"e":13.17},{"w":"how","s":13.17,"e":13.57},{"w":"deep","s":13.57,"e":14.03},{"w":"the","s":14.03,"e":14.29},{"w":"water","s":14.29,"e":14.61},{"w":"was.","s":14.61,"e":14.99}]},{"id":"s02","start":15.91,"end":21.92,"sentences":[{"text":"Today: turn a problem in your community into a connected design.","start":16.26,"end":21.22}],"words":[{"w":"Today:","s":16.26,"e":16.58},{"w":"turn","s":16.98,"e":17.42},{"w":"a","s":17.42,"e":17.64},{"w":"problem","s":17.64,"e":18.1},{"w":"in","s":18.1,"e":18.34},{"w":"your","s":18.34,"e":18.46},{"w":"community","s":18.46,"e":19.06},{"w":"into","s":19.06,"e":19.56},{"w":"a","s":19.56,"e":19.76},{"w":"connected","s":19.76,"e":20.34