{"version":"0.1","lang":"en","source":"aligned","duration":225.71,"scenes":[{"id":"s01","start":0,"end":17.81,"sentences":[{"text":"Two plans for exam week land on my desk.","start":0.35,"end":3.29},{"text":"One finishes in four days, but nine pupils sit two exams on the same day.","start":3.74,"end":10.08},{"text":"The other takes six days, and only one pupil does.","start":10.53,"end":15.25},{"text":"Which plan is better?","start":15.7,"end":17.11}],"words":[{"w":"Two","s":0.35,"e":0.51},{"w":"plans","s":0.51,"e":0.93},{"w":"for","s":0.93,"e":1.27},{"w":"exam","s":1.27,"e":1.71},{"w":"week","s":1.71,"e":2.05},{"w":"land","s":2.05,"e":2.43},{"w":"on","s":2.43,"e":2.63},{"w":"my","s":2.63,"e":2.79},{"w":"desk.","s":2.79,"e":3.13},{"w":"One","s":3.74,"e":3.98},{"w":"finishes","s":3.98,"e":4.44},{"w":"in","s":4.44,"e":4.92},{"w":"four","s":4.92,"e":5.34},{"w":"days,","s":5.34,"e":5.78},{"w":"but","s":6.28,"e":6.48},{"w":"nine","s":6.48,"e":6.86},{"w":"pupils","s":6.86,"e":7.36},{"w":"sit","s":7.36,"e":7.88},{"w":"two","s":7.88,"e":8.22},{"w":"exams","s":8.22,"e":8.66},{"w":"on","s":8.66,"e":9.12},{"w":"the","s":9.12,"e":9.24},{"w":"same","s":9.24,"e":9.6},{"w":"day.","s":9.6,"e":9.96},{"w":"The","s":10.53,"e":10.97},{"w":"other","s":10.97,"e":11.25},{"w":"takes","s":11.25,"e":11.87},{"w":"six","s":11.87,"e":12.29},{"w":"days,","s":12.29,"e":12.67},{"w":"and","s":13.17,"e":13.49},{"w":"only","s":13.49,"e":13.99},{"w":"one","s":13.99,"e":14.31},{"w":"pupil","s":14.31,"e":14.71},{"w":"does.","s":14.71,"e":15.01},{"w":"Which","s":15.7,"e":15.98},{"w":"plan","s":15.98,"e":16.4},{"w":"is","s":16.4,"e":16.64},{"w":"better?","s":16.64,"e":16.9}]},{"id":"s02","start":17.81,"end":23.76,"sentences":[{"text":"Today: two goals at once, and how to choose between them in the open.","start":18.16,"end":23.06}],"words":[{"w":"Today:","s":18.16,"e":18.46},{"w":"two","s":18.9,"e":19.28},{"w":"goals","s":19.28,"e":19.6},{"w":"at","s":19.6,"e":19.8},{"w":"once,","s":19.8,"e":20.24},{"w":"