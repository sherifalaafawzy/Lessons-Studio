,{"w":"goes.","s":60.1,"e":60.5},{"w":"What’s","s":61.41,"e":61.79},{"w":"left,","s":61.79,"e":62.21},{"w":"plans","s":62.53,"e":62.77},{"w":"A,","s":62.77,"e":63.29},{"w":"B","s":63.49,"e":63.67},{"w":"and","s":63.67,"e":63.93},{"w":"D,","s":63.93,"e":64.33},{"w":"is","s":64.75,"e":65.05},{"w":"the","s":65.05,"e":65.37},{"w":"Pareto","s":65.37,"e":65.77},{"w":"front.","s":65.77,"e":65.99}]},{"id":"s05","start":66.89,"end":82.3,"sentences":[{"text":"A plan is on the Pareto front when no other plan is at least as good on every goal and better on one.","start":67.24,"end":74.83},{"text":"Picking from the front isn’t maths any more.","start":75.28,"end":77.89},{"text":"It’s a judgement about what matters more.","start":78.34,"end":81.6}],"words":[{"w":"A","s":67.24,"e":67.38},{"w":"plan","s":67.38,"e":67.72},{"w":"is","s":67.72,"e":68.18},{"w":"on","s":68.18,"e":68.34},{"w":"the","s":68.34,"e":68.46},{"w":"Pareto","s":68.46,"e":68.98},{"w":"front","s":68.98,"e":69.28},{"w":"when","s":69.28,"e":69.86},{"w":"no","s":69.86,"e":70.18},{"w":"other","s":70.18,"e":70.5},{"w":"plan","s":70.5,"e":70.84},{"w":"is","s":70.84,"e":71.18},{"w":"at","s":71.18,"e":71.32},{"w":"least","s":71.32,"e":71.64},{"w":"as","s":71.64,"e":71.88},{"w":"good","s":71.88,"e":72.12},{"w":"on","s":72.12,"e":72.4},{"w":"every","s":72.4,"e":72.86},{"w":"goal","s":72.86,"e":73.26},{"w":"and","s":73.26,"e":73.84},{"w":"better","s":73.84,"e":74.14},{"w":"on","s":74.14,"e":74.44},{"w":"one.","s":74.44,"e":74.66},{"w":"Picking","s":75.28,"e":75.62},{"w":"from","s":75.62,"e":75.84},{"w":"the","s":75.84,"e":76.02},{"w":"front","s":76.02,"e":76.32},{"w":"isn’t","s":76.32,"e":76.9},{"w":"maths","s":76.9,"e":77.18},{"w":"any","s":77.18,"e":77.48},{"w":"more.","s":77.48,"e":77.74},{"w":"It’s","s":78.34,"e":78.88},{"w":"a","s":78.88,"e":78.88},{"w":"judgement","s":78.88,"e":79.32},{"w":"about","s":79.32,"e":79.94},{"w":"what","s":79.94,"e":80.48},{"w":"matters","s":80.48,"e":80.92},{"w":"more.","s":80.92,"e":81.32}]},{"id":"s06","start":82.3,"end":101.27,"sentences":[{"text":"One way to choose is to give each goal a weight.","start":82.65,"end":86.14},{"text":"Count one exam day as much as one clashing pupil, and plan D wins: six plus one is seven.","start":86.59,"end":94.37},{"text":"Count a day as much as four clashing pupils, and plan B wins instead.","start":94.82,"end":100.57}],"words":[{"w":"One","s":82.65,"e":82.93},{"w":"way","s":82.93,"e":83.17},{"w":"to","s":83.17,"e":83.33},{"w":"choose","s":83.33,"e":83.59},{"w":"is","s":83.59,"e":84.11},{"w":"to","s":84.11,"e":84.37},{"w":"give","s":84.37,"e":84.59},{"w":"each","s":84.59,"e":84.87},{"w":"goal","s":84.87,"e":85.27},{"w":"a","s":85.27,"e":85.69},{"w":"weight.","s":85.69,"e":85.93},{"w":"Count","s":86.59,"e":86.89},{"w":"one","s":86.89,"e":87.25},{"w":"exam","s":87.25,"e":87.67},{"w":"day","s":87.67,"e":88.07},{"w":"as","s":88.07,"e":88.47},{"w":"much","s":88.47,"e":88.71},{"w":"as","s":88.71,"e":88.99},{"w":"one","s":88.99,"e":89.31},{"w":"clashing","s":89.31,"e":89.87},{"w":"pupil,","s":89.87,"e":90.27},{"w":"and","s":90.61,"e":91.03},{"w":"plan","s":91.03,"e":91.41},{"w":"D","s":91.41,"e":91.67},{"w":"wins:","s":91.67,"e":91.99},{"w":"six","s":92.59,"e":92.89},{"w":"plus","s":92.89,"e":93.19},{"w":"one","s":93.19,"e":93.57},{"w":"is","s":93.57,"e":93.93},{"w":"seven.","s":93.93,"e":94.19},{"w":"Count","s":94.82,"e":95.16},{"w":"a","s":95.16,"e":95.36},{"w":"day","s":95.36,"e":95.62},{"w":"as","s":95.62,"e":95.96},{"w":"much","s":95.96,"e":96.24},{"w":"as","s":96.24,"e":96.44},{"w":"four","s":96.44,"e":96.98},{"w":"clashing","s":96.98,"e":97.68},{"w":"pupils,","s":97.68,"e":98.14},{"w":"and","s":98.48,"e":98.92},{"w":"plan","s":98.92,"e":99.24},{"w":"B","s":99.24,"e":99.58},{"w":"wins","s":99.58,"e":99.94},{"w":"instead.","s":99.94,"e":100.32}]},{"id":"s07","start":101.27,"end":117.01,"sentences":[{"text":"So the weights decide, and weights are values, not facts.","start":101.62,"end":106.45},{"text":"Agree them b