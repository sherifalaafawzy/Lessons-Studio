.","s":67.8,"e":68.02},{"w":"“Twenty-eight","s":68.76,"e":69.32},{"w":"degrees","s":69.32,"e":69.6},{"w":"Celsius,","s":69.6,"e":70.08},{"w":"8","s":70.7,"e":70.86},{"w":"am,","s":70.86,"e":71.14},{"w":"shady","s":71.56,"e":71.98},{"w":"wall","s":71.98,"e":72.34},{"w":"by","s":72.34,"e":72.6},{"w":"the","s":72.6,"e":72.72},{"w":"door.”","s":72.72,"e":72.9}]},{"id":"s06","start":73.76,"end":86.8,"sentences":[{"text":"It’s like a price in a border market.","start":74.11,"end":76.59},{"text":"“It’s two hundred.”","start":77.04,"end":78.04},{"text":"Two hundred what — naira or CFA francs?","start":78.49,"end":82.18},{"text":"A number without a unit is a price without a currency.","start":82.63,"end":86.1}],"words":[{"w":"It’s","s":74.11,"e":74.39},{"w":"like","s":74.39,"e":74.51},{"w":"a","s":74.51,"e":74.67},{"w":"price","s":74.67,"e":75.07},{"w":"in","s":75.07,"e":75.39},{"w":"a","s":75.39,"e":75.49},{"w":"border","s":75.49,"e":75.85},{"w":"market.","s":75.85,"e":76.31},{"w":"“It’s","s":77.04,"e":77.34},{"w":"two","s":77.34,"e":77.52},{"w":"hundred.”","s":77.52,"e":77.86},{"w":"Two","s":78.49,"e":78.77},{"w":"hundred","s":78.77,"e":79.15},{"w":"what","s":79.15,"e":79.49},{"w":"—","s":79.49,"e":80.01},{"w":"naira","s":80.01,"e":80.61},{"w":"or","s":80.61,"e":81.01},{"w":"CFA","s":81.01,"e":81.53},{"w":"francs?","s":81.53,"e":82.15},{"w":"A","s":82.63,"e":82.77},{"w":"number","s":82.77,"e":83.11},{"w":"without","s":83.11,"e":83.49},{"w":"a","s":83.49,"e":83.67},{"w":"unit","s":83.67,"e":84.01},{"w":"is","s":84.01,"e":84.57},{"w":"a","s":84.57,"e":84.69},{"w":"price","s":84.69,"e":84.99},{"w":"without","s":84.99,"e":85.35},{"w":"a","s":85.35,"e":85.51},{"w":"currency.","s":85.51,"e":85.81}]},{"id":"s07","start":86.8,"end":98.43,"sentences":[{"text":"Quick check!","start":87.15,"end":87.79},{"text":"My student’s weather log says just “Rain: fifteen.”","start":88.24,"end":92.52},{"text":"Can we compare that with next week?","start":92.97,"end":96.03},{"text":"What’s missin