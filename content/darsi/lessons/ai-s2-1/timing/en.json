101.76,"e":102.38},{"w":"answers","s":102.38,"e":102.96},{"w":"in","s":102.96,"e":103.42},{"w":"perfect,","s":103.42,"e":103.98},{"w":"confident","s":104.42,"e":105.2},{"w":"sentences.","s":105.2,"e":105.88},{"w":"Does","s":106.69,"e":106.99},{"w":"that","s":106.99,"e":107.27},{"w":"mean","s":107.27,"e":107.49},{"w":"its","s":107.49,"e":107.93},{"w":"facts","s":107.93,"e":108.55},{"w":"are","s":108.55,"e":109.01},{"w":"right?","s":109.01,"e":109.27}]},{"id":"s08","start":110.21,"end":124.03,"sentences":[{"text":"Not necessarily: fluent isn’t the same as true.","start":110.56,"end":114.59},{"text":"It’s built to write what sounds likely, not to check what’s true.","start":115.04,"end":119.06},{"text":"So a made-up date comes out just as smoothly as a real one.","start":119.51,"end":123.33}],"words":[{"w":"Not","s":110.56,"e":110.88},{"w":"necessarily:","s":110.88,"e":111.58},{"w":"fluent","s":112.26,"e":112.76},{"w":"isn’t","s":112.76,"e":113.44},{"w":"the","s":113.44,"e":113.52},{"w":"same","s":113.52,"e":113.84},{"w":"as","s":113.84,"e":114.04},{"w":"true.","s":114.04,"e":114.4},{"w":"It’s","s":115.04,"e":115.38},{"w":"built","s":115.38,"e":115.52},{"w":"to","s":115.52,"e":115.82},{"w":"write","s":115.82,"e":116.06},{"w":"what","s":116.06,"e":116.32},{"w":"sounds","s":116.32,"e":116.72},{"w":"likely,","s":116.72,"e":117.28},{"w":"not","s":117.66,"e":117.92},{"w":"to","s":117.92,"e":118.16},{"w":"check","s":118.16,"e":118.4},{"w":"what’s","s":118.4,"e":118.76},{"w":"true.","s":118.76,"e":118.98},{"w":"So","s":119.51,"e":119.77},{"w":"a","s":119.77,"e":120.11},{"w":"made-up","s":120.11,"e":120.59},{"w":"date","s":120.59,"e":120.85},{"w":"comes","s":120.85,"e":121.21},{"w":"out","s":121.21,"e":121.45},{"w":"just","s":121.45,"e":121.83},{"w":"as","s":121.83,"e":122.07},{"w":"smoothly","s":122.07,"e":122.41},{"w":"as","s":122.41,"e":122.75},{"w":"a","s":122.75,"e":122.85},{"w":"real","s":122.85,"e":123.03},{"w":"one.","s":123.03,"e":123.21}]},{"id":"s09","start":124.03,