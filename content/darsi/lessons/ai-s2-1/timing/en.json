{"version":"0.1","lang":"en","source":"aligned","duration":215.46,"scenes":[{"id":"s01","start":0,"end":17.78,"sentences":[{"text":"I typed “See you” and my phone suggested “tomorrow”.","start":0.35,"end":5.52},{"text":"Then a chatbot wrote me a whole poem about fractions.","start":5.97,"end":11.57},{"text":"Not a bad one, either.","start":12.02,"end":14.03},{"text":"Same trick, just bigger?","start":14.48,"end":17.08}],"words":[{"w":"I","s":0.35,"e":0.59},{"w":"typed","s":0.59,"e":1.15},{"w":"“See","s":1.15,"e":1.77},{"w":"you”","s":1.77,"e":2.65},{"w":"and","s":2.65,"e":3.07},{"w":"my","s":3.07,"e":3.27},{"w":"phone","s":3.27,"e":3.61},{"w":"suggested","s":3.61,"e":4.13},{"w":"“tomorrow”.","s":4.13,"e":5.49},{"w":"Then","s":5.97,"e":6.39},{"w":"a","s":6.39,"e":6.69},{"w":"chatbot","s":6.69,"e":7.55},{"w":"wrote","s":7.55,"e":8.05},{"w":"me","s":8.05,"e":8.41},{"w":"a","s":8.41,"e":8.73},{"w":"whole","s":8.73,"e":9.17},{"w":"poem","s":9.17,"e":9.77},{"w":"about","s":9.77,"e":10.27},{"w":"fractions.","s":10.27,"e":10.77},{"w":"Not","s":12.02,"e":12.54},{"w":"a","s":12.54,"e":12.76},{"w":"bad","s":12.76,"e":13.12},{"w":"one,","s":13.12,"e":13.36},{"w":"either.","s":13.5,"e":13.8},{"w":"Same","s":14.48,"e":14.88},{"w":"trick,","s":14.88,"e":15.52},{"w":"just","s":15.8,"e":16.18},{"w":"bigger?","s":16.18,"e":16.8}]},{"id":"s02","start":17.78,"end":23.48,"sentences":[{"text":"Today: how a chatbot writes, and why that matters for you.","start":18.13,"end":22.78}],"words":[{"w":"Today:","s":18.13,"e":18.41},{"w":"how","s":18.97,"e":19.15},{"w":"a","s":19.15,"e":19.39},{"w":"chatbot","s":19.39,"e":19.91},{"w":"writes,","s":19.91,"e":20.35},{"w":"and","s":20.91,"e":21.21},{"w":"why","s":21.21,"e":21.59},{"w":"that","s":21.59,"e":21.81},{"w":"matters","s":21.81,"e":22.19},{"w":"for","s":22.19,"e":22.47},{"w":"you.","s":22.47,"e":22.65}]},{"id":"s03","start":23.48,"end":42.87,"sentences":[{"text":"Inside every chatbot is a language model.","start":23.83,"end":26.94},{"text":"It was trained on a huge amount of text: books, websites, articles and conversations.","start":27.39,"end":34.19},{"text":"That’s more than any person could read in many lifetimes.","start":34.64,"end":37.98},{"text":"From all of it, it learned which words tend to follow which.","start":38.43,"end":42.17}],"words":[{"w":"Inside","s":23.83,"e":24.31},{"w":"every","s":24.31,"e":24.87},{"w":"chatbot","s":24.87,"e":25.47},{"w":"is","s":25.47,"e":25.85},{"w":"a","s":25.85,"e":25.99},{"w":"language","s":25.99,"e":26.37},{"w":"model.","s":26.37,"e":26.79},{"w":"It","s":27.39,"e":27.51},{"w":"was","s":27.51,"e":27.65},{"w":"trained","s":27.65,"e":28.21},{"w":"on","s":28.21,"e":28.45},{"w":"a","s":28.45,"e":28.57},{"w":"huge","s":28.57,"e":29.07},{"w":"amount","s":29.07,"e":29.43},{"w":"of","s":29.43,"e":29.63},{"w":"text:","s":29.63,"e":29.97},{"w":"books,","s":30.41,"e":30.75},{"w":"websites,","s":31.21,"e":31.59},{"w":"articles","s":32.17,"e":32.63},{"w":"and","s":32.63,"e":33.21},{"w":"conversations.","s":33.21,"e":33.59},{"w":"That’s","s":34.64,"e":35},{"w":"more","s":35,"e":35.18},{"w":"than","s":35.18,"e":35.4},{"w":"any","s":35.4,"e":35.64},{"w":"person","s":35.64,"e":35.98},{"w":"could","s":35.98,"e":36.26},{"w":"read","s":36.26,"e":36.52},{"w":"in","s":36.52,"e":36.72},{"w":"many","s":36.72,"e":37.08},{"w":"lifetimes.","s":37.08,"e":37.76},{"w":"From","s":38.43,"e":38.63},{"w":"all","s":38.63,"e":38.97},{"w":"of","s":38.97,"e":39.13},{"w":"it,","s":39.13,"e":39.29},{"w":"it","s":39.57,"e":39.75},{"w":"learned","s":39.75,"e":40.05},{"w":"which","s":40.05,"e":40.31},{"w":"words","s":40.31,"e":40.59},{"w":"tend","s":40.59,"e":41.17},{"w":"to","s":41.17,"e":41.33},{"w":"follow","s":41.33,"e":41.61},{"w":"which.","s":41.61,"e":41.89}]},{"id":"s04","start":42.87,"end":61.41,"sentences":[{"text":"Then it writes like your phone’s keyboard, only far better.","start":43.22,"end":47.07},{"text":"It looks at everything written so far, and scores every possible next piece.","start":47.52,"end":52.85},{"text":"It picks a likely one, adds it, and does it all again.","start":53.3,"end":57.09},{"text":"Piece by piece, a whole answer appears.","start":57.54,"end":60.71}],"words":[{"w":"Then","s":43.22,"e":43.54},{"w":"it","s":43.54,"e":43.88},{"w":"writes","s":43.88,"e":44.16},{"w":"like","s":44.16,"e":44.46},{"w":"your","s":44.46,"e":44.62},{"w":"phone’s","s":44.62,"e":45.06},{"w":"keyboard,","s":45.06,"e":45.42},{"w":"only","s":45.88,"e":46.2},{"w":"far","s":46.2,"e":46.6},{"w":"better.","s":46.6,"e":46.88},{"w":"It","s":47.52,"e":47.7},{"w":"looks","s":47.7,"e":47.92},{"w":"at","s":47.92,"e":48.16},{"w":"everything","s":48.16,"e":48.7},{"w":"written","s":48.7,"e":49.1},{"w":"so","s":49.1,"e":49.44},{"w":"far,","s":49.44,"e":49.82},{"w":"and","s":50.14,"e":50.42},{"w":"scores","s":50.42,"e":50.84},{"w":"every","s":50.84,"e":51.44},{"w":"possible","s":51.44,"e":51.92},{"w":"next","s":51.92,"e":52.26},{"w":"piece.","s":52.26,"e":52.62},{"w":"It","s":53.3,"e":53.64},{"w":"picks","s":53.64,"e":53.9},{"w":"a","s":53.9,"e":54.08},{"w":"likely","s":54.08,"e":54.42},{"w":"one,","s":54.42,"e":54.8},{"w":"adds","s":55.18,"e":55.46},{"w":"it,","s":55.46,"e":55.64},{"w":"and","s":56.02,"e":56.16},{"w":"does","s":56.16,"e":56.4},{"w":"it","s":56.4,"e":56.52},{"w":"all","s":56.52,"e":56.68},{"w":"again.","s":56.68,"e":56.9},{"w":"Piece","s":57.54,"e":57.72},{"w":"by","s":57.72,"e":58},{"w":"piece,","s":58,"e":58.42},{"w":"a","s":58.82,"e":58.98},{"w":"whole","s":58.98,"e":59.34},{"w":"answer","s":59.34,"e":59.82},{"w":"appears.","s":59.82,"e":60.28}]},{"id":"s05","start":61.41,"end":79.93,"sentences":[{"text":"So, a language model is a program that predicts the next piece of text, over and over.","start":61.76,"end":68.33},{"text":"These pieces are called tokens: a short word, or part of a longer one.","start":68.78,"end":73.67},{"text":"On its own, it doesn’t look facts up.","start":74.12,"end":76.52},{"text":"It writes what usually comes next.","start":76.97,"end":79.23}],"words":[{"w":"So,","s":61.76,"e":62.1},{"w":"a","s":62.34,"e":62.46},{"w":"language","s":62.46,"e":62.84},{"w":"model","s":62.84,"e":63.36},{"w":"is","s":63.36,"e":63.76},{"w":"a","s":63.76,"e":63.88},{"w":"program","s":63.88,"e":64.28},{"w":"that","s":64.28,"e":64.64},{"w":"predicts","s":64.64,"e":65.32},{"w":"the","s":65.32,"e":65.5},{"w":"next","s":65.5,"e":65.9},{"w":"piece","s":65.9,"e":66.28},{"w":"of","s":66.28,"e":66.5},{"w":"text,","s":66.5,"e":66.84},{"w":"over","s":67.18,"e":67.58},{"w":"and","s":67.58,"e":67.88},{"w":"over.","s":67.88,"e":68.14},{"w":"These","s":68.78,"e":69.02},{"w":"pieces","s":69.02,"e":69.46},{"w":"are","s":69.46,"e":69.82},{"w":"called","s":69.82,"e":70.06},{"w":"tokens:","s":70.06,"e":70.78},{"w":"a","s":71.18,"e":71.34},{"w":"short","s":71.34,"e":71.54},{"w":"word,","s":71.54,"e":71.9},{"w":"or","s":72.1,"e":72.42},{"w":"part","s":72.42,"e":72.8},{"w":"of","s":72.8,"e":72.96},{"w":"a","s":72.96,"e":73.04},{"w":"longer","s":73.04,"e":73.28},{"w":"one.","s":73.28,"e":73.54},{"w":"On","s":74.12,"e":74.3},{"w":"its","s":74.3,"e":74.48},{"w":"own,","s":74.48,"e":74.78},{"w":"it","s":75.04,"e":75.14},{"w":"doesn’t","s":75.14,"e":75.6},{"w":"look","s":75.6,"e":75.74},{"w":"facts","s":75.74,"e":76.06},{"w":"up.","s":76.06,"e":76.36},{"w":"It","s":76.97,"e":77.13},{"w":"writes","s":77.13,"e":77.41},{"w":"what","s":77.41,"e":77.75},{"w":"usually","s":77.75,"e":78.25},{"w":"comes","s":78.25,"e":78.65},{"w":"next.","s":78.65,"e":79.03}]},{"id":"s06","start":79.93,"end":99.64,"sentences":[{"text":"It’s like a friend who has heard every story in town.","start":80.28,"end":83.7},{"text":"Start with “Once upon a” and they say “time” before you finish.","start":84.15,"end":88.76},{"text":"They’re usually right, because they’ve heard it so often.","start":89.21,"end":92.47},{"text":"But ask about something they’ve never heard, and they may still answer, smoothly, with a guess.","start":92.92,"end":98.94}],"words":[{"w":"It’s","