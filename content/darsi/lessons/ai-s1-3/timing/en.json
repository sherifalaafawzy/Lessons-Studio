{"version":"0.1","lang":"en","source":"aligned","duration":213.4,"scenes":[{"id":"s01","start":0,"end":11.78,"sentences":[{"text":"I pointed my phone at this leaf, and in one second it told me the plant’s name.","start":0.35,"end":5.03},{"text":"But a phone has no eyes like ours.","start":5.48,"end":8.39},{"text":"So what does it actually see?","start":8.84,"end":11.08}],"words":[{"w":"I","s":0.35,"e":0.51},{"w":"pointed","s":0.51,"e":0.87},{"w":"my","s":0.87,"e":1.09},{"w":"phone","s":1.09,"e":1.41},{"w":"at","s":1.41,"e":1.59},{"w":"this","s":1.59,"e":1.79},{"w":"leaf,","s":1.79,"e":2.05},{"w":"and","s":2.31,"e":2.45},{"w":"in","s":2.45,"e":2.59},{"w":"one","s":2.59,"e":2.89},{"w":"second","s":2.89,"e":3.29},{"w":"it","s":3.29,"e":3.63},{"w":"told","s":3.63,"e":3.99},{"w":"me","s":3.99,"e":4.09},{"w":"the","s":4.09,"e":4.25},{"w":"plant’s","s":4.25,"e":4.69},{"w":"name.","s":4.69,"e":4.81},{"w":"But","s":5.48,"e":5.74},{"w":"a","s":5.74,"e":6.12},{"w":"phone","s":6.12,"e":6.48},{"w":"has","s":6.48,"e":6.76},{"w":"no","s":6.76,"e":6.94},{"w":"eyes","s":6.94,"e":7.38},{"w":"like","s":7.38,"e":7.76},{"w":"ours.","s":7.76,"e":8.06},{"w":"So","s":8.84,"e":9.06},{"w":"what","s":9.06,"e":9.54},{"w":"does","s":9.54,"e":9.74},{"w":"it","s":9.74,"e":9.9},{"w":"actually","s":9.9,"e":10.52},{"w":"see?","s":10.52,"e":10.96}]},{"id":"s02","start":11.78,"end":17.69,"sentences":[{"text":"Today: how AI sees, and why it sometimes sees wrong.","start":12.13,"end":16.99}],"words":[{"w":"Today:","s":12.13,"e":12.53},{"w":"how","s":13.11,"e":13.27},{"w":"AI","s":13.27,"e":13.79},{"w":"sees,","s":13.79,"e":14.27},{"w":"and","s":14.93,"e":15.09},{"w":"why","s":15.09,"e":15.39},{"w":"it","s":15.39,"e":15.57},{"w":"sometimes","s":15.57,"e":15.93},{"w":"sees","s":15.93,"e":16.39},{"w":"wrong.","s":16.39,"e":16.77}]},{"id":"s03","start":17.69,"end":37.12,"sentences":[{"text":"Zoom right into any photo, and it breaks into tiny squares called pixels.","start":18.04,"end":23.32},{"text":"To a c