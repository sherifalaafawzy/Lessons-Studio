":62.15},{"w":"here?","s":62.15,"e":62.43}]},{"id":"s05","start":63.39,"end":81.21,"sentences":[{"text":"Here's what makes a policy hold.","start":63.74,"end":65.78},{"text":"A rule people must remember will be forgotten on a busy day.","start":66.23,"end":70.18},{"text":"A check the system enforces holds every day.","start":70.63,"end":73.49},{"text":"So wherever you can, turn the rule into a setting, a permission or a line of code.","start":73.94,"end":80.51}],"words":[{"w":"Here's","s":63.74,"e":64.16},{"w":"what","s":64.16,"e":64.3},{"w":"makes","s":64.3,"e":64.56},{"w":"a","s":64.56,"e":64.68},{"w":"policy","s":64.68,"e":65.12},{"w":"hold.","s":65.12,"e":65.52},{"w":"A","s":66.23,"e":66.37},{"w":"rule","s":66.37,"e":66.71},{"w":"people","s":66.71,"e":67.11},{"w":"must","s":67.11,"e":67.51},{"w":"remember","s":67.51,"e":68.03},{"w":"will","s":68.03,"e":68.45},{"w":"be","s":68.45,"e":68.59},{"w":"forgotten","s":68.59,"e":69.03},{"w":"on","s":69.03,"e":69.47},{"w":"a","s":69.47,"e":69.55},{"w":"busy","s":69.55,"e":69.79},{"w":"day.","s":69.79,"e":70.05},{"w":"A","s":70.63,"e":70.83},{"w":"check","s":70.83,"e":71.05},{"w":"the","s":71.05,"e":71.31},{"w":"system","s":71.31,"e":71.65},{"w":"enforces","s":71.65,"e":72.29},{"w":"holds","s":72.29,"e":72.63},{"w":"every","s":72.63,"e":73.07},{"w":"day.","s":73.07,"e":73.37},{"w":"So","s":73.94,"e":74.18},{"w":"wherever","s":74.18,"e":74.58},{"w":"you","s":74.58,"e":74.9},{"w":"can,","s":74.9,"e":75.2},{"w":"turn","s":75.2,"e":75.94},{"w":"the","s":75.94,"e":76.1},{"w":"rule","s":76.1,"e":76.42},{"w":"into","s":76.42,"e":76.88},{"w":"a","s":76.88,"e":77.1},{"w":"setting,","s":77.1,"e":77.48},{"w":"a","s":77.98,"e":78.08},{"w":"permission","s":78.08,"e":78.42},{"w":"or","s":78.42,"e":79.16},{"w":"a","s":79.16,"e":79.42},{"w":"line","s":79.42,"e":79.78},{"w":"of","s":79.78,"e":80.04},{"w":"code.","s":80.04,"e":80.34}]},{"id":"s06","start":81.21,"end":103.25,"sentences":[{"text":"Here's our send rule as code, with a bug we f