:"What will it show?","start":89.87,"end":91.14}],"words":[{"w":"Quick","s":81.71,"e":81.93},{"w":"check!","s":81.93,"e":82.29},{"w":"The","s":83.08,"e":83.3},{"w":"CO₂","s":83.3,"e":84.04},{"w":"sensor","s":84.04,"e":84.58},{"w":"sits","s":84.58,"e":85.22},{"w":"on","s":85.22,"e":85.54},{"w":"my","s":85.54,"e":85.74},{"w":"desk,","s":85.74,"e":86.12},{"w":"a","s":86.6,"e":86.76},{"w":"hand's","s":86.76,"e":87.18},{"w":"width","s":87.18,"e":87.36},{"w":"from","s":87.36,"e":87.88},{"w":"where","s":87.88,"e":88.1},{"w":"I","s":88.1,"e":88.32},{"w":"talk","s":88.32,"e":88.74},{"w":"all","s":88.74,"e":89.12},{"w":"day.","s":89.12,"e":89.32},{"w":"What","s":89.87,"e":90.15},{"w":"will","s":90.15,"e":90.41},{"w":"it","s":90.41,"e":90.55},{"w":"show?","s":90.55,"e":90.87}]},{"id":"s08","start":91.84,"end":102.32,"sentences":[{"text":"Higher than the room.","start":92.19,"end":93.45},{"text":"Breath out holds about a hundred times more CO₂ than outdoor air.","start":93.9,"end":98.47},{"text":"Keep the sensor a metre or two from people.","start":98.92,"end":101.62}],"words":[{"w":"Higher","s":92.19,"e":92.51},{"w":"than","s":92.51,"e":92.83},{"w":"the","s":92.83,"e":92.97},{"w":"room.","s":92.97,"e":93.17},{"w":"Breath","s":93.9,"e":94.2},{"w":"out","s":94.2,"e":94.66},{"w":"holds","s":94.66,"e":95.1},{"w":"about","s":95.1,"e":95.38},{"w":"a","s":95.38,"e":95.66},{"w":"hundred","s":95.66,"e":95.96},{"w":"times","s":95.96,"e":96.5},{"w":"more","s":96.5,"e":96.74},{"w":"CO₂","s":96.74,"e":97.34},{"w":"than","s":97.34,"e":97.56},{"w":"outdoor","s":97.56,"e":97.94},{"w":"air.","s":97.94,"e":98.32},{"w":"Keep","s":98.92,"e":99.1},{"w":"the","s":99.1,"e":99.32},{"w":"sensor","s":99.32,"e":99.76},{"w":"a","s":99.76,"e":100.08},{"w":"metre","s":100.08,"e":100.38},{"w":"or","s":100.38,"e":100.62},{"w":"two","s":100.62,"e":100.9},{"w":"from","s":100.9,"e":101.12},{"w":"people.","s":101.12,"e":101.4}]},{"id":"s09","start":102.32,"end":121.59,"sentences":[{"text":"Now the alert.","start