{"version":"0.1","lang":"en","source":"aligned","duration":200.79,"scenes":[{"id":"s01","start":0,"end":17.33,"sentences":[{"text":"We built ten CO₂ sensors before testing one.","start":0.35,"end":4.33},{"text":"All ten sat on windowsills, by open windows.","start":4.78,"end":8.75},{"text":"They read fresh air while pupils inside yawned.","start":9.2,"end":13.27},{"text":"Ten times the work, ten times the mistake.","start":13.72,"end":16.63}],"words":[{"w":"We","s":0.35,"e":0.53},{"w":"built","s":0.53,"e":0.93},{"w":"ten","s":0.93,"e":1.69},{"w":"CO₂","s":1.69,"e":2.39},{"w":"sensors","s":2.39,"e":2.85},{"w":"before","s":2.85,"e":3.15},{"w":"testing","s":3.15,"e":3.75},{"w":"one.","s":3.75,"e":4.07},{"w":"All","s":4.78,"e":5.28},{"w":"ten","s":5.28,"e":5.74},{"w":"sat","s":5.74,"e":6.16},{"w":"on","s":6.16,"e":6.4},{"w":"windowsills,","s":6.4,"e":7.14},{"w":"by","s":7.46,"e":7.58},{"w":"open","s":7.58,"e":7.98},{"w":"windows.","s":7.98,"e":8.38},{"w":"They","s":9.2,"e":9.34},{"w":"read","s":9.34,"e":9.7},{"w":"fresh","s":9.7,"e":10.18},{"w":"air","s":10.18,"e":10.7},{"w":"while","s":10.7,"e":11.2},{"w":"pupils","s":11.2,"e":11.6},{"w":"inside","s":11.6,"e":12.28},{"w":"yawned.","s":12.28,"e":13.18},{"w":"Ten","s":13.72,"e":13.94},{"w":"times","s":13.94,"e":14.34},{"w":"the","s":14.34,"e":14.5},{"w":"work,","s":14.5,"e":14.8},{"w":"ten","s":15.02,"e":15.44},{"w":"times","s":15.44,"e":15.88},{"w":"the","s":15.88,"e":16.02},{"w":"mistake.","s":16.02,"e":16.32}]},{"id":"s02","start":17.33,"end":24.1,"sentences":[{"text":"Today: pilot one sensor, place it well, and set alerts you can trust.","start":17.68,"end":23.4}],"words":[{"w":"Today:","s":17.68,"e":18.02},{"w":"pilot","s":18.46,"e":18.88},{"w":"one","s":18.88,"e":19.32},{"w":"sensor,","s":19.32,"e":19.86},{"w":"place","s":20.36,"e":20.66},{"w":"it","s":20.66,"e":20.92},{"w":"well,","s":20.92,"e":21.2},{"w":"and","s":21.8,"e":21.92},{"w":"set","s":21.92,"e":22.18},{"w":"alerts","s":22.18,"e":22.44},{"w":"you","s":22