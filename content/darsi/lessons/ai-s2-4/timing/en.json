ches","s":60.4,"e":60.9},{"w":"you","s":60.9,"e":61.14},{"w":"play.","s":61.14,"e":61.36},{"w":"But","s":62.02,"e":62.24},{"w":"nobody","s":62.24,"e":62.76},{"w":"ever","s":62.76,"e":63.1},{"w":"got","s":63.1,"e":63.36},{"w":"fitter","s":63.36,"e":63.8},{"w":"by","s":63.8,"e":64},{"w":"watching","s":64,"e":64.4},{"w":"the","s":64.4,"e":64.68},{"w":"coach","s":64.68,"e":64.94},{"w":"run.","s":64.94,"e":65.26}]},{"id":"s06","start":66.15,"end":85.26,"sentences":[{"text":"Honest use means AI helps you learn, and you’re open about how.","start":66.5,"end":71.11},{"text":"Asking it to explain, to quiz you or to check your work is learning.","start":71.56,"end":77.13},{"text":"Asking it to do the work, then handing that in as yours, is copying, even if you change a few words.","start":77.58,"end":84.56}],"words":[{"w":"Honest","s":66.5,"e":67.02},{"w":"use","s":67.02,"e":67.28},{"w":"means","s":67.28,"e":67.82},{"w":"AI","s":67.82,"e":68.26},{"w":"helps","s":68.26,"e":68.74},{"w":"you","s":68.74,"e":68.94},{"w":"learn,","s":68.94,"e":69.26},{"w":"and","s":69.7,"e":69.86},{"w":"you’re","s":69.86,"e":70.12},{"w":"open","s":70.12,"e":70.4},{"w":"about","s":70.4,"e":70.68},{"w":"how.","s":70.68,"e":70.94},{"w":"Asking","s":71.56,"e":71.98},{"w":"it","s":71.98,"e":72.14},{"w":"to","s":72.14,"e":72.34},{"w":"explain,","s":72.34,"e":72.94},{"w":"to","s":73.48,"e":73.56},{"w":"quiz","s":73.56,"e":73.86},{"w":"you","s":73.86,"e":74.22},{"w":"or","s":74.22,"e":74.88},{"w":"to","s":74.88,"e":75.1},{"w":"check","s":75.1,"e":75.34},{"w":"your","s":75.34,"e":75.56},{"w":"work","s":75.56,"e":75.94},{"w":"is","s":75.94,"e":76.46},{"w":"learning.","s":76.46,"e":76.84},{"w":"Asking","s":77.58,"e":78.04},{"w":"it","s":78.04,"e":78.18},{"w":"to","s":78.18,"e":78.32},{"w":"do","s":78.32,"e":78.48},{"w":"the","s":78.48,"e":78.6},{"w":"work,","s":78.6,"e":78.9},{"w":"then","s":78.9,"e":79.58},{"w":"handing","s":79.58,"e":79.92},{"w":"that","s":79.92,"e":80.28},{"w":"in","s":80.28,"e":80.46},{"w":"as","s":80.46,"e":80.62},{"w":"yours,","s":80.62,"e":80.88},{"w":"is","s":81.3,"e":81.64},{"w":"copying,","s":81.64,"e":82.06},{"w":"even","s":82.74,"e":83.04},{"w":"if","s":83.04,"e":83.22},{"w":"you","s":83.22,"e":83.36},{"w":"change","s":83.36,"e":83.7},{"w":"a","s":83.7,"e":83.88},{"w":"few","s":83.88,"e":83.98},{"w":"words.","s":83.98,"e":84.24}]},{"id":"s07","start":85.26,"end":105.13,"sentences":[{"text":"Rules differ.","start":85.61,"end":86.95},{"text":"One teacher says no AI for a task; another allows it for ideas or checking.","start":87.4,"end":92.97},{"text":"Your school’s rules decide, so ask when you’re not sure.","start":93.42,"end":97.09},{"text":"And many AI tools have a minimum age, often thirteen, with a parent’s permission under eighteen.","start":97.54,"end":104.43}],"words":[{"w":"Rules","s":85.61,"e":86.03},{"w":"differ.","s":86.03,"e":86.71},{"w":"One","s":87.4,"e":87.6},{"w":"teacher","s":87.6,"e":88.08},{"w":"says","s":88.08,"e":88.34},{"w":"no","s":88.34,"e":88.74},{"w":"AI","s":88.74,"e":89.1},{"w":"for","s":89.1,"e":89.42},{"w":"a","s":89.42,"e":89.56},{"w":"task;","s":89.56,"e":89.94},{"w":"another","s":90.24,"e":90.6},{"w":"allows","s":90.6,"e":91.08},{"w":"it","s":91.08,"e":91.26},{"w":"for","s":91.26,"e":91.52},{"w":"ideas","s":91.52,"e":92.02},{"w":"or","s":92.02,"e":92.5},{"w":"checking.","s":92.5,"e":92.74},{"w":"Your","s":93.42,"e":93.66},{"w":"school’s","s":93.66,"e":94.32},{"w":"rules","s":94.32,"e":94.6},{"w":"decide,","s":94.6,"e":95.18},{"w":"so","s":95.64,"e":95.8},{"w":"ask","s":95.8,"e":96.18},{"w":"when","s":96.18,"e":96.42},{"w":"you’re","s":96.42,"e":96.54},{"w":"not","s":96.54,"e":96.68},{"w":"sure.","s":96.68,"e":96.9},{"w":"And","s":97.54,"e":97.78},{"w":"many","s":97.78,"e":98.12},{"w":"AI","s":98.12,"e":98.5},{"w":"tools","s":98.5,"e":99.1},{"w":"have","s":99.1,"e":99.48},{"w":"a","s":99.48,"e":99.7},{"w":"minimum","s":99.7,"e":99.92},{"w":"age,","s":99.92,"e":100.4},{"w":"often","s":100.72,"e":101.1},{"w":"th