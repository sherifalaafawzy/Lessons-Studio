{"version":"0.1","lang":"en","source":"aligned","duration":209.56,"scenes":[{"id":"s01","start":0,"end":14.97,"sentences":[{"text":"Two of my students both handed in perfect homework.","start":0.35,"end":4.3},{"text":"In the test, one solved every question.","start":4.75,"end":8.54},{"text":"The other couldn’t even start.","start":8.99,"end":12.01},{"text":"So what was different?","start":12.46,"end":14.27}],"words":[{"w":"Two","s":0.35,"e":0.55},{"w":"of","s":0.55,"e":0.75},{"w":"my","s":0.75,"e":0.91},{"w":"students","s":0.91,"e":1.41},{"w":"both","s":1.41,"e":2.05},{"w":"handed","s":2.05,"e":2.47},{"w":"in","s":2.47,"e":2.77},{"w":"perfect","s":2.77,"e":3.35},{"w":"homework.","s":3.35,"e":3.91},{"w":"In","s":4.75,"e":4.97},{"w":"the","s":4.97,"e":5.13},{"w":"test,","s":5.13,"e":5.55},{"w":"one","s":5.99,"e":6.31},{"w":"solved","s":6.31,"e":7.15},{"w":"every","s":7.15,"e":7.81},{"w":"question.","s":7.81,"e":8.25},{"w":"The","s":8.99,"e":9.23},{"w":"other","s":9.23,"e":9.59},{"w":"couldn’t","s":9.59,"e":10.73},{"w":"even","s":10.73,"e":10.97},{"w":"start.","s":10.97,"e":11.55},{"w":"So","s":12.46,"e":12.72},{"w":"what","s":12.72,"e":13.28},{"w":"was","s":13.28,"e":13.48},{"w":"different?","s":13.48,"e":13.84}]},{"id":"s02","start":14.97,"end":19.97,"sentences":[{"text":"Today: how to use AI so that you’re the one who learns.","start":15.32,"end":19.27}],"words":[{"w":"Today:","s":15.32,"e":15.6},{"w":"how","s":16.18,"e":16.32},{"w":"to","s":16.32,"e":16.46},{"w":"use","s":16.46,"e":16.68},{"w":"AI","s":16.68,"e":17.08},{"w":"so","s":17.08,"e":17.6},{"w":"that","s":17.6,"e":17.76},{"w":"you’re","s":17.76,"e":18.26},{"w":"the","s":18.26,"e":18.34},{"w":"one","s":18.34,"e":18.52},{"w":"who","s":18.52,"e":18.72},{"w":"learns.","s":18.72,"e":18.98}]},{"id":"s03","start":19.97,"end":36.52,"sentences":[{"text":"The difference was who did the thinking.","start":20.32,"end":22.61},{"text":"One worked through the steps herself, and asked a chatbot to explain when she got stu