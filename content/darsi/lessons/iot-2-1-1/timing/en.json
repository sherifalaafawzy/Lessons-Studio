{"version":"0.1","lang":"en","source":"aligned","duration":229.46,"scenes":[{"id":"s01","start":0,"end":18.79,"sentences":[{"text":"A pupil brought me a torch that won't light.","start":0.35,"end":3.27},{"text":"New batteries, a good bulb, and still nothing.","start":3.72,"end":7.33},{"text":"Then we looked closer: one wire had come loose.","start":7.78,"end":12.02},{"text":"That tiny gap was the whole problem.","start":12.47,"end":15.57},{"text":"Today we find out why.","start":16.02,"end":18.09}],"words":[{"w":"A","s":0.35,"e":0.73},{"w":"pupil","s":0.73,"e":1.03},{"w":"brought","s":1.03,"e":1.37},{"w":"me","s":1.37,"e":1.59},{"w":"a","s":1.59,"e":1.67},{"w":"torch","s":1.67,"e":2.17},{"w":"that","s":2.17,"e":2.37},{"w":"won't","s":2.37,"e":2.73},{"w":"light.","s":2.73,"e":2.97},{"w":"New","s":3.72,"e":3.98},{"w":"batteries,","s":3.98,"e":4.54},{"w":"a","s":5.04,"e":5.12},{"w":"good","s":5.12,"e":5.4},{"w":"bulb,","s":5.4,"e":5.76},{"w":"and","s":6.24,"e":6.34},{"w":"still","s":6.34,"e":6.82},{"w":"nothing.","s":6.82,"e":7.06},{"w":"Then","s":7.78,"e":8.14},{"w":"we","s":8.14,"e":8.64},{"w":"looked","s":8.64,"e":8.96},{"w":"closer:","s":8.96,"e":9.44},{"w":"one","s":10.3,"e":10.52},{"w":"wire","s":10.52,"e":10.88},{"w":"had","s":10.88,"e":11.34},{"w":"come","s":11.34,"e":11.54},{"w":"loose.","s":11.54,"e":11.78},{"w":"That","s":12.47,"e":12.71},{"w":"tiny","s":12.71,"e":13.39},{"w":"gap","s":13.39,"e":13.77},{"w":"was","s":13.77,"e":14.19},{"w":"the","s":14.19,"e":14.39},{"w":"whole","s":14.39,"e":14.85},{"w":"problem.","s":14.85,"e":15.39},{"w":"Today","s":16.02,"e":16.4},{"w":"we","s":16.4,"e":17.06},{"w":"find","s":17.06,"e":17.4},{"w":"out","s":17.4,"e":17.64},{"w":"why.","s":17.64,"e":17.9}]},{"id":"s02","start":18.79,"end":26.51,"sentences":[{"text":"Today: current, LEDs and resistors, the circuit inside every connected device.","start":19.14,"end":25.81}],"words":[{"w":"Today:","s":19.14,"e":19.4},{"w":"current,","s":20.02,"e":20.44},{"w":"LEDs","s":20.86,"