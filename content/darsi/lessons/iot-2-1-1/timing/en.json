,"s":44.67,"e":44.79},{"w":"flow","s":44.79,"e":45.13},{"w":"stops","s":45.13,"e":45.61},{"w":"everywhere.","s":45.61,"e":46.15}]},{"id":"s04","start":47.24,"end":65.19,"sentences":[{"text":"Think of water in a pipe.","start":47.59,"end":49.49},{"text":"The pump is the battery, the pipe is the wire, and the flow of water is the current.","start":49.94,"end":56.28},{"text":"A narrow pipe lets less water through: that's resistance.","start":56.73,"end":61.05},{"text":"It's not a perfect picture, but it helps.","start":61.5,"end":64.49}],"words":[{"w":"Think","s":47.59,"e":48.05},{"w":"of","s":48.05,"e":48.27},{"w":"water","s":48.27,"e":48.61},{"w":"in","s":48.61,"e":48.95},{"w":"a","s":48.95,"e":49.03},{"w":"pipe.","s":49.03,"e":49.23},{"w":"The","s":49.94,"e":50.1},{"w":"pump","s":50.1,"e":50.44},{"w":"is","s":50.44,"e":50.74},{"w":"the","s":50.74,"e":50.9},{"w":"battery,","s":50.9,"e":51.26},{"w":"the","s":51.76,"e":52.08},{"w":"pipe","s":52.08,"e":52.44},{"w":"is","s":52.44,"e":52.84},{"w":"the","s":52.84,"e":53},{"w":"wire,","s":53,"e":53.34},{"w":"and","s":53.72,"e":54.06},{"w":"the","s":54.06,"e":54.26},{"w":"flow","s":54.26,"e":54.54},{"w":"of","s":54.54,"e":54.76},{"w":"water","s":54.76,"e":55.12},{"w":"is","s":55.12,"e":55.62},{"w":"the","s":55.62,"e":55.82},{"w":"current.","s":55.82,"e":56.04},{"w":"A","s":56.73,"e":56.87},{"w":"narrow","s":56.87,"e":57.21},{"w":"pipe","s":57.21,"e":57.65},{"w":"lets","s":57.65,"e":58.17},{"w":"less","s":58.17,"e":58.49},{"w":"water","s":58.49,"e":58.83},{"w":"through:","s":58.83,"e":59.19},{"w":"that's","s":59.51,"e":60.25},{"w":"resistance.","s":60.25,"e":60.61},{"w":"It's","s":61.5,"e":62.06},{"w":"not","s":62.06,"e":62.22},{"w":"a","s":62.22,"e":62.38},{"w":"perfect","s":62.38,"e":62.78},{"w":"picture,","s":62.78,"e":63.28},{"w":"but","s":63.62,"e":63.86},{"w":"it","s":63.86,"e":63.98},{"w":"helps.","s":63.98,"e":64.22}]},{"id":"s05","start":65.19,"end":84.39,"sentences":[{"text":"Some materials let current through: they're conductors.","start":65.54,"end":68.92},{"text":"Metals, pencil graphite and salty water all conduct.","start":69.37,"end":73.92},{"text":"Plastic, rubber, dry wood and glass don't: they're insulators.","start":74.37,"end":80.18},{"text":"That's why a wire is copper inside plastic.","start":80.63,"end":83.69}],"words":[{"w":"Some","s":65.54,"e":65.8},{"w":"materials","s":65.8,"e":66.36},{"w":"let","s":66.36,"e":66.7},{"w":"current","s":66.7,"e":67.02},{"w":"through:","s":67.02,"e":67.46},{"w":"they're","s":67.8,"e":68.14},{"w":"conductors.","s":68.14,"e":68.72},{"w":"Metals,","s":69.37,"e":69.99},{"w":"pencil","s":70.29,"e":70.63},{"w":"graphite","s":70.63,"e":71.37},{"w":"and","s":71.37,"e":71.79},{"w":"salty","s":71.79,"e":72.23},{"w":"water","s":72.23,"e":72.65},{"w":"all","s":72.65,"e":73.25},{"w":"conduct.","s":73.25,"e":73.61},{"w":"Plastic,","s":74.37,"e":74.95},{"w":"rubber,","s":75.37,"e":75.69},{"w":"dry","s":76.23,"e":76.55},{"w":"wood","s":76.55,"e":76.85},{"w":"and","s":76.85,"e":77.29},{"w":"glass","s":77.29,"e":77.67},{"w":"don't:","s":77.67,"e":78.45},{"w":"they're","s":78.93,"e":79.25},{"w":"insulators.","s":79.25,"e":79.87},{"w":"That's","s":80.63,"e":81.03},{"w":"why","s":81.03,"e":81.23},{"w":"a","s":81.23,"e":81.47},{"w":"wire","s":81.47,"e":81.83},{"w":"is","s":81.83,"e":82.27},{"w":"copper","s":82.27,"e":82.59},{"w":"inside","s":82.59,"e":82.95},{"w":"plastic.","s":82.95,"e":83.41}]},{"id":"s06","start":84.39,"end":101.92,"sentences":[{"text":"An LED is a light that works only one way round.","start":84.74,"end":88.81},{"text":"Its long leg goes to plus.","start":89.26,"end":91.58},{"text":"A red LED takes about two volts, and wants about ten to twenty milliamps.","start":92.03,"end":98.11},{"text":"Give it much more, and it burns out in a flash.","start":98.56,"end":101.22}],"words":[{"w":"An","s":84.74,"e":84.9},{"w":"LED","s":84.9,"e":85.36},{"w":"is","s":85.36,"e":86},{"w":"a","s":86,"e":86.14},{"w":"light","s":86.14,"e":86.4},{"w":"th