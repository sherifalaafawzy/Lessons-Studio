{"version":"0.1","lang":"en","source":"aligned","duration":211.55,"scenes":[{"id":"s01","start":0,"end":14.28,"sentences":[{"text":"My robot was meant to stop at the door.","start":0.35,"end":2.81},{"text":"Instead it walked straight into the wall, every single time.","start":3.26,"end":7.67},{"text":"My pupils groaned, then one of them shouted: it’s a bug, sir, let’s find it!","start":8.12,"end":13.58}],"words":[{"w":"My","s":0.35,"e":0.63},{"w":"robot","s":0.63,"e":1.01},{"w":"was","s":1.01,"e":1.35},{"w":"meant","s":1.35,"e":1.51},{"w":"to","s":1.51,"e":1.73},{"w":"stop","s":1.73,"e":2.01},{"w":"at","s":2.01,"e":2.23},{"w":"the","s":2.23,"e":2.33},{"w":"door.","s":2.33,"e":2.57},{"w":"Instead","s":3.26,"e":3.7},{"w":"it","s":3.7,"e":4.18},{"w":"walked","s":4.18,"e":4.5},{"w":"straight","s":4.5,"e":5.02},{"w":"into","s":5.02,"e":5.46},{"w":"the","s":5.46,"e":5.7},{"w":"wall,","s":5.7,"e":6.02},{"w":"every","s":6.4,"e":6.84},{"w":"single","s":6.84,"e":7.18},{"w":"time.","s":7.18,"e":7.5},{"w":"My","s":8.12,"e":8.62},{"w":"pupils","s":8.62,"e":8.94},{"w":"groaned,","s":8.94,"e":9.96},{"w":"then","s":10.3,"e":10.46},{"w":"one","s":10.46,"e":10.74},{"w":"of","s":10.74,"e":10.86},{"w":"them","s":10.86,"e":11},{"w":"shouted:","s":11,"e":11.3},{"w":"it’s","s":11.64,"e":12.02},{"w":"a","s":12.02,"e":12.02},{"w":"bug,","s":12.02,"e":12.26},{"w":"sir,","s":12.44,"e":12.58},{"w":"let’s","s":12.86,"e":13.08},{"w":"find","s":13.08,"e":13.26},{"w":"it!","s":13.26,"e":13.46}]},{"id":"s02","start":14.28,"end":19.08,"sentences":[{"text":"Today: decisions, and how to find and fix bugs.","start":14.63,"end":18.38}],"words":[{"w":"Today:","s":14.63,"e":14.93},{"w":"decisions,","s":15.25,"e":15.71},{"w":"and","s":16.23,"e":16.49},{"w":"how","s":16.49,"e":16.77},{"w":"to","s":16.77,"e":16.85},{"w":"find","s":16.85,"e":17.25},{"w":"and","s":17.25,"e":17.53},{"w":"fix","s":17.53,"e":17.79},{"w":"bugs.","s":17.79,"e":18.11}]},{"id":"s03","start":19.08,"end":36.14,"sentences":[{"text":"Pro