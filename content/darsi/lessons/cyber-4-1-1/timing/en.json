{"version":"0.1","lang":"en","source":"aligned","duration":211.35,"scenes":[{"id":"s01","start":0,"end":15.25,"sentences":[{"text":"Our school had a cyber safety policy.","start":0.35,"end":4.91},{"text":"Twelve pages, in a folder, in the head teacher’s cupboard.","start":5.36,"end":10.32},{"text":"Nobody had read it, and I’m the cyber lead!","start":10.77,"end":14.55}],"words":[{"w":"Our","s":0.35,"e":0.59},{"w":"school","s":0.59,"e":1.07},{"w":"had","s":1.07,"e":1.57},{"w":"a","s":1.57,"e":1.97},{"w":"cyber","s":1.97,"e":3.03},{"w":"safety","s":3.03,"e":3.79},{"w":"policy.","s":3.79,"e":4.51},{"w":"Twelve","s":5.36,"e":5.74},{"w":"pages,","s":5.74,"e":6.48},{"w":"in","s":6.96,"e":7.16},{"w":"a","s":7.16,"e":7.3},{"w":"folder,","s":7.3,"e":7.68},{"w":"in","s":8.06,"e":8.36},{"w":"the","s":8.36,"e":8.5},{"w":"head","s":8.5,"e":8.78},{"w":"teacher’s","s":8.78,"e":9.64},{"w":"cupboard.","s":9.64,"e":9.98},{"w":"Nobody","s":10.77,"e":11.29},{"w":"had","s":11.29,"e":11.67},{"w":"read","s":11.67,"e":11.93},{"w":"it,","s":11.93,"e":12.19},{"w":"and","s":12.69,"e":12.89},{"w":"I’m","s":12.89,"e":13.39},{"w":"the","s":13.39,"e":13.63},{"w":"cyber","s":13.63,"e":14.01},{"w":"lead!","s":14.01,"e":14.35}]},{"id":"s02","start":15.25,"end":23.2,"sentences":[{"text":"Today: how to write a one-page cyber safety policy that your colleagues will actually read and follow.","start":15.6,"end":22.5}],"words":[{"w":"Today:","s":15.6,"e":15.86},{"w":"how","s":16.46,"e":16.68},{"w":"to","s":16.68,"e":16.9},{"w":"write","s":16.9,"e":17.16},{"w":"a","s":17.16,"e":17.38},{"w":"one-page","s":17.38,"e":18.04},{"w":"cyber","s":18.04,"e":18.5},{"w":"safety","s":18.5,"e":18.82},{"w":"policy","s":18.82,"e":19.24},{"w":"that","s":19.24,"e":19.78},{"w":"your","s":19.78,"e":19.92},{"w":"colleagues","s":19.92,"e":20.36},{"w":"will","s":20.36,"e":20.64},{"w":"actually","s":20.64,"e":21.18},{"w":"read","s":21.18,"e":21.7},{"w":"and","s":21.7,"e":21.96},{"w":"follow.","s":21.96,"e":22.3}]},{"id":"s03","start":23.2,"end":38.99,"sentences":[{"text":"A policy only protects the school if people know what it says.","start":23.55,"end":28.34},{"text":"So keep it to one page, in plain words, with a name next to every job.","start":28.79,"end":34.06},{"text":"Review it once a year, and whenever something goes wrong.","start":34.51,"end":38.29}],"words":[{"w":"A","s":23.55,"e":23.69},{"w":"policy","s":23.69,"e":24.23},{"w":"only","s":24.23,"e":24.93},{"w":"protects","s":24.93,"e":25.35},{"w":"the","s":25.35,"e":25.69},{"w":"school","s":25.69,"e":26.07},{"w":"if","s":26.07,"e":26.69},{"w":"people","s":26.69,"e":27.13},{"w":"know","s":27.13,"e":27.39},{"w":"what","s":27.39,"e":27.63},{"w":"it","s":27.63,"e":27.75},{"w":"says.","s":27.75,"e":28.01},{"w":"So","s":28.79,"e":29.09},{"w":"keep","s":29.09,"e":29.53},{"w":"it","s":29.53,"e":29.69},{"w":"to","s":29.69,"e":29.81},{"w":"one","s":29.81,"e":30.03},{"w":"page,","s":30.03,"e":30.41},{"w":"in","s":30.87,"e":31.05},{"w":"plain","s":31.05,"e":31.35},{"w":"words,","s":31.35,"e":31.77},{"w":"with","s":32.13,"e":32.35},{"w":"a","s":32.35,"e":32.49},{"w":"name","s":32.49,"e":32.77},{"w":"next","s":32.77,"e":33.01},{"w":"to","s":33.01,"e":33.25},{"w":"every","s":33.25,"e":33.55},{"w":"job.","s":33.55,"e":33.87},{"w":"Review","s":34.51,"e":34.89},{"w":"it","s":34.89,"e":35.11},{"w":"once","s":35.11,"e":35.45},{"w":"a","s":35.45,"e":35.69},{"w":"year,","s":35.69,"e":35.99},{"w":"and","s":36.39,"e":36.81},{"w":"whenever","s":36.81,"e":37.23},{"w":"something","s":37.23,"e":37.61},{"w":"goes","s":37.61,"e":37.87},{"w":"wrong.","s":37.87,"e":38.13}]},{"id":"s04","start":38.99,"end":73.5,"sentences":[{"text":"What goes on the page?","start":39.34,"end":40.89},{"text":"Five short headings.","start":41.34,"end":42.9},{"text":"Who leads: a named cyber lead and a deputy.","start":43.35,"end":46.87},{"text":"Accounts: long passphrases, never shared, and two-step sign-in on email.","start":47.32,"end":52.86},{"text":"Devices: screen locks, updates and approved apps.","start":53.31,"end":58.33},{"text":"Data and groups: collect less, share with named people, back it up, and give every official group two admins.","start":58.78,"end":67.62},{"text":"Incidents: report the same day, and nobody is blamed for reporting.","start":68.07,"end":72.8}],"words":[{"w":"What","s":39.34,"e":39.58},{"w":"goes","s":39.58,"e":39.84},{"w":"on","s":39.84,"e":40.1},{"w":"the","s":40.1,"e":40.24},{"w":"page?","s":40.24,"e":40.54},{"w":"Five","s":41.34,"e":41.76},{"w":"short","s":41.76,"e":42.2},{"w":"headings.","s":42.2,"e":42.7},{"w":"Who","s":43.35,"e":43.53},{"w":"leads:","s":43.53,"e":43.87},{"w":"a","s":44.59,"e":44.67},{"w":"named","s":44.67,"e":45.03},{"w":"cyber","s":45.03,"e":45.43},{"w":"lead","s":45.43,"e":45.81},{"w":"and","s":45.81,"e":46.27},{"w":"a","s":46.27,"e":46.39},{"w":"deputy.","s":46.39,"e":46.63},{"w":"Accounts:","s":47.32,"e":48.14},{"w":"long","s":48.16,"e":48.58},{"w":"passphrases,","s":48.58,"e":49.58},{"w":"never","s":49.92,"e":50.1},{"w":"shared,","s":50.1,"e":50.5},{"w":"and","s":51.06,"e":51.24},{"w":"two-step","s":51.24,"e":51.76},{"w":"sign-in","s":51.76,"e":52.28},{"w":"on","s":52.28,"e":52.4},{"w":"email.","s":52.4,"e":52.64},{"w":"Devices:","s":53.31,"e":54.09},{"w":"screen","s":54.47,"e":54.87},{"w":"locks,","s":54.87,"e":55.45},{"w":"updates","s":55.95,"e":56.29},{"w":"and","s":56.29,"e":57.21},{"w":"approved","s":57.21,"e":57.67},{"w":"apps.","s":57.67,"e":58.09},{"w":"Data","s":58.78,"e":59.12},{"w":"and","s":59.12,"e":59.64},{"w":"groups:","s":59.64,"e":60},{"w":"collect","s":60.54,"e":60.92},{"w":"less,","s":60.92,"e":61.34},{"w":"share","s":61.76,"e":62.04},{"w":"with","s":62.04,"e":62.34},{"w":"named","s":62.34,"e":62.66},{"w":"people,","s":62.66,"e":63.08},{"w":"back","s":63.54,"e":63.84},{"w":"it","s":63.84,"e":64.02},{"w":"up,","s":64.02,"e":64.18},{"w":"and","s":64.54,"e":64.8},{"w":"give","s":64.8,"e":65.06},{"w":"every","s":65.06,"e":65.44},{"w":"official","s":65.44,"e":65.84},{"w":"group","s":65.84,"e":66.16},{"w":"two","s":66.16,"e":66.76},{"w":"admins.","s":66.76,"e":67.48},{"w":"Incidents:","s":68.07,"e":68.57},{"w":"report","s":68.89,"e":69.17},{"w":"the","s":69.17,"e":69.55},{"w":"same","s":69.55,"e":69.91},{"w":"day,","s":69.91,"e":70.29},{"w":"and","s":70.69,"e":70.91},{"w":"nobody","s":70.91,"e":71.33},{"w":"is","s":71.33,"e":71.59},{"w":"blamed","s":71.59,"e":71.87},{"w":"for","s":71.87,"e":72.15},{"w":"reporting.","s":72.15,"e":72.49}]},{"id":"s05","start":73.5,"end":102.77,"sentences":[{"text":"Now, passwords: this is where old policies go wrong.","start":73.85,"end":78.03},{"text":"Current guidance from NIST, the American standards body, says length beats symbols.","start":78.48,"end":84.66},{"text":"At least fifteen characters when a password is used alone, or eight with two-step sign-in.","start":85.11,"end":91.46},{"text":"No forced changes every month: change a password when there are signs it leaked.","start":91.91,"end":97.39},{"text":"And check new passwords against lists of common and leaked ones.","start":97.84,"end":102.07}],"words":[{"w":"Now,","s":73.85,"e":74.13},{"w":"passwords:","s":74.39,"e":74.83},{"w":"this","s":75.65,"e":75.97},{"w":"is","s":75.97,"e":76.11},{"w":"where","s":76.11,"e":76.29},{"w":"old","s":76.29,"e":76.57},{"w":"policies","s":76.57,"e":77.13},{"w":"go","s":77.13,"e":77.43},{"w":"wrong.","s":77.43,"e":77.77},{"w":"Current","s":78.48,"e":78.96},{"w":"guidance","s":78.96,"e":79.4},{"w":"from","s":79.4,"e":79.8},{"w":"NIST,","s":79.8,"e":80.36},{"w":"the","s":80.6,"e":80.68},{"w":"American","s":80.68,"e":81.08},{"w":"standards","s":81.08,"e":81.46},{"w":"body,","s":81.46,"e":81.94},{"w":"says","s":82.42,"e":82.64},{"w":"length","s":82.64,"e":83.22},{"w":"beats","s":83.22,"e":83.88},{"w":"symbols.","s":83.88,"e":84.36},{"w":"At","s":85.11,"e":85.27},{"w":"least","s":85.27,"e":85.77},{"w":"fifteen","s":85.77,"e":86.35},{"w":"characters","s":86.35,"e":87.07},{"w":"when","s":87.07,"e":87.53},{"w":