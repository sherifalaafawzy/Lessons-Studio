ow","s":19.77,"e":20.09},{"w":"defenders","s":20.09,"e":20.49},{"w":"use","s":20.49,"e":20.91},{"w":"it.","s":20.91,"e":21.07}]},{"id":"s03","start":21.8,"end":40.45,"sentences":[{"text":"A hash function turns any data — a word, a photo, a whole film — into a short fingerprint of fixed length.","start":22.15,"end":31.14},{"text":"One of the most used, SHA-256, always makes two hundred and fifty-six bits, written as sixty-four characters.","start":31.59,"end":39.75}],"words":[{"w":"A","s":22.15,"e":22.31},{"w":"hash","s":22.31,"e":22.67},{"w":"function","s":22.67,"e":22.93},{"w":"turns","s":22.93,"e":23.79},{"w":"any","s":23.79,"e":24.05},{"w":"data","s":24.05,"e":24.39},{"w":"—","s":24.39,"e":24.97},{"w":"a","s":24.97,"e":25.09},{"w":"word,","s":25.09,"e":25.49},{"w":"a","s":25.93,"e":26.11},{"w":"photo,","s":26.11,"e":26.53},{"w":"a","s":27.11,"e":27.29},{"w":"whole","s":27.29,"e":27.51},{"w":"film","s":27.51,"e":28.01},{"w":"—","s":28.01,"e":28.47},{"w":"into","s":28.47,"e":28.69},{"w":"a","s":28.69,"e":28.91},{"w":"short","s":28.91,"e":29.31},{"w":"fingerprint","s":29.31,"e":29.93},{"w":"of","s":29.93,"e":30.29},{"w":"fixed","s":30.29,"e":30.63},{"w":"length.","s":30.63,"e":31.01},{"w":"One","s":31.59,"e":31.77},{"w":"of","s":31.77,"e":31.91},{"w":"the","s":31.91,"e":32.01},{"w":"most","s":32.01,"e":32.21},{"w":"used,","s":32.21,"e":32.73},{"w":"SHA-256,","s":33.25,"e":34.33},{"w":"always","s":34.75,"e":35.15},{"w":"makes","s":35.15,"e":35.57},{"w":"two","s":35.57,"e":36.05},{"w":"hundred","s":36.05,"e":36.35},{"w":"and","s":36.35,"e":36.51},{"w":"fifty-six","s":36.51,"e":37.09},{"w":"bits,","s":37.09,"e":37.43},{"w":"written","s":37.81,"e":38.07},{"w":"as","s":38.07,"e":38.41},{"w":"sixty-four","s":38.41,"e":38.99},{"w":"characters.","s":38.99,"e":39.41}]},{"id":"s04","start":40.45,"end":61.28,"sentences":[{"text":"A good hash keeps three rules.","start":40.8,"end":43.11},{"text":"The same input always gives the same fingerprint.","start":43.56,"end":47.11},{"te