{"version":"0.1","lang":"en","source":"aligned","duration":185.89,"scenes":[{"id":"s01","start":0,"end":14.12,"sentences":[{"text":"Every Friday, our deputy head copies attendance from twelve registers into one report.","start":0.35,"end":6.69},{"text":"It takes her three hours.","start":7.14,"end":8.94},{"text":"And last month, she counted one class twice.","start":9.39,"end":13.42}],"words":[{"w":"Every","s":0.35,"e":0.65},{"w":"Friday,","s":0.65,"e":1.25},{"w":"our","s":1.65,"e":1.83},{"w":"deputy","s":1.83,"e":2.21},{"w":"head","s":2.21,"e":2.61},{"w":"copies","s":2.61,"e":3.11},{"w":"attendance","s":3.11,"e":3.67},{"w":"from","s":3.67,"e":4.05},{"w":"twelve","s":4.05,"e":4.67},{"w":"registers","s":4.67,"e":5.15},{"w":"into","s":5.15,"e":5.75},{"w":"one","s":5.75,"e":6.15},{"w":"report.","s":6.15,"e":6.49},{"w":"It","s":7.14,"e":7.3},{"w":"takes","s":7.3,"e":7.58},{"w":"her","s":7.58,"e":7.74},{"w":"three","s":7.74,"e":8.16},{"w":"hours.","s":8.16,"e":8.56},{"w":"And","s":9.39,"e":9.91},{"w":"last","s":9.91,"e":10.25},{"w":"month,","s":10.25,"e":10.75},{"w":"she","s":11.05,"e":11.31},{"w":"counted","s":11.31,"e":11.73},{"w":"one","s":11.73,"e":12.15},{"w":"class","s":12.15,"e":12.49},{"w":"twice.","s":12.49,"e":13.23}]},{"id":"s02","start":14.12,"end":20.18,"sentences":[{"text":"Today: automating the weekly report, with a pipeline that's safe to run again.","start":14.47,"end":19.48}],"words":[{"w":"Today:","s":14.47,"e":14.77},{"w":"automating","s":15.25,"e":15.77},{"w":"the","s":15.77,"e":16.01},{"w":"weekly","s":16.01,"e":16.33},{"w":"report,","s":16.33,"e":16.87},{"w":"with","s":17.21,"e":17.45},{"w":"a","s":17.45,"e":17.55},{"w":"pipeline","s":17.55,"e":17.87},{"w":"that's","s":17.87,"e":18.45},{"w":"safe","s":18.45,"e":18.63},{"w":"to","s":18.63,"e":18.85},{"w":"run","s":18.85,"e":19.01},{"w":"again.","s":19.01,"e":19.25}]},{"id":"s03","start":20.18,"end":37.58,"sentences":[{"text":"A data pipeline is a set of steps that runs on its own, again and again.",