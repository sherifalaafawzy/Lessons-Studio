.82},{"w":"With","s":59.29,"e":59.49},{"w":"AND,","s":59.49,"e":59.99},{"w":"both","s":60.57,"e":60.81},{"w":"must","s":60.81,"e":61.25},{"w":"be","s":61.25,"e":61.49},{"w":"true,","s":61.49,"e":61.97},{"w":"so","s":62.35,"e":62.65},{"w":"at","s":62.65,"e":62.91},{"w":"midday","s":62.91,"e":63.41},{"w":"the","s":63.41,"e":63.67},{"w":"pump","s":63.67,"e":63.99},{"w":"waits,","s":63.99,"e":64.45},{"w":"and","s":64.83,"e":65.05},{"w":"less","s":65.05,"e":65.31},{"w":"water","s":65.31,"e":65.65},{"w":"dries","s":65.65,"e":65.89},{"w":"up","s":65.89,"e":66.09},{"w":"in","s":66.09,"e":66.21},{"w":"the","s":66.21,"e":66.31},{"w":"sun.","s":66.31,"e":66.53}]},{"id":"s06","start":67.4,"end":79.33,"sentences":[{"text":"OR works the other way: either condition is enough.","start":67.75,"end":71.64},{"text":"IF the smoke sensor detects smoke OR someone presses the fire button, THEN the alarm rings.","start":72.09,"end":78.63}],"words":[{"w":"OR","s":67.75,"e":68.07},{"w":"works","s":68.07,"e":68.55},{"w":"the","s":68.55,"e":68.81},{"w":"other","s":68.81,"e":69.13},{"w":"way:","s":69.13,"e":69.47},{"w":"either","s":69.99,"e":70.33},{"w":"condition","s":70.33,"e":70.91},{"w":"is","s":70.91,"e":71.17},{"w":"enough.","s":71.17,"e":71.41},{"w":"IF","s":72.09,"e":72.29},{"w":"the","s":72.29,"e":72.47},{"w":"smoke","s":72.47,"e":72.77},{"w":"sensor","s":72.77,"e":73.25},{"w":"detects","s":73.25,"e":73.79},{"w":"smoke","s":73.79,"e":74.13},{"w":"OR","s":74.13,"e":74.79},{"w":"someone","s":74.79,"e":75.35},{"w":"presses","s":75.35,"e":75.67},{"w":"the","s":75.67,"e":75.95},{"w":"fire","s":75.95,"e":76.17},{"w":"button,","s":76.17,"e":76.59},{"w":"THEN","s":76.93,"e":77.53},{"w":"the","s":77.53,"e":77.73},{"w":"alarm","s":77.73,"e":78.01},{"w":"rings.","s":78.01,"e":78.37}]},{"id":"s07","start":79.33,"end":90.3,"sentences":[{"text":"Quick check!","start":79.68,"end":80.6},{"text":"The school gate light should come on only for people arriving after dark.","start":81.05,"end":86.64},{"tex