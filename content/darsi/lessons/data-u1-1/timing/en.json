","s":111.77,"e":111.99},{"w":"check!","s":111.99,"e":112.35},{"w":"A","s":113.14,"e":113.28},{"w":"new","s":113.28,"e":113.54},{"w":"lecturer","s":113.54,"e":114.1},{"w":"cannot","s":114.1,"e":114.7},{"w":"be","s":114.7,"e":115.08},{"w":"stored","s":115.08,"e":115.5},{"w":"until","s":115.5,"e":116.04},{"w":"they","s":116.04,"e":116.38},{"w":"have","s":116.38,"e":116.7},{"w":"at","s":116.7,"e":116.9},{"w":"least","s":116.9,"e":117.18},{"w":"one","s":117.18,"e":117.6},{"w":"enrolled","s":117.6,"e":118.26},{"w":"student.","s":118.26,"e":118.8},{"w":"Which","s":119.52,"e":119.96},{"w":"anomaly","s":119.96,"e":120.66},{"w":"is","s":120.66,"e":121.16},{"w":"that?","s":121.16,"e":121.4}]},{"id":"s09","start":122.32,"end":133.37,"sentences":[{"text":"An insertion anomaly.","start":122.67,"end":124.51},{"text":"Facts about lecturers are trapped inside enrolment rows.","start":124.96,"end":128.75},{"text":"A separate lecturer table lets us record them independently.","start":129.2,"end":132.67}],"words":[{"w":"An","s":122.67,"e":122.83},{"w":"insertion","s":122.83,"e":123.75},{"w":"anomaly.","s":123.75,"e":124.01},{"w":"Facts","s":124.96,"e":125.38},{"w":"about","s":125.38,"e":125.64},{"w":"lecturers","s":125.64,"e":126.3},{"w":"are","s":126.3,"e":126.56},{"w":"trapped","s":126.56,"e":127.12},{"w":"inside","s":127.12,"e":127.52},{"w":"enrolment","s":127.52,"e":128.24},{"w":"rows.","s":128.24,"e":128.48},{"w":"A","s":129.2,"e":129.34},{"w":"separate","s":129.34,"e":129.68},{"w":"lecturer","s":129.68,"e":129.94},{"w":"table","s":129.94,"e":130.62},{"w":"lets","s":130.62,"e":130.88},{"w":"us","s":130.88,"e":131.08},{"w":"record","s":131.08,"e":131.4},{"w":"them","s":131.4,"e":131.76},{"w":"independently.","s":131.76,"e":132.08}]},{"id":"s10","start":133.37,"end":144.27,"sentences":[{"text":"In the app, open the schema lab.","start":133.72,"end":136.27},{"text":"Split a flat table into related tables and check that every fact is stored once.","start":136.72,"end":143.57}],"words