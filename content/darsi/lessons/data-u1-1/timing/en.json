"w":"how","s":23.08,"e":23.32},{"w":"functional","s":23.32,"e":23.88},{"w":"dependencies","s":23.88,"e":24.58},{"w":"drive","s":24.58,"e":25},{"w":"normalisation,","s":25,"e":25.8},{"w":"and","s":26.32,"e":26.66},{"w":"how","s":26.66,"e":27},{"w":"to","s":27,"e":27.16},{"w":"teach","s":27.16,"e":27.48},{"w":"design","s":27.48,"e":27.9},{"w":"so","s":27.9,"e":28.26},{"w":"students","s":28.26,"e":28.56},{"w":"stop","s":28.56,"e":29.02},{"w":"building","s":29.02,"e":29.46},{"w":"one","s":29.46,"e":29.8},{"w":"giant","s":29.8,"e":30.12},{"w":"table.","s":30.12,"e":30.5}]},{"id":"s03","start":31.37,"end":46.42,"sentences":[{"text":"Codd proposed storing data as relations: sets of tuples over named attributes.","start":31.72,"end":37.64},{"text":"A key identifies each tuple uniquely.","start":38.09,"end":41.05},{"text":"Queries describe what you want, not how to fetch it.","start":41.5,"end":45.72}],"words":[{"w":"Codd","s":31.72,"e":32.16},{"w":"proposed","s":32.16,"e":32.42},{"w":"storing","s":32.42,"e":33.1},{"w":"data","s":33.1,"e":33.5},{"w":"as","s":33.5,"e":33.92},{"w":"relations:","s":33.92,"e":34.48},{"w":"sets","s":34.92,"e":35.36},{"w":"of","s":35.36,"e":35.6},{"w":"tuples","s":35.6,"e":36.12},{"w":"over","s":36.12,"e":36.38},{"w":"named","s":36.38,"e":36.78},{"w":"attributes.","s":36.78,"e":37.28},{"w":"A","s":38.09,"e":38.23},{"w":"key","s":38.23,"e":38.59},{"w":"identifies","s":38.59,"e":39.47},{"w":"each","s":39.47,"e":39.87},{"w":"tuple","s":39.87,"e":40.41},{"w":"uniquely.","s":40.41,"e":40.73},{"w":"Queries","s":41.5,"e":42.12},{"w":"describe","s":42.12,"e":42.6},{"w":"what","s":42.6,"e":43.2},{"w":"you","s":43.2,"e":43.46},{"w":"want,","s":43.46,"e":43.78},{"w":"not","s":44.16,"e":44.52},{"w":"how","s":44.52,"e":44.98},{"w":"to","s":44.98,"e":45.12},{"w":"fetch","s":45.12,"e":45.4},{"w":"it.","s":45.4,"e":45.6}]},{"id":"s04","start":46.42,"end":62.8,"sentences":[{"text":"A functional dependency says one set of attributes determines another.","start":46.