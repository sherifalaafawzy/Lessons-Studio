{"version":"0.1","lang":"en","source":"aligned","duration":212.38,"scenes":[{"id":"s01","start":0,"end":17.94,"sentences":[{"text":"Three of my students measured the same desk.","start":0.35,"end":4.91},{"text":"Kemi wrote seventy.","start":5.36,"end":7.89},{"text":"Tunde wrote seven hundred.","start":8.34,"end":10.93},{"text":"Grace wrote twenty-eight.","start":11.38,"end":13.54},{"text":"Funny thing is, they could all be right.","start":13.99,"end":17.24}],"words":[{"w":"Three","s":0.35,"e":0.77},{"w":"of","s":0.77,"e":1.15},{"w":"my","s":1.15,"e":1.33},{"w":"students","s":1.33,"e":1.89},{"w":"measured","s":1.89,"e":2.69},{"w":"the","s":2.69,"e":3.35},{"w":"same","s":3.35,"e":3.99},{"w":"desk.","s":3.99,"e":4.63},{"w":"Kemi","s":5.36,"e":5.92},{"w":"wrote","s":5.92,"e":6.6},{"w":"seventy.","s":6.6,"e":7.58},{"w":"Tunde","s":8.34,"e":8.76},{"w":"wrote","s":8.76,"e":9.18},{"w":"seven","s":9.18,"e":9.92},{"w":"hundred.","s":9.92,"e":10.66},{"w":"Grace","s":11.38,"e":11.8},{"w":"wrote","s":11.8,"e":12.48},{"w":"twenty-eight.","s":12.48,"e":13.24},{"w":"Funny","s":13.99,"e":14.33},{"w":"thing","s":14.33,"e":14.69},{"w":"is,","s":14.69,"e":14.91},{"w":"they","s":15.37,"e":15.65},{"w":"could","s":15.65,"e":16.11},{"w":"all","s":16.11,"e":16.49},{"w":"be","s":16.49,"e":16.69},{"w":"right.","s":16.69,"e":16.99}]},{"id":"s02","start":17.94,"end":25.6,"sentences":[{"text":"Today: measure it right, write it down well, and catch readings that can't be true.","start":18.29,"end":24.9}],"words":[{"w":"Today:","s":18.29,"e":18.65},{"w":"measure","s":19.21,"e":19.75},{"w":"it","s":19.75,"e":19.99},{"w":"right,","s":19.99,"e":20.31},{"w":"write","s":20.83,"e":21.17},{"w":"it","s":21.17,"e":21.33},{"w":"down","s":21.33,"e":21.61},{"w":"well,","s":21.61,"e":21.95},{"w":"and","s":22.59,"e":22.65},{"w":"catch","s":22.65,"e":22.99},{"w":"readings","s":22.99,"e":23.37},{"w":"that","s":23.37,"e":23.83},{"w":"can't","s":23.83,"e":24.35},{"w":"be","s":24.35,"e":24.47},{"w":"true.","s":24.47,"e":24.79}]},{"id":"s03","start":25.6,"end":44.08,"sentences":[{"text":"Look at their tapes.","start":25.95,"end":27.18},{"text":"Kemi measured seventy centimetres.","start":27.63,"end":30.63},{"text":"Tunde measured seven hundred millimetres: the same length.","start":31.08,"end":34.92},{"text":"Grace used a tailor's tape in inches: about twenty-eight.","start":35.37,"end":39.33},{"text":"A number without its unit means almost nothing.","start":39.78,"end":43.38}],"words":[{"w":"Look","s":25.95,"e":26.21},{"w":"at","s":26.21,"e":26.37},{"w":"their","s":26.37,"e":26.55},{"w":"tapes.","s":26.55,"e":27.07},{"w":"Kemi","s":27.63,"e":28.29},{"w":"measured","s":28.29,"e":28.77},{"w":"seventy","s":28.77,"e":29.37},{"w":"centimetres.","s":29.37,"e":30.43},{"w":"Tunde","s":31.08,"e":31.4},{"w":"measured","s":31.4,"e":31.94},{"w":"seven","s":31.94,"e":32.44},{"w":"hundred","s":32.44,"e":32.8},{"w":"millimetres:","s":32.8,"e":33.5},{"w":"the","s":33.88,"e":33.98},{"w":"same","s":33.98,"e":34.36},{"w":"length.","s":34.36,"e":34.68},{"w":"Grace","s":35.37,"e":35.65},{"w":"used","s":35.65,"e":36.05},{"w":"a","s":36.05,"e":36.23},{"w":"tailor's","s":36.23,"e":36.81},{"w":"tape","s":36.81,"e":37.17},{"w":"in","s":37.17,"e":37.31},{"w":"inches:","s":37.31,"e":37.77},{"w":"about","s":38.19,"e":38.43},{"w":"twenty-eight.","s":38.43,"e":39.13},{"w":"A","s":39.78,"e":39.98},{"w":"number","s":39.98,"e":40.36},{"w":"without","s":40.36,"e":40.82},{"w":"its","s":40.82,"e":41.16},{"w":"unit","s":41.16,"e":41.58},{"w":"means","s":41.58,"e":42.16},{"w":"almost","s":42.16,"e":42.72},{"w":"nothing.","s":42.72,"e":43.14}]},{"id":"s04","start":44.08,"end":61.37,"sentences":[{"text":"Next, read the scale.","start":44.43,"end":46.12},{"text":"Find two numbered marks, and count the small gaps between them.","start":46.57,"end":50.74},{"text":"Ten gaps from twenty to thirty?","start":51.19,"end":53.54},{"text":"Each gap is worth one.","start":53.99,"end":56.12},{"text":"Four gaps from zero to twenty