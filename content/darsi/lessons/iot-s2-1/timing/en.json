{"version":"0.1","lang":"en","source":"aligned","duration":197.3,"scenes":[{"id":"s01","start":0,"end":13.05,"sentences":[{"text":"Amani had a battery, a bulb and one wire.","start":0.35,"end":3.79},{"text":"She tried to light the bulb: nothing.","start":4.24,"end":6.61},{"text":"Then she moved the wire, and it lit!","start":7.06,"end":9.53},{"text":"What changed?","start":9.98,"end":10.91},{"text":"Let's find out.","start":11.36,"end":12.35}],"words":[{"w":"Amani","s":0.35,"e":0.79},{"w":"had","s":0.79,"e":1.05},{"w":"a","s":1.05,"e":1.25},{"w":"battery,","s":1.25,"e":1.65},{"w":"a","s":2.19,"e":2.27},{"w":"bulb","s":2.27,"e":2.61},{"w":"and","s":2.61,"e":3.03},{"w":"one","s":3.03,"e":3.29},{"w":"wire.","s":3.29,"e":3.59},{"w":"She","s":4.24,"e":4.46},{"w":"tried","s":4.46,"e":4.78},{"w":"to","s":4.78,"e":4.96},{"w":"light","s":4.96,"e":5.16},{"w":"the","s":5.16,"e":5.32},{"w":"bulb:","s":5.32,"e":5.56},{"w":"nothing.","s":6.1,"e":6.28},{"w":"Then","s":7.06,"e":7.22},{"w":"she","s":7.22,"e":7.4},{"w":"moved","s":7.4,"e":7.62},{"w":"the","s":7.62,"e":7.8},{"w":"wire,","s":7.8,"e":8.12},{"w":"and","s":8.64,"e":8.82},{"w":"it","s":8.82,"e":8.94},{"w":"lit!","s":8.94,"e":9.2},{"w":"What","s":9.98,"e":10.16},{"w":"changed?","s":10.16,"e":10.56},{"w":"Let's","s":11.36,"e":11.72},{"w":"find","s":11.72,"e":11.88},{"w":"out.","s":11.88,"e":12.14}]},{"id":"s02","start":13.05,"end":18.36,"sentences":[{"text":"Today: build a circuit that lights up, and keep it safe.","start":13.4,"end":17.66}],"words":[{"w":"Today:","s":13.4,"e":13.94},{"w":"build","s":14.36,"e":14.62},{"w":"a","s":14.62,"e":14.8},{"w":"circuit","s":14.8,"e":15.14},{"w":"that","s":15.14,"e":15.5},{"w":"lights","s":15.5,"e":15.8},{"w":"up,","s":15.8,"e":16.16},{"w":"and","s":16.6,"e":16.8},{"w":"keep","s":16.8,"e":17.04},{"w":"it","s":17.04,"e":17.18},{"w":"safe.","s":17.18,"e":17.4}]},{"id":"s03","start":18.36,"end":35.7,"sentences":[{"text":"A circuit is a loop: current flows out of the battery, through the b