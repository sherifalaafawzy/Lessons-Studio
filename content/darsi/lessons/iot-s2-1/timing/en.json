b","s":56.04,"e":56.26},{"w":"lights,","s":56.26,"e":56.72},{"w":"it's","s":57.14,"e":57.38},{"w":"a","s":57.38,"e":57.44},{"w":"conductor:","s":57.44,"e":57.88},{"w":"coins,","s":58.56,"e":59.08},{"w":"keys,","s":59.56,"e":60.02},{"w":"foil;","s":60.58,"e":60.96},{"w":"pencil","s":61.86,"e":62.2},{"w":"lead","s":62.2,"e":62.5},{"w":"conducts","s":62.5,"e":63.1},{"w":"too,","s":63.1,"e":63.38},{"w":"but","s":63.88,"e":64.02},{"w":"weakly,","s":64.02,"e":64.56},{"w":"so","s":64.92,"e":65.14},{"w":"the","s":65.14,"e":65.3},{"w":"bulb","s":65.3,"e":65.52},{"w":"glows","s":65.52,"e":65.94},{"w":"dimly","s":65.94,"e":66.42},{"w":"or","s":66.42,"e":66.9},{"w":"not","s":66.9,"e":67.14},{"w":"at","s":67.14,"e":67.3},{"w":"all.","s":67.3,"e":67.46},{"w":"If","s":67.97,"e":68.15},{"w":"not,","s":68.15,"e":68.41},{"w":"it's","s":68.75,"e":68.99},{"w":"an","s":68.99,"e":69.05},{"w":"insulator:","s":69.05,"e":69.57},{"w":"plastic,","s":70.03,"e":70.67},{"w":"rubber,","s":71.01,"e":71.35},{"w":"paper,","s":71.81,"e":72.17},{"w":"dry","s":72.69,"e":72.93},{"w":"wood.","s":72.93,"e":73.21}]},{"id":"s06","start":74.12,"end":84.34,"sentences":[{"text":"Quick check!","start":74.47,"end":75.14},{"text":"Kofi's wires both touch the bulb, but one end is still inside its plastic coat.","start":75.59,"end":81.31},{"text":"Will the bulb light?","start":81.76,"end":83.64}],"words":[{"w":"Quick","s":74.47,"e":74.65},{"w":"check!","s":74.65,"e":74.93},{"w":"Kofi's","s":75.59,"e":76.07},{"w":"wires","s":76.07,"e":76.43},{"w":"both","s":76.43,"e":76.77},{"w":"touch","s":76.77,"e":77.23},{"w":"the","s":77.23,"e":77.37},{"w":"bulb,","s":77.37,"e":77.69},{"w":"but","s":78.17,"e":78.43},{"w":"one","s":78.43,"e":78.81},{"w":"end","s":78.81,"e":79.17},{"w":"is","s":79.17,"e":79.43},{"w":"still","s":79.43,"e":79.69},{"w":"inside","s":79.69,"e":80.05},{"w":"its","s":80.05,"e":80.33},{"w":"plastic","s":80.33,"e":80.75},{"w":"coat.","s":80.75,"e":81.09},{"w":"Will","s":81.76,"e":82.32},{"w":"the","s":82.32,"e":82.64},{"w":"bulb","s":82.64,"e":83},{"w":"light?","s":83,"e":83.34}]},{"id":"s07","start":84.34,"end":96.95,"sentences":[{"text":"No.","start":84.69,"end":85.05},{"text":"Plastic is an insulator, so the loop is still open.","start":85.5,"end":88.96},{"text":"Strip the end, and the copper closes it.","start":89.41,"end":92.28},{"text":"That's why wires are copper inside plastic.","start":92.73,"end":96.25}],"words":[{"w":"No.","s":84.69,"e":84.93},{"w":"Plastic","s":85.5,"e":86.08},{"w":"is","s":86.08,"e":86.38},{"w":"an","s":86.38,"e":86.5},{"w":"insulator,","s":86.5,"e":87.18},{"w":"so","s":87.54,"e":87.68},{"w":"the","s":87.68,"e":87.82},{"w":"loop","s":87.82,"e":88.06},{"w":"is","s":88.06,"e":88.28},{"w":"still","s":88.28,"e":88.48},{"w":"open.","s":88.48,"e":88.82},{"w":"Strip","s":89.41,"e":89.75},{"w":"the","s":89.75,"e":89.91},{"w":"end,","s":89.91,"e":90.27},{"w":"and","s":90.53,"e":90.73},{"w":"the","s":90.73,"e":90.97},{"w":"copper","s":90.97,"e":91.35},{"w":"closes","s":91.35,"e":91.91},{"w":"it.","s":91.91,"e":92.15},{"w":"That's","s":92.73,"e":93.23},{"w":"why","s":93.23,"e":93.39},{"w":"wires","s":93.39,"e":93.87},{"w":"are","s":93.87,"e":94.27},{"w":"copper","s":94.27,"e":94.73},{"w":"inside","s":94.73,"e":95.35},{"w":"plastic.","s":95.35,"e":95.83}]},{"id":"s08","start":96.95,"end":110.91,"sentences":[{"text":"Now swap the bulb for an LED, the light in phone screens and solar lamps.","start":97.3,"end":103.35},{"text":"It works only one way round: long leg to plus.","start":103.8,"end":107.77},{"text":"Backwards, it stays dark.","start":108.22,"end":110.21}],"words":[{"w":"Now","s":97.3,"e":97.66},{"w":"swap","s":97.66,"e":98.12},{"w":"the","s":98.12,"e":98.4},{"w":"bulb","s":98.4,"e":98.7},{"w":"for","s":98.7,"e":99.02},{"w":"an","s":99.02,"e":99.16},{"w":"LED,","s":99.16,"e":99.5},{"w":"the","s":99.5,"e":100.36},{"w":"light","s":100.36,"e":100.6},{"w":"in","s":100.6,"e":100.86},{"w":"phone","s":100.86,"e":101.2},{"w":"screens","s":101.2,"e":