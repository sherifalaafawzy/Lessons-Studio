{"version":"0.1","lang":"en","source":"aligned","duration":226.72,"scenes":[{"id":"s01","start":0,"end":14.53,"sentences":[{"text":"Yesterday, one of you asked me a big question.","start":0.35,"end":4.19},{"text":"“Will AI take my mum’s job?”","start":4.64,"end":7.12},{"text":"She’s a nurse.","start":7.57,"end":9.08},{"text":"Let’s find an honest answer: no hype, and no fear.","start":9.53,"end":13.83}],"words":[{"w":"Yesterday,","s":0.35,"e":0.87},{"w":"one","s":1.35,"e":1.75},{"w":"of","s":1.75,"e":1.91},{"w":"you","s":1.91,"e":2.11},{"w":"asked","s":2.11,"e":2.45},{"w":"me","s":2.45,"e":2.75},{"w":"a","s":2.75,"e":3.13},{"w":"big","s":3.13,"e":3.47},{"w":"question.","s":3.47,"e":3.97},{"w":"“Will","s":4.64,"e":4.98},{"w":"AI","s":4.98,"e":5.44},{"w":"take","s":5.44,"e":6.04},{"w":"my","s":6.04,"e":6.26},{"w":"mum’s","s":6.26,"e":6.7},{"w":"job?”","s":6.7,"e":6.94},{"w":"She’s","s":7.57,"e":8.27},{"w":"a","s":8.27,"e":8.41},{"w":"nurse.","s":8.41,"e":8.69},{"w":"Let’s","s":9.53,"e":9.89},{"w":"find","s":9.89,"e":10.11},{"w":"an","s":10.11,"e":10.37},{"w":"honest","s":10.37,"e":10.87},{"w":"answer:","s":10.87,"e":11.41},{"w":"no","s":12.01,"e":12.19},{"w":"hype,","s":12.19,"e":12.63},{"w":"and","s":12.93,"e":13.19},{"w":"no","s":13.19,"e":13.39},{"w":"fear.","s":13.39,"e":13.65}]},{"id":"s02","start":14.53,"end":22.21,"sentences":[{"text":"Today: how AI changes work, the new work it creates, and skills worth building.","start":14.88,"end":21.51}],"words":[{"w":"Today:","s":14.88,"e":15.12},{"w":"how","s":15.76,"e":16.08},{"w":"AI","s":16.08,"e":16.5},{"w":"changes","s":16.5,"e":17.06},{"w":"work,","s":17.06,"e":17.46},{"w":"the","s":17.46,"e":18.12},{"w":"new","s":18.12,"e":18.42},{"w":"work","s":18.42,"e":18.66},{"w":"it","s":18.66,"e":18.8},{"w":"creates,","s":18.8,"e":19.28},{"w":"and","s":19.66,"e":19.98},{"w":"skills","s":19.98,"e":20.38},{"w":"worth","s":20.38,"e":20.84},{"w":"building.","s":20.84,"e":21.28}]},{"id":"s03","start":22.21,"end":44.52,"sentences"