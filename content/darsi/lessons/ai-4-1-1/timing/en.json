},{"w":"per","s":103.96,"e":104.26},{"w":"group,","s":104.26,"e":104.6},{"w":"and","s":104.82,"e":105.3},{"w":"if","s":105.3,"e":105.56},{"w":"nobody","s":105.56,"e":105.92},{"w":"has","s":105.92,"e":106.26},{"w":"them,","s":106.26,"e":106.52},{"w":"make","s":106.9,"e":107.08},{"w":"them","s":107.08,"e":107.26},{"w":"yourself.","s":107.26,"e":107.44}]},{"id":"s09","start":108.47,"end":128.82,"sentences":[{"text":"Before any pilot, ask the supplier.","start":108.82,"end":111.75},{"text":"Whose data trained it, in which languages?","start":112.2,"end":115.28},{"text":"Who was it tested on, with what results per group?","start":115.73,"end":118.81},{"text":"Where do pupils’ recordings go?","start":119.26,"end":121.59},{"text":"Does it work offline, on cheap phones?","start":122.04,"end":124.73},{"text":"And what will it cost after the free year?","start":125.18,"end":128.12}],"words":[{"w":"Before","s":108.82,"e":109.26},{"w":"any","s":109.26,"e":109.78},{"w":"pilot,","s":109.78,"e":110.28},{"w":"ask","s":110.56,"e":110.92},{"w":"the","s":110.92,"e":111.14},{"w":"supplier.","s":111.14,"e":111.44},{"w":"Whose","s":112.2,"e":112.54},{"w":"data","s":112.54,"e":112.92},{"w":"trained","s":112.92,"e":113.44},{"w":"it,","s":113.44,"e":113.6},{"w":"in","s":114.02,"e":114.2},{"w":"which","s":114.2,"e":114.46},{"w":"languages?","s":114.46,"e":114.92},{"w":"Who","s":115.73,"e":115.95},{"w":"was","s":115.95,"e":116.13},{"w":"it","s":116.13,"e":116.25},{"w":"tested","s":116.25,"e":116.61},{"w":"on,","s":116.61,"e":116.89},{"w":"with","s":117.27,"e":117.55},{"w":"what","s":117.55,"e":117.81},{"w":"results","s":117.81,"e":118.19},{"w":"per","s":118.19,"e":118.49},{"w":"group?","s":118.49,"e":118.73},{"w":"Where","s":119.26,"e":119.76},{"w":"do","s":119.76,"e":120.06},{"w":"pupils’","s":120.06,"e":121.1},{"w":"recordings","s":121.1,"e":121.1},{"w":"go?","s":121.1,"e":121.36},{"w":"Does","s":122.04,"e":122.22},{"w":"it","s":122.22,"e":122.36},{"w":"work","s":122.36,"e":122.56},{"w":"of