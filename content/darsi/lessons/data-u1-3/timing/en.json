":69.12},{"w":"of","s":69.12,"e":69.24},{"w":"the","s":69.24,"e":69.34},{"w":"two","s":69.34,"e":69.5},{"w":"transactions.","s":69.5,"e":70.06},{"w":"Either","s":70.86,"e":71.14},{"w":"way,","s":71.14,"e":71.46},{"w":"exactly","s":71.8,"e":72.2},{"w":"one","s":72.2,"e":72.66},{"w":"student","s":72.66,"e":73.22},{"w":"is","s":73.22,"e":73.6},{"w":"enrolled.","s":73.6,"e":73.88}]},{"id":"s06","start":74.82,"end":91.16,"sentences":[{"text":"Databases offer weaker isolation levels for speed, such as read committed and snapshot isolation.","start":75.17,"end":82.38},{"text":"Each permits some anomalies.","start":82.83,"end":85.29},{"text":"Only serializable behaves as if transactions ran one at a time.","start":85.74,"end":90.46}],"words":[{"w":"Databases","s":75.17,"e":75.85},{"w":"offer","s":75.85,"e":76.25},{"w":"weaker","s":76.25,"e":76.73},{"w":"isolation","s":76.73,"e":77.35},{"w":"levels","s":77.35,"e":77.87},{"w":"for","s":77.87,"e":78.13},{"w":"speed,","s":78.13,"e":78.55},{"w":"such","s":78.99,"e":79.25},{"w":"as","s":79.25,"e":79.51},{"w":"read","s":79.51,"e":79.85},{"w":"committed","s":79.85,"e":80.23},{"w":"and","s":80.23,"e":80.87},{"w":"snapshot","s":80.87,"e":81.43},{"w":"isolation.","s":81.43,"e":81.99},{"w":"Each","s":82.83,"e":83.13},{"w":"permits","s":83.13,"e":83.69},{"w":"some","s":83.69,"e":84.23},{"w":"anomalies.","s":84.23,"e":85.01},{"w":"Only","s":85.74,"e":86.14},{"w":"serializable","s":86.14,"e":87.16},{"w":"behaves","s":87.16,"e":87.66},{"w":"as","s":87.66,"e":88.08},{"w":"if","s":88.08,"e":88.2},{"w":"transactions","s":88.2,"e":88.9},{"w":"ran","s":88.9,"e":89.34},{"w":"one","s":89.34,"e":89.76},{"w":"at","s":89.76,"e":89.98},{"w":"a","s":89.98,"e":90.08},{"w":"time.","s":90.08,"e":90.32}]},{"id":"s07","start":91.16,"end":110.69,"sentences":[{"text":"When data is replicated and the network splits, a system must choose.","start":91.51,"end":96.75},{"text":"It can stay available and risk inconsistent answers, or stay consistent and refuse som