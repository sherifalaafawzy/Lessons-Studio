tion","s":19.61,"e":20.21},{"w":"levels","s":20.21,"e":20.65},{"w":"allow","s":20.65,"e":21.19},{"w":"or","s":21.19,"e":21.71},{"w":"prevent","s":21.71,"e":22.15},{"w":"anomalies,","s":22.15,"e":22.93},{"w":"and","s":23.23,"e":23.63},{"w":"what","s":23.63,"e":23.85},{"w":"changes","s":23.85,"e":24.29},{"w":"when","s":24.29,"e":24.69},{"w":"data","s":24.69,"e":24.95},{"w":"lives","s":24.95,"e":25.33},{"w":"on","s":25.33,"e":25.61},{"w":"many","s":25.61,"e":25.99},{"w":"machines.","s":25.99,"e":26.39}]},{"id":"s03","start":27.44,"end":44.63,"sentences":[{"text":"A transaction groups operations so they behave as one unit.","start":27.79,"end":32.31},{"text":"ACID names its guarantees: atomicity, consistency, isolation and durability.","start":32.76,"end":40.28},{"text":"Either everything commits, or nothing does.","start":40.73,"end":43.93}],"words":[{"w":"A","s":27.79,"e":27.91},{"w":"transaction","s":27.91,"e":28.67},{"w":"groups","s":28.67,"e":29.21},{"w":"operations","s":29.21,"e":30.03},{"w":"so","s":30.03,"e":30.55},{"w":"they","s":30.55,"e":30.69},{"w":"behave","s":30.69,"e":31.03},{"w":"as","s":31.03,"e":31.37},{"w":"one","s":31.37,"e":31.67},{"w":"unit.","s":31.67,"e":32.05},{"w":"ACID","s":32.76,"e":33.34},{"w":"names","s":33.34,"e":33.82},{"w":"its","s":33.82,"e":34.06},{"w":"guarantees:","s":34.06,"e":34.58},{"w":"atomicity,","s":35.28,"e":36.02},{"w":"consistency,","s":36.5,"e":37.12},{"w":"isolation","s":37.9,"e":38.38},{"w":"and","s":38.38,"e":39.28},{"w":"durability.","s":39.28,"e":39.82},{"w":"Either","s":40.73,"e":41.05},{"w":"everything","s":41.05,"e":41.63},{"w":"commits,","s":41.63,"e":42.27},{"w":"or","s":42.49,"e":42.89},{"w":"nothing","s":42.89,"e":43.33},{"w":"does.","s":43.33,"e":43.67}]},{"id":"s04","start":44.63,"end":58.46,"sentences":[{"text":"Both requests read one seat left.","start":44.98,"end":47.85},{"text":"Both subtract one and write zero.","start":48.3,"end":51.04},{"text":"Without proper isolation, each overwrites the other, and the count never shows minus one.","start":51.49,"end":57.76}],"words":[{"w":"Both","s":44.98,"e":45.24},{"w":"requests","s":45.24,"e":45.7},{"w":"read","s":45.7,"e":46.28},{"w":"one","s":46.28,"e":46.82},{"w":"seat","s":46.82,"e":47.22},{"w":"left.","s":47.22,"e":47.56},{"w":"Both","s":48.3,"e":48.64},{"w":"subtract","s":48.64,"e":49.18},{"w":"one","s":49.18,"e":49.72},{"w":"and","s":49.72,"e":50.28},{"w":"write","s":50.28,"e":50.52},{"w":"zero.","s":50.52,"e":50.8},{"w":"Without","s":51.49,"e":51.89},{"w":"proper","s":51.89,"e":52.37},{"w":"isolation,","s":52.37,"e":53.15},{"w":"each","s":53.63,"e":53.91},{"w":"overwrites","s":53.91,"e":54.59},{"w":"the","s":54.59,"e":54.85},{"w":"other,","s":54.85,"e":55.15},{"w":"and","s":55.55,"e":55.71},{"w":"the","s":55.71,"e":55.79},{"w":"count","s":55.79,"e":56.07},{"w":"never","s":56.07,"e":56.49},{"w":"shows","s":56.49,"e":56.87},{"w":"minus","s":56.87,"e":57.23},{"w":"one.","s":57.23,"e":57.57}]},{"id":"s05","start":58.46,"end":74.82,"sentences":[{"text":"One fix is an atomic conditional update that only succeeds while seats remain.","start":58.81,"end":64.51},{"text":"Another is serializable isolation, which aborts one of the two transactions.","start":64.96,"end":70.41},{"text":"Either way, exactly one student is enrolled.","start":70.86,"end":74.12}],"words":[{"w":"One","s":58.81,"e":59.07},{"w":"fix","s":59.07,"e":59.41},{"w":"is","s":59.41,"e":59.81},{"w":"an","s":59.81,"e":60.05},{"w":"atomic","s":60.05,"e":60.55},{"w":"conditional","s":60.55,"e":61.27},{"w":"update","s":61.27,"e":61.77},{"w":"that","s":61.77,"e":62.43},{"w":"only","s":62.43,"e":62.77},{"w":"succeeds","s":62.77,"e":63.19},{"w":"while","s":63.19,"e":63.73},{"w":"seats","s":63.73,"e":64.03},{"w":"remain.","s":64.03,"e":64.33},{"w":"Another","s":64.96,"e":65.36},{"w":"is","s":65.36,"e":65.9},{"w":"serializable","s":65.9,"e":67},{"w":"isolation,","s":67,"e":67.68},{"w":"which","s":68.1,"e":68.32},{"w":"aborts","s":68.32,"e":68.86},{"w":"one","s":68.86,"e":69.12},{"w":"of","s":69.12,"e":69.24},{"w":"the","s":69.24,"e":69.34},{"w":"two","s":69.34,"e":69.5},{"w":"transactions.","s":69.5,"e":70.06},{"w":"Either","s":70.86,"e":71.14},{"w":"way,","s":71.14,"e":71.46},{"w":"exactly","s":71.8,"e":72.2},{"w":"one","s":72.2,"e":72.66},{"w":"student","s":72.66,"e":73.22},{"w":"is","s":73.22,"e":73.6},{"w":"enrolled.","s":73.6,"e":73.88}]},{"id":"s06","start":74.82,"end":91.16,"sentences":[{"text":"Databases offer weaker isolation levels for speed, such as read committed and snapshot isolation.","start":75.17,"end":82.38},{"text":"Each permits some anomalies.","start":82.83,"end":85.29},{"text":"Only serializable behaves as if transactions ran one at a time.","start":85.74,"end":90.46}],"words":[{"w":"Databases","s":75.17,"e":75.85},{"w":"offer","s":75.85,"e":76.25},{"w":"weaker","s":76.25,"e":76.73},{"w":"isolation","s":76.73,"e":77.35},{"w":"levels","s":77.35,"e":77.87},{"w":"for","s":77.87,"e":78.13},{"w":"speed,","s":78.13,"e":78.55},{"w":"such","s":78.99,"e":79.25},{"w":"as","s":79.25,"e":79.51},{"w":"read","s":79.51,"e":79.85},{"w":"committed","s":79.85,"e":80.23},{"w":"and","s":80.23,"e":80.87},{"w":"snapshot","s":80.87,"e":81.43},{"w":"isolation.","s":81.43,"e":81.99},{"w":"Each","s":82.83,"e":83.13},{"w":"permits","s":83.13,"e":83.69},{"w":"some","s":83.69,"e":84.23},{"w":"anomalies.","s":84.23,"e":85.01},{"w":"Only","s":85.74,"e":86.14},{"w":"serializable","s":86.14,"e":87.16},{"w":"behaves","s":87.16,"e":87.66},{"w":"as","s":87.66,"e":88.08},{"w":"if","s":88.08,"e":88.2},{"w":"transactions","s":88.2,"e":88.9},{"w":"ran","s":88.9,"e":89.34},{"w":"one","s":89.34,"e":89.76},{"w":"at","s":89.76,"e":89.98},{"w":"a","s":89.98,"e":90.08},{"w":"time.","s":90.08,"e":90.32}]},{"id":"s07","start":91.16,"end":110.69,"sentences":[{"text":"When data is replicated and the network splits, a system must choose.","start":91.51,"end":96.75},{"text":"It can stay available and risk inconsistent answers, or stay consistent and refuse som