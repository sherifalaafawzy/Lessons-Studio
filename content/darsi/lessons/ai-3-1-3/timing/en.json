,"e":38.26},{"w":"a","s":38.82,"e":38.98},{"w":"test","s":38.98,"e":39.24},{"w":"set","s":39.24,"e":39.54},{"w":"the","s":39.54,"e":39.7},{"w":"model","s":39.7,"e":39.98},{"w":"never","s":39.98,"e":40.32},{"w":"sees.","s":40.32,"e":40.68},{"w":"The","s":41.39,"e":41.55},{"w":"training","s":41.55,"e":41.89},{"w":"score","s":41.89,"e":42.25},{"w":"shows","s":42.25,"e":42.65},{"w":"how","s":42.65,"e":43.05},{"w":"well","s":43.05,"e":43.39},{"w":"it","s":43.39,"e":43.65},{"w":"fitted","s":43.65,"e":44.01},{"w":"its","s":44.01,"e":44.39},{"w":"own","s":44.39,"e":44.67},{"w":"examples.","s":44.67,"e":45.17},{"w":"The","s":46,"e":46.16},{"w":"test","s":46.16,"e":46.42},{"w":"score","s":46.42,"e":46.68},{"w":"shows","s":46.68,"e":47.06},{"w":"how","s":47.06,"e":47.52},{"w":"it’s","s":47.52,"e":47.78},{"w":"likely","s":47.78,"e":47.94},{"w":"to","s":47.94,"e":48.32},{"w":"do","s":48.32,"e":48.5},{"w":"on","s":48.5,"e":48.76},{"w":"new","s":48.76,"e":49.02},{"w":"pupils.","s":49.02,"e":49.4}]},{"id":"s05","start":50.45,"end":64.21,"sentences":[{"text":"This is overfitting: learning the training examples so closely that the model does worse on new ones.","start":50.8,"end":58.26},{"text":"The warning sign: a high training score, and a much lower test score.","start":58.71,"end":63.51}],"words":[{"w":"This","s":50.8,"e":51.28},{"w":"is","s":51.28,"e":51.66},{"w":"overfitting:","s":51.66,"e":52.52},{"w":"learning","s":52.96,"e":53.3},{"w":"the","s":53.3,"e":53.54},{"w":"training","s":53.54,"e":53.9},{"w":"examples","s":53.9,"e":54.42},{"w":"so","s":54.42,"e":54.88},{"w":"closely","s":54.88,"e":55.34},{"w":"that","s":55.34,"e":56.1},{"w":"the","s":56.1,"e":56.26},{"w":"model","s":56.26,"e":56.62},{"w":"does","s":56.62,"e":56.92},{"w":"worse","s":56.92,"e":57.3},{"w":"on","s":57.3,"e":57.64},{"w":"new","s":57.64,"e":57.86},{"w":"ones.","s":57.86,"e":58.06},{"w":"The","s":58.71,"e":58.89},{"w":"warning","s":58.89,"e":59.19},{"w":"sign:","s":59.19,"e":59.57},{"w":"a","s":60.11,"e":6