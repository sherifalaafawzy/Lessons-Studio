{"version":"0.1","lang":"en","source":"aligned","duration":192.22,"scenes":[{"id":"s01","start":0,"end":20.09,"sentences":[{"text":"Our new classroom sensor said it was eighty-five degrees at seven in the morning.","start":0.35,"end":7.41},{"text":"The head teacher nearly sent everyone home.","start":7.86,"end":11.31},{"text":"One wrong number almost decided our day.","start":11.76,"end":15.85},{"text":"Today: data you can trust.","start":16.3,"end":19.39}],"words":[{"w":"Our","s":0.35,"e":0.65},{"w":"new","s":0.65,"e":1.09},{"w":"classroom","s":1.09,"e":1.79},{"w":"sensor","s":1.79,"e":2.43},{"w":"said","s":2.43,"e":3.07},{"w":"it","s":3.07,"e":3.23},{"w":"was","s":3.23,"e":3.47},{"w":"eighty-five","s":3.47,"e":4.61},{"w":"degrees","s":4.61,"e":5.31},{"w":"at","s":5.31,"e":6.05},{"w":"seven","s":6.05,"e":6.45},{"w":"in","s":6.45,"e":6.83},{"w":"the","s":6.83,"e":6.93},{"w":"morning.","s":6.93,"e":7.21},{"w":"The","s":7.86,"e":8.02},{"w":"head","s":8.02,"e":8.32},{"w":"teacher","s":8.32,"e":8.92},{"w":"nearly","s":8.92,"e":9.48},{"w":"sent","s":9.48,"e":10},{"w":"everyone","s":10,"e":10.66},{"w":"home.","s":10.66,"e":11.12},{"w":"One","s":11.76,"e":12.26},{"w":"wrong","s":12.26,"e":12.72},{"w":"number","s":12.72,"e":13.26},{"w":"almost","s":13.26,"e":14.04},{"w":"decided","s":14.04,"e":15},{"w":"our","s":15,"e":15.32},{"w":"day.","s":15.32,"e":15.6},{"w":"Today:","s":16.3,"e":16.76},{"w":"data","s":17.38,"e":17.92},{"w":"you","s":17.92,"e":18.46},{"w":"can","s":18.46,"e":18.68},{"w":"trust.","s":18.68,"e":19.26}]},{"id":"s02","start":20.09,"end":23.95,"sentences":[{"text":"Today: logging data you can trust.","start":20.44,"end":23.25}],"words":[{"w":"Today:","s":20.44,"e":20.74},{"w":"logging","s":21.12,"e":21.56},{"w":"data","s":21.56,"e":22},{"w":"you","s":22,"e":22.46},{"w":"can","s":22.46,"e":22.66},{"w":"trust.","s":22.66,"e":23.14}]},{"id":"s03","start":23.95,"end":38.23,"sentences":[{"text":"Start with a question, not a sensor.","start":24.3,"end":26.89},{"te