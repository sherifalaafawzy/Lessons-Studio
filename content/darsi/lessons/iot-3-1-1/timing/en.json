t","s":65.65,"e":65.97},{"w":"for","s":65.97,"e":66.25},{"w":"it.","s":66.25,"e":66.39},{"w":"If","s":66.86,"e":67},{"w":"it","s":67,"e":67.12},{"w":"wanders","s":67.12,"e":67.62},{"w":"up","s":67.62,"e":67.86},{"w":"and","s":67.86,"e":68.02},{"w":"down,","s":68.02,"e":68.34},{"w":"don't","s":68.76,"e":69.06},{"w":"use","s":69.06,"e":69.3},{"w":"it.","s":69.3,"e":69.48}]},{"id":"s06","start":70.34,"end":86.66,"sentences":[{"text":"Here's a day from our log.","start":70.69,"end":72.22},{"text":"It climbs from twenty-six degrees to thirty-two after lunch.","start":72.67,"end":76.32},{"text":"But at seven o'clock: eighty-five.","start":76.77,"end":79.69},{"text":"A popular sensor reads exactly that just after it powers up: a classic glitch.","start":80.14,"end":85.96}],"words":[{"w":"Here's","s":70.69,"e":71.09},{"w":"a","s":71.09,"e":71.17},{"w":"day","s":71.17,"e":71.35},{"w":"from","s":71.35,"e":71.59},{"w":"our","s":71.59,"e":71.73},{"w":"log.","s":71.73,"e":71.99},{"w":"It","s":72.67,"e":72.79},{"w":"climbs","s":72.79,"e":73.09},{"w":"from","s":73.09,"e":73.45},{"w":"twenty-six","s":73.45,"e":74.11},{"w":"degrees","s":74.11,"e":74.39},{"w":"to","s":74.39,"e":74.99},{"w":"thirty-two","s":74.99,"e":75.55},{"w":"after","s":75.55,"e":75.81},{"w":"lunch.","s":75.81,"e":76.05},{"w":"But","s":76.77,"e":77.19},{"w":"at","s":77.19,"e":77.37},{"w":"seven","s":77.37,"e":77.75},{"w":"o'clock:","s":77.75,"e":78.33},{"w":"eighty-five.","s":78.59,"e":79.41},{"w":"A","s":80.14,"e":80.28},{"w":"popular","s":80.28,"e":80.64},{"w":"sensor","s":80.64,"e":81.14},{"w":"reads","s":81.14,"e":81.62},{"w":"exactly","s":81.62,"e":82.14},{"w":"that","s":82.14,"e":82.86},{"w":"just","s":82.86,"e":83.28},{"w":"after","s":83.28,"e":83.68},{"w":"it","s":83.68,"e":83.88},{"w":"powers","s":83.88,"e":84.16},{"w":"up:","s":84.16,"e":84.5},{"w":"a","s":84.96,"e":85.06},{"w":"classic","s":85.06,"e":85.4},{"w":"glitch.","s":85.4,"e":85.7}]},{"id":"s07","start":86.66,"end":93.68,"sentences":[{"text":"Quick check!","start":87.01,"end":87.58},{"text":"We know the eighty-five is a glitch.","start":88.03,"end":90.87},{"text":"What should we do with it?","start":91.32,"end":92.98}],"words":[{"w":"Quick","s":87.01,"e":87.17},{"w":"check!","s":87.17,"e":87.41},{"w":"We","s":88.03,"e":88.53},{"w":"know","s":88.53,"e":88.85},{"w":"the","s":88.85,"e":89.05},{"w":"eighty-five","s":89.05,"e":89.75},{"w":"is","s":89.75,"e":89.99},{"w":"a","s":89.99,"e":90.09},{"w":"glitch.","s":90.09,"e":90.41},{"w":"What","s":91.32,"e":91.58},{"w":"should","s":91.58,"e":91.84},{"w":"we","s":91.84,"e":92.02},{"w":"do","s":92.02,"e":92.32},{"w":"with","s":92.32,"e":92.6},{"w":"it?","s":92.6,"e":92.76}]},{"id":"s08","start":93.68,"end":108.31,"sentences":[{"text":"Leave it out, and write down why.","start":94.03,"end":96.24},{"text":"Keep the raw log exactly as it was, and note what you removed: seven o'clock, eighty-five, sensor just powered up.","start":96.69,"end":105.22},{"text":"Then anyone can check your cleaning.","start":105.67,"end":107.61}],"words":[{"w":"Leave","s":94.03,"e":94.23},{"w":"it","s":94.23,"e":94.41},{"w":"out,","s":94.41,"e":94.61},{"w":"and","s":95.01,"e":95.19},{"w":"write","s":95.19,"e":95.51},{"w":"down","s":95.51,"e":95.79},{"w":"why.","s":95.79,"e":96.07},{"w":"Keep","s":96.69,"e":96.91},{"w":"the","s":96.91,"e":97.15},{"w":"raw","s":97.15,"e":97.45},{"w":"log","s":97.45,"e":97.89},{"w":"exactly","s":97.89,"e":98.59},{"w":"as","s":98.59,"e":99.05},{"w":"it","s":99.05,"e":99.17},{"w":"was,","s":99.17,"e":99.41},{"w":"and","s":100.01,"e":100.11},{"w":"note","s":100.11,"e":100.35},{"w":"what","s":100.35,"e":100.47},{"w":"you","s":100.47,"e":100.59},{"w":"removed:","s":100.59,"e":100.93},{"w":"seven","s":101.73,"e":101.95},{"w":"o'clock,","s":101.95,"e":102.41},{"w":"eighty-five,","s":102.89,"e":103.51},{"w":"sensor","s":104.05,"e":104.25},{"w":"just","s":104.25,"e":104.57},{"w":"powered","s":104.57,"e":104.87},{"w":"up.","s":104.87,"e":105.11},{"w":"Then","s":105.67,"e