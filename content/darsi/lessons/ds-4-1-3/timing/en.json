{"version":"0.1","lang":"en","source":"aligned","duration":149.26,"scenes":[{"id":"s01","start":0,"end":14.47,"sentences":[{"text":"We tried an app that listens to pupils read aloud and scores them.","start":0.35,"end":5.29},{"text":"Overall it was right nine times in ten.","start":5.74,"end":9.22},{"text":"But pupils from the village were marked down far more often.","start":9.67,"end":13.77}],"words":[{"w":"We","s":0.35,"e":0.83},{"w":"tried","s":0.83,"e":1.19},{"w":"an","s":1.19,"e":1.37},{"w":"app","s":1.37,"e":1.69},{"w":"that","s":1.69,"e":2.09},{"w":"listens","s":2.09,"e":2.45},{"w":"to","s":2.45,"e":2.85},{"w":"pupils","s":2.85,"e":3.23},{"w":"read","s":3.23,"e":3.69},{"w":"aloud","s":3.69,"e":4.07},{"w":"and","s":4.07,"e":4.55},{"w":"scores","s":4.55,"e":4.91},{"w":"them.","s":4.91,"e":5.15},{"w":"Overall","s":5.74,"e":6.3},{"w":"it","s":6.3,"e":6.84},{"w":"was","s":6.84,"e":7.14},{"w":"right","s":7.14,"e":7.54},{"w":"nine","s":7.54,"e":8.14},{"w":"times","s":8.14,"e":8.66},{"w":"in","s":8.66,"e":8.88},{"w":"ten.","s":8.88,"e":9.04},{"w":"But","s":9.67,"e":10.03},{"w":"pupils","s":10.03,"e":10.53},{"w":"from","s":10.53,"e":10.89},{"w":"the","s":10.89,"e":11.03},{"w":"village","s":11.03,"e":11.49},{"w":"were","s":11.49,"e":11.87},{"w":"marked","s":11.87,"e":12.25},{"w":"down","s":12.25,"e":12.51},{"w":"far","s":12.51,"e":13.03},{"w":"more","s":13.03,"e":13.27},{"w":"often.","s":13.27,"e":13.59}]},{"id":"s02","start":14.47,"end":21.14,"sentences":[{"text":"Today: how a model can be good on average and still unfair to some pupils.","start":14.82,"end":20.44}],"words":[{"w":"Today:","s":14.82,"e":15.08},{"w":"how","s":15.58,"e":15.88},{"w":"a","s":15.88,"e":16},{"w":"model","s":16,"e":16.36},{"w":"can","s":16.36,"e":16.64},{"w":"be","s":16.64,"e":16.8},{"w":"good","s":16.8,"e":17.06},{"w":"on","s":17.06,"e":17.3},{"w":"average","s":17.3,"e":17.8},{"w":"and","s":17.8,"e":18.42},{"w":"still","s":18.42,"e":18.8},{"w":"unfair","s":18.8,"e":19.24},{"w":"to","s":19.2