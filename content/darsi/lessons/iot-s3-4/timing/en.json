Wi-Fi","s":60.07,"e":60.67},{"w":"send","s":60.67,"e":61.09},{"w":"uses","s":61.09,"e":61.65},{"w":"as","s":61.65,"e":61.99},{"w":"much","s":61.99,"e":62.23},{"w":"as","s":62.23,"e":62.45},{"w":"nearly","s":62.45,"e":62.75},{"w":"seven","s":62.75,"e":63.25},{"w":"hours","s":63.25,"e":63.83},{"w":"of","s":63.83,"e":64.13},{"w":"sleep!","s":64.13,"e":64.43}]},{"id":"s05","start":65.37,"end":78.59,"sentences":[{"text":"Quick check!","start":65.72,"end":66.39},{"text":"A sensor sends every ten seconds, and its batteries last four days.","start":66.84,"end":72.37},{"text":"What makes the biggest difference: sending less often, or sleeping more deeply?","start":72.82,"end":77.89}],"words":[{"w":"Quick","s":65.72,"e":65.92},{"w":"check!","s":65.92,"e":66.2},{"w":"A","s":66.84,"e":66.98},{"w":"sensor","s":66.98,"e":67.32},{"w":"sends","s":67.32,"e":67.76},{"w":"every","s":67.76,"e":68.36},{"w":"ten","s":68.36,"e":68.74},{"w":"seconds,","s":68.74,"e":69.18},{"w":"and","s":69.72,"e":70.14},{"w":"its","s":70.14,"e":70.28},{"w":"batteries","s":70.28,"e":70.78},{"w":"last","s":70.78,"e":71.24},{"w":"four","s":71.24,"e":71.74},{"w":"days.","s":71.74,"e":72.1},{"w":"What","s":72.82,"e":73.06},{"w":"makes","s":73.06,"e":73.28},{"w":"the","s":73.28,"e":73.5},{"w":"biggest","s":73.5,"e":73.78},{"w":"difference:","s":73.78,"e":74.26},{"w":"sending","s":74.96,"e":75.32},{"w":"less","s":75.32,"e":75.68},{"w":"often,","s":75.68,"e":76.16},{"w":"or","s":76.5,"e":76.6},{"w":"sleeping","s":76.6,"e":77.02},{"w":"more","s":77.02,"e":77.38},{"w":"deeply?","s":77.38,"e":77.66}]},{"id":"s06","start":78.59,"end":92.05,"sentences":[{"text":"Send less often.","start":78.94,"end":80.35},{"text":"Every ten seconds, the radio takes almost all the energy.","start":80.8,"end":84.94},{"text":"Send once an hour instead, and the same two batteries can last more than three years.","start":85.39,"end":91.35}],"words":[{"w":"Send","s":78.94,"e":79.32},{"w":"less","s":79.32,"e":79.7},{"w":"often.","s":79.7,"e"