{"version":"0.1","lang":"en","source":"aligned","duration":195.13,"scenes":[{"id":"s01","start":0,"end":18.76,"sentences":[{"text":"Our garden sensor sent a reading over Wi-Fi every ten seconds, so we could watch it live.","start":0.35,"end":6.74},{"text":"It was exciting, for four days.","start":7.19,"end":10.09},{"text":"Then two brand-new batteries were flat.","start":10.54,"end":13.98},{"text":"Today, you'll learn to make them last for years.","start":14.43,"end":18.06}],"words":[{"w":"Our","s":0.35,"e":0.79},{"w":"garden","s":0.79,"e":1.19},{"w":"sensor","s":1.19,"e":1.77},{"w":"sent","s":1.77,"e":2.19},{"w":"a","s":2.19,"e":2.37},{"w":"reading","s":2.37,"e":2.73},{"w":"over","s":2.73,"e":2.95},{"w":"Wi-Fi","s":2.95,"e":3.57},{"w":"every","s":3.57,"e":4.13},{"w":"ten","s":4.13,"e":4.51},{"w":"seconds,","s":4.51,"e":4.91},{"w":"so","s":5.39,"e":5.51},{"w":"we","s":5.51,"e":5.65},{"w":"could","s":5.65,"e":5.79},{"w":"watch","s":5.79,"e":6.07},{"w":"it","s":6.07,"e":6.19},{"w":"live.","s":6.19,"e":6.47},{"w":"It","s":7.19,"e":7.41},{"w":"was","s":7.41,"e":7.65},{"w":"exciting,","s":7.65,"e":8.37},{"w":"for","s":8.75,"e":9.07},{"w":"four","s":9.07,"e":9.41},{"w":"days.","s":9.41,"e":9.73},{"w":"Then","s":10.54,"e":10.78},{"w":"two","s":10.78,"e":11.46},{"w":"brand-new","s":11.46,"e":12.34},{"w":"batteries","s":12.34,"e":12.86},{"w":"were","s":12.86,"e":13.24},{"w":"flat.","s":13.24,"e":13.62},{"w":"Today,","s":14.43,"e":15.05},{"w":"you'll","s":15.41,"e":15.63},{"w":"learn","s":15.63,"e":15.89},{"w":"to","s":15.89,"e":16.07},{"w":"make","s":16.07,"e":16.29},{"w":"them","s":16.29,"e":16.53},{"w":"last","s":16.53,"e":16.83},{"w":"for","s":16.83,"e":17.19},{"w":"years.","s":17.19,"e":17.59}]},{"id":"s02","start":18.76,"end":25.76,"sentences":[{"text":"Today: power from batteries and the sun, and why the radio eats the battery.","start":19.11,"end":25.06}],"words":[{"w":"Today:","s":19.11,"e":19.43},{"w":"power","s":19.95,"e":20.37},{"w":"from","s":20.37,"e":20.71},{"w