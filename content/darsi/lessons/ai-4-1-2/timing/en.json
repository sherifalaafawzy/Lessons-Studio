,"e":127.35},{"w":"and","s":127.35,"e":128.15},{"w":"works","s":128.15,"e":128.43},{"w":"for","s":128.43,"e":128.73},{"w":"every","s":128.73,"e":129.15},{"w":"pupil.","s":129.15,"e":129.57}]},{"id":"s10","start":130.46,"end":154.95,"sentences":[{"text":"Choosing a reading app, for example?","start":130.81,"end":132.81},{"text":"Use a weighted decision matrix, in the open.","start":133.26,"end":136.09},{"text":"First the committee agrees the criteria, like learning, privacy, offline use and cost, and their weights.","start":136.54,"end":145.05},{"text":"Then score each app, multiply by the weights and add up.","start":145.5,"end":149.73},{"text":"Publish the scores, so everyone sees why one app won.","start":150.18,"end":154.25}],"words":[{"w":"Choosing","s":130.81,"e":131.21},{"w":"a","s":131.21,"e":131.33},{"w":"reading","s":131.33,"e":131.59},{"w":"app,","s":131.59,"e":131.97},{"w":"for","s":132.13,"e":132.21},{"w":"example?","s":132.21,"e":132.55},{"w":"Use","s":133.26,"e":133.54},{"w":"a","s":133.54,"e":133.82},{"w":"weighted","s":133.82,"e":134.16},{"w":"decision","s":134.16,"e":134.66},{"w":"matrix,","s":134.66,"e":135.24},{"w":"in","s":135.46,"e":135.64},{"w":"the","s":135.64,"e":135.74},{"w":"open.","s":135.74,"e":135.92},{"w":"First","s":136.54,"e":136.9},{"w":"the","s":136.9,"e":137.38},{"w":"committee","s":137.38,"e":137.68},{"w":"agrees","s":137.68,"e":138.22},{"w":"the","s":138.22,"e":138.5},{"w":"criteria,","s":138.5,"e":139.04},{"w":"like","s":139.62,"e":139.84},{"w":"learning,","s":139.84,"e":140.42},{"w":"privacy,","s":140.92,"e":141.34},{"w":"offline","s":141.96,"e":142.3},{"w":"use","s":142.3,"e":142.7},{"w":"and","s":142.7,"e":143.06},{"w":"cost,","s":143.06,"e":143.46},{"w":"and","s":144.04,"e":144.28},{"w":"their","s":144.28,"e":144.48},{"w":"weights.","s":144.48,"e":144.7},{"w":"Then","s":145.5,"e":145.8},{"w":"score","s":145.8,"e":146.32},{"w":"each","s":146.32,"e":146.68},{"w":"app,","s":146.68,"e":146.98},{"w":"multiply","s":147.4,"e":147.8