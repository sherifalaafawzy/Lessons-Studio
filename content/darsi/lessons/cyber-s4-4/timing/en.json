 data is treated fairly, and trainers teach everyone to spot tricks.","start":74.56,"end":81.92}],"words":[{"w":"There’s","s":61.35,"e":61.71},{"w":"more.","s":61.71,"e":61.89},{"w":"Forensic","s":62.62,"e":63.28},{"w":"investigators","s":63.28,"e":63.94},{"w":"work","s":63.94,"e":64.42},{"w":"out","s":64.42,"e":64.66},{"w":"what","s":64.66,"e":64.84},{"w":"happened","s":64.84,"e":65.28},{"w":"after","s":65.28,"e":65.82},{"w":"an","s":65.82,"e":66.12},{"w":"attack,","s":66.12,"e":66.5},{"w":"and","s":67.16,"e":67.24},{"w":"incident","s":67.24,"e":67.8},{"w":"responders","s":67.8,"e":68.48},{"w":"lead","s":68.48,"e":68.82},{"w":"the","s":68.82,"e":68.98},{"w":"clean-up.","s":68.98,"e":69.4},{"w":"Cryptographers","s":69.95,"e":70.91},{"w":"design","s":70.91,"e":71.53},{"w":"the","s":71.53,"e":71.83},{"w":"maths","s":71.83,"e":72.33},{"w":"behind","s":72.33,"e":72.75},{"w":"locks","s":72.75,"e":73.27},{"w":"and","s":73.27,"e":73.57},{"w":"keys.","s":73.57,"e":73.85},{"w":"Privacy","s":74.56,"e":75.08},{"w":"officers","s":75.08,"e":75.5},{"w":"make","s":75.5,"e":75.9},{"w":"sure","s":75.9,"e":76.24},{"w":"people’s","s":76.24,"e":76.8},{"w":"data","s":76.8,"e":77.06},{"w":"is","s":77.06,"e":77.44},{"w":"treated","s":77.44,"e":77.8},{"w":"fairly,","s":77.8,"e":78.3},{"w":"and","s":78.64,"e":79.1},{"w":"trainers","s":79.1,"e":79.76},{"w":"teach","s":79.76,"e":80.12},{"w":"everyone","s":80.12,"e":80.54},{"w":"to","s":80.54,"e":80.84},{"w":"spot","s":80.84,"e":81.14},{"w":"tricks.","s":81.14,"e":81.76}]},{"id":"s06","start":82.62,"end":99.32,"sentences":[{"text":"One rule matters above all.","start":82.97,"end":85.31},{"text":"Getting into a system without permission is a crime in almost every country, even “just to look”.","start":85.76,"end":92.47},{"text":"Real defenders get written permission first, and stop exactly where it ends.","start":92.92,"end":98.62}],"words":[{"w":"One","s":82.97,"e":83.29},{"w":"rule","s":83.29,"e":83.69},{"w":"matters","s":83.69,"e":84.23},{"w