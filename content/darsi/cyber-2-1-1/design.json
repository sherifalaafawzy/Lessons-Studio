        { "icon": "pencil", "text": { "en": "Read out six short situations", "ar-EG": "اقرا ست مواقف قصيرة" }, "s": 0 },
        { "icon": "flag", "text": { "en": "Green card: safe. Red card: risky.", "ar-EG": "كارت أخضر: أمان. أحمر: خطر." }, "s": 1 },
