        { "text": { "en": "Automatic updates: system and apps", "ar-EG": "تحديث تلقائي: النظام والتطبيقات" }, "s": 0 },
        { "text": { "en": "At night, charging, on Wi-Fi", "ar-EG": "بالليل، على الشاحن والواي فاي" }, "s": 1 },
        { "text": { "en": "Restart when it asks", "ar-EG": "أعد التشغيل لما يطلب" }, "s": 2 }
      ]
    },
