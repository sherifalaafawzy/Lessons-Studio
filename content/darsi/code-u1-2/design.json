    "4": {
      "who": null,
      "code": {
        "text": "fact(3)\n  3 × fact(2)\n      2 × fact(1)\n          1 × fact(0)\n              return 1\n          → 1\n      → 2\n  → 6",
        "s": 1
      }
    },
    "5": {
      "who": null,
      "code": {
        "text": "def fact(n):\n    if n == 1:        # fact(0) never stops\n        return 1\n    return n * fact(n - 1)\n\n# fix: if n <= 0: return 1",
        "s": 1
      }
    },
    "6": {
      "who": null,
      "code": {
        "text": "Base:  fact(0) = 1 = 0!\nStep:  assume fact(k) = k!\n       fact(k+1) = (k+1) × fact(k)\n                 = (k+1) × k! = (k+1)!",
        "s": 1
      }
    },
