          "s": 1
        },
        {
          "icon": "mapPin",
          "text": {
            "en": "The place, inside the file",
            "ar-EG": "المكان جوّه الملف"
          },
          "s": 1,
          "tone": "danger"
        },
        {
          "icon": "settings",
          "text": {
            "en": "Camera location: off",
            "ar-EG": "موقع الكاميرا: مقفول"
          },
          "s": 2,
          "tone": "ok"
        }
      ]
    },
    "12": {
      "points": [
        {
          "text": {
            "en": "Does it need it?",
            "ar-EG": "محتاجه ولا لأ؟"
          },
          "s": 1
        },
        {
          "text": {
            "en": "Only while using",
            "ar-EG": "أثناء الاستخدام بس"
          },
          "s": 1
        },
        {
          "text": {
            "en": "Family, for a set time",
            "ar-EG": "أهلك، لوقت محدد"
          },
          "s": 1
        },
        {
          "text": {
            "en": "Check your photos",
            "ar-EG": "راجع صورك"
          },
          "s": 1
        }
      ],
      "takeaway": {
        "en": "Your location is yours: share it on purpose.",
        "ar-EG": "مكانك ملكك: شيّره وإنت قاصد."
