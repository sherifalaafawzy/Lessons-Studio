            "ar-EG": "حط وقت: ساعة مثلًا"
          },
          "s": 2
        },
        {
          "text": {
            "en": "Check that it stopped",
            "ar-EG": "اتأكد إنه وقف"
          },
          "s": 3
        }
      ]
