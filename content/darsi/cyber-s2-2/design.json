    "13": {
      "list": [
        {
          "icon": "settings",
          "text": {
            "en": "Open your location settings",
            "ar-EG": "افتح إعدادات الموقع"
          },
          "s": 0
        },
        {
          "icon": "circlex",
          "text": {
            "en": "Off for apps that don't need it",
            "ar-EG": "اقفله للي مش محتاجه"
          },
          "s": 1
        },
        {
          "icon": "users",
          "text": {
            "en": "Family phone? Do it together",
            "ar-EG": "موبايل العيلة؟ اعملها مع صاحبه"
          },
          "s": 2
        }
