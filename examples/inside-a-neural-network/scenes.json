ة"},"note":{"en":"10","ar":"10"}}],"edges":[{"from":"img","to":"c1"},{"from":"c1","to":"p1"},{"from":"p1","to":"c2"},{"from":"c2","to":"p2"},{"from":"p2","to":"fc"},{"from":"fc","to":"out"}],"anim":[{"prop":"reveal","keys":[{"at":0.2,"value":0},{"at":{"word":{"en":"guess","ar":"التخمين"}},"value":1}]},{"prop":"focus","keys":[{"at":{"word":{"en":"convolution","ar":"الالتفاف"}},"value":2,"ease":"step"},{"at":{"word":{"en":"pooling","ar":"التجميع"}},"value":3,"ease":"step"},{"at":{"word":{"en":"guess","ar":"التخمين"}},"value":7,"ease":"step"}]}]}]}},{"id":"transformer","template":"canvas","narration":{"en":"Language models use transformers: attention lets every word look at every other word, and the block repeats many times.","ar":"تستخدم النماذج اللغوية المحوّلات: يتيح الانتباه لكل كلمة أن تنظر إلى كل كلمة أخرى، وتتكرر الكتلة مرات كثيرة."},"content":{"elements":[{"id":"h","type":"text","x":80,"y":56,"w":1120,"size":46,"weight":800,"text":{"en":"A transformer block","ar":"كتلة المحوّل"}},{"id":"tf","x":40,"y":150,"w":1200,"h":470,"type":"arch","blocks":[{"id":"tok","kind":"input","label":{"en":"Tokens","ar":"الرموز"}},{"id":"emb","kind":"embed","label":{"en":"Embedding + position","ar":"التضمين والموضع"}},{"id":"att","kind":"attn","label":{"en":"Multi-head attention","ar":"الانتباه متعدد الرؤوس"}},{"id":"n1","kind":"norm","label":{"en":"Add & norm","ar":"الجمع والتطبيع"}},{"id":"ff","kind":"ffn","label":{"en":"Feed forward","ar":"الشبكة الأمامية"}},{"id":"n2","kind":"norm","label":{"en":"Add & norm","ar":"الجمع والتطبيع"}}],"edges":[{"from":"tok","to":"emb"},{"from":"emb","to":"att"},{"from":"att","to":"n1"},{"from":"n1","to":"ff"},{"from":"ff","to":"n2"},{"from":"emb","to":"n1","skip":true},{"from":"n1","to":"n2","skip":true}],"groups":[{"id":"enc","label":{"en":"Encoder block","ar":"كتلة المُرمِّز"},"repeat":6,"blocks":["att","n1","ff","n2"]}],"anim":[{"prop":"reveal","keys":[{"at":0.2,"value":0},{"at":{"word":{"en":"attention","ar":"الانتباه"}},"value":1}]},{"prop":