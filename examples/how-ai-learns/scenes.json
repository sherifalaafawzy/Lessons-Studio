    {
      "id": "remember",
      "template": "summary",
      "transition": {
        "type": "wipe"
      },
      "narration": {
        "en": "So, an AI model learns by adjusting its weights to make fewer mistakes on examples.",
        "ar": "إذن، يتعلم نموذج الذكاء الاصطناعي بتعديل أوزانه ليخطئ أقل في الأمثلة."
      },
      "content": {
        "title": {
          "en": "Remember",
          "ar": "تذكّر"
        },
        "points": [
          {
            "en": "A model learns from examples, not written rules",
            "ar": "يتعلم النموذج من الأمثلة، لا من قواعد مكتوبة"
          },
          {
            "en": "Learning means adjusting weights",
            "ar": "التعلم يعني تعديل الأوزان"
          },
          {
            "en": "Less error means better answers",
            "ar": "خطأ أقل يعني إجابات أفضل"
          }
        ],
        "takeaway": {
          "en": "Good examples make a good model.",
          "ar": "الأمثلة الجيدة تصنع نموذجًا جيدًا."
        }
      }
    }
  ]
