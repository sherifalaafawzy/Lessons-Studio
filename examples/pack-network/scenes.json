en":"A secure connection: HTTPS","ar":"اتصال آمن: HTTPS"}},{"id":"flow","x":80,"y":150,"w":1120,"h":540,"type":"sequence","participants":[{"id":"you","glyph":"browser","label":{"en":"Your browser","ar":"متصفحك"}},{"id":"spy","glyph":"eye","label":{"en":"On the same Wi-Fi","ar":"على الشبكة نفسها"}},{"id":"site","glyph":"server","label":{"en":"grades.example","ar":"grades.example"}}],"messages":[{"from":"you","to":"site","label":{"en":"Hello! Let's talk safely","ar":"مرحبًا! لنتحدث بأمان"}},{"from":"site","to":"you","label":{"en":"Certificate and key share","ar":"الشهادة وجزء المفتاح"},"reply":true},{"from":"you","to":"site","label":{"en":"My key share","ar":"جزء مفتاحي"}},{"from":"you","to":"site","label":{"en":"Show my grades","ar":"أرني درجاتي"},"lock":true,"tone":"ok"},{"from":"site","to":"you","label":{"en":"Your grades","ar":"درجاتك"},"reply":true,"lock":true,"tone":"ok"}],"notes":[{"after":2,"over":["you"],"text":{"en":"Checks the certificate","ar":"يتحقق من الشهادة"}}],"anim":[{"prop":"reveal","keys":[{"at":0.2,"value":0},{"at":1,"value":0.1429,"ease":"out"},{"at":{"word":{"en":"shake","ar":"يتصافح"}},"value":0.1429},{"at":{"word":{"en":"shake","ar":"يتصافح"},"offset":0.8},"value":0.2857,"ease":"out"},{"at":{"word":{"en":"certificate","ar":"شهادته"}},"value":0.2857},{"at":{"word":{"en":"certificate","ar":"شهادته"},"offset":0.8},"value":0.4286,"ease":"out"},{"at":{"word":{"en":"checks","ar":"ويتحقق"}},"value":0.4286},{"at":{"word":{"en":"checks","ar":"ويتحقق"},"offset":0.8},"value":0.5714,"ease":"out"},{"at":{"word":{"en":"key","ar":"المفتاح"}},"value":0.5714},{"at":{"word":{"en":"key","ar":"المفتاح"},"offset":0.8},"value":0.7143,"ease":"out"},{"at":{"word":{"en":"everything","ar":"يسافر"}},"value":0.7143},{"at":{"word":{"en":"everything","ar":"يسافر"},"offset":0.8},"value":0.8571,"ease":"out"},{"at":{"word":{"en":"locked","ar":"مقفلًا"}},"value":0.8571},{"at":{"word":{"en":"locked","ar":"مقفلًا"},"offset":0.8},"value":1,"ease":"out"}]},{"prop":"focus","keys":[{"at":{"word":{"en":"everything","ar":"يسافر"}},"value":4,"ease":"step"},{"at":{"word":{"en":"locked","ar":"مقفلًا"},"offset":0.8},"value":5,"ease":"step"}]}]}]}},{"id":"net-https","template":"canvas","narration":{"en":"On a café's Wi-Fi, anyone nearby can capture your packets. With plain HTTP they can read everything, even your password. With HTTPS they still see the addresses and the port, but the page and the password are scrambled.","ar":"على شبكة الواي فاي في المقهى، يستطيع أي شخص قريب التقاط حزمك. مع HTTP العادي يمكنه قراءة كل شيء، حتى كلمة مرورك. أما مع HTTPS فيرى العناوين والمنفذ فقط، وتبقى الصفحة وكلمة المرور مشفّرة."},"content":{"elements":[{"id":"h","type":"text","x":80,"y":48,"w":1120,"size":46,"weight":800,"text":{"en":"What HTTPS hides","ar":"ما الذي يخفيه HTTPS"}},{"id":"packet","x":80,"y":150,"w":1120,"h":540,"type":"packet","fields":[{"name":{"en":"From","ar":"من"},"value":"192.168.1.20","size":"4 B"},{"name":{"en":"To","ar":"إلى"},"value":"203.0.113.10","size":"4 B"},{"name":{"en":"Port","ar":"المنفذ"},"value":"443","size":"2 B"},{"name":{"en":"Page","ar":"الصفحة"},"value":"/grades?id=7","size":"12 B","secret":true,"cipher":"8727 81bc 1cdc"},{"name":{"en":"Password","ar":"كلمة المرور"},"value":"maths2026","size":"9 B","secret":true,"cipher":"d5c4 6651"}],"groups":[{"label":{"en":"IP header","ar":"ترويسة IP"},"span":2,"tone":"accent"},{"label":{"en":"TCP","ar":"TCP"},"span":1,"tone":"accent2"},{"label":{"en":"Data","ar":"البيانات"},"span":2,"tone":"ok"}],"watch":true,"anim":[{"prop":"reveal","keys":[{"at":0.2,"value":0},{"at":{"word":{"en":"capture","ar":"التقاط"},"offset":0.5},"value":1,"ease":"linear"}]},{"prop":"focus","keys":[{"at":{"word":{"en":"password","ar":"مرورك"}},"value":5,"ease":"step"},{"at":{"word":{"en":"HTTPS","ar":"HTTPS"}},"value":0,"ease":"step"}]},{"prop":"frame","keys":[{"at":{"word":{"en":"HTTPS","ar":"HTTPS"}},"value":0},{"at":{"word":{"en":"scrambled","ar":"مشفّرة"},"offset":0.4},"value":1,"ease":"in-out"}]}]}]}},{"id":"net-mesh","template":"canvas","narration":{"en":"Sensors in a mesh pass each reading to a neighbour, hop by hop, until it reaches the gateway. If a link fails, the mesh simply finds another way.","ar":"في الشبكة المتداخلة، يمرّر كل مستشعر قراءته إلى جاره، قفزة بعد قفزة، حتى تصل إلى البوابة. وإذا تعطّل رابط، تجد الشبكة طريقًا آخر ببساطة."},"content":{"elements":[{"id":"h","type":"text","x":80,"y":48,"w":1120,"size":46,"weight":800,"text":{"en":"A mesh of sensors","ar":"شبكة من المستشعرات"}},{"id":"net","x":80,"y":150,"w":1120,"h":540,"type":"topology","layout":"mesh","devices":[{"id":"gw","kind":"gateway","label":{"en":"Gateway","ar":"البوابة"},"x":112,"y":224,"tone":"accent"},{"id":"s1","kind":"sensor","label":{"en":"Class 1","ar":"الصف 1"},"x":381,"y":99},{"id":"s2","kind":"sensor","label":{"en":"Class 2","ar":"الصف 2"},"x":381,"y":368},{"id":"s3","kind":"sensor","label":{"en":"Library","ar":"المكتبة"},"x":694,"y":99},{"id":"s4","kind":"sensor","label":{"en":"Lab","ar":"المختبر"},"x":694,"y":368},{"id":"s5","kind":"sensor","label":{"en":"Garden","ar":"الحديقة"},"x":1008,"y":224}],"links":[{"from":"gw","to":"s1","kind":"wireless"},{"from":"gw","to":"s2","kind":"wireless"},{"from":"s1","to":"s2","kind":"wireless"},{"from":"s1","to":"s3","kind":"wireless","downAt":1},{"from":"s2","to":"s4","kind":"wireless"},{"from":"s3","to":"s4","kind":"wireless"},{"from":"s3","to":"s5","kind":"wireless"},{"from":"s4","to":"s5","kind":"wireless"}],"routes":[{"path":["s5","s3","s1","gw"],"label":{"en":"24 °C","ar":"24 °C"}},{"path":["s5","s4","s2","gw"],"label":{"en":"25 °C","ar":"25 °C"},"tone":"ok"}],"anim":[{"prop":"reveal","keys":[{"at":0.2,"value":0},{"at":{"word":{"en":"neighbour","ar":"جاره"},"offset":0.3},"value":1,"ease":"linear"}]},{"prop":"frame","keys":[{"at":{"word":{"en":"hop","ar":"قفزة"}},"value":0},{"at":{"word":{"en":"gateway","ar":"البوابة"},"offset":0.4},"value":1,"ease":"in-out"},{"at":{"word":{"en":"another","ar":"آخر"}},"value":1},{"at":{"word":{"en":"another","ar":"آخر"},"offset":2.6},"value":2,"ease":"in-out"}]}]}]}},{"id":"net-agent","template":"canvas","narration":{"en":"A good AI agent asks before it acts. The teacher asks it to book the lab. The agent checks the details with her, and only after she says yes does it call the booking tool, then it reports back.","ar":"الوكيل الذكي الجيد يستأذن قبل أن يتصرّف. تطلب المعلّمة منه حجز المختبر. فيراجع الوكيل التفاصيل معها، وبعد أن توافق يستدعي أداة الحجز، ثم يخبرها بالنتيجة."},"content":{"elements":[{"id":"h","type":"text","x":80,"y":48,"w":1120,"size":46,"weight":800,"text":{"en":"An agent asks before it acts","ar":"الوكيل يستأذن قبل أن يتصرّف"}},{"id":"flow","x":80,"y":150,"w":1120,"h":540,"type":"sequence","participants":[{"id":"user","glyph":"user","label":{"en":"Teacher","ar":"المعلّمة"}},{"id":"agent","glyph":"bot","label":{"en":"AI agent","ar":"الوكيل الذكي"}},{"id":"tool","glyph":"tool","label":{"en":"Booking tool","ar":"أداة الحجز"}}],"messages":[{"from":"user","to":"agent","label":{"en":"Book the lab for Tuesday","ar":"احجز المختبر يوم الثلاثاء"}},{"from":"agent","to":"user","label":{"en":"Lab 2, Tue 10:00. Shall I?","ar":"المختبر 2، الثلاثاء 10:00. أحجزه؟"},"tone":"accent"},{"from":"user","to":"agent","label":{"en":"Yes, go ahead","ar":"نعم، تفضّل"},"reply":true,"tone":"ok"},{"from":"agent","to":"tool","label":{"en":"book(lab2, Tue 10:00)","ar":"book(lab2, Tue 10:00)"}},{"from":"tool","to":"agent","label":{"en":"Booked","ar":"تم الحجز"},"reply":true},{"from":"agent","to":"user","label":{"en":"Done: Lab 2 is yours","ar":"تم: المختبر 2 لكِ"},"reply":true}],"anim":[{"prop":"reveal","keys":[{"at":0.2,"value":0},{"at":1,"value":0.1429,"ease":"out"},{"at":{"word":{"en":"book","ar":"حجز"}},"value":0.1429},{"at":{"word":{"en":"book","ar":"حجز"},"offset":0.8},"value":0.2857,"ease":"out"},{"at":{"word":{"en":"checks","ar":"فيراجع"}},"value":0.2857},{"at":{"word":{"en":"checks","ar":"فيراجع"},"offset":0.8},"value":0.4286,"ease":"out"},{"at":{"word":{"en":"yes","ar":"توافق"}},"value":0.4286},{"at":{"word":{"en":"yes","ar":"توافق"},"offset":0.8},"value":0.5714,"ease":"out"},{"at":{"word":{"en":"call","ar":"يستدعي"}},"value":0.5714},{"at":{"word":{"en":"call","ar":"يستدعي"},"offset":0.8},"value":0.7143,"ease":"out"},{"at":{"word":{"en":"call","ar":"يستدعي"},"offset":1},"value":0.7143},{"at":{"word":{"en":"call","ar":"يستدعي"},"offset":1.8},"value":0.8571,"ease":"out"},{"at":{"word":{"en":"reports","ar":"يخبرها"}},"value":0.8571},{"at":{"word":{"en":"reports","ar":"يخبرها"},"offset":0.8},"value":1,"ease":"out"}]},{"prop":"focus","keys":[{"at":{"word":{"en":"checks","ar":"فيراجع"}},"value":2,"ease":"step"},{"at":{"word":{"en":"yes","ar":"توافق"}},"value":3,"ease":"step"},{"at":{"word":{"en":"call","ar":"يستدعي"}},"value":0,"ease":"step"}]}]}]}},{"id":"summary","template":"summary","narration":{"en":"Devices, routes, layers and locks: now you can see the internet at work.","ar":"أجهزة وطرق وطبقات وأقفال: الآن ترى الإنترنت وهو يعمل."},"content":{"title":{"en":"Remember","ar":"تذكّر"},"points":[{"en":"A message hops router by router","ar":"تقفز الرسالة من موجّه إلى موجّه"},{"en":"Each layer adds its own header","ar":"تضيف كل طبقة ترويستها"},{"en":"HTTPS hides the content, not the addresses","ar":"يخفي HTTPS المحتوى لا العناوين"}],"takeaway":{"en":"Look for HTTPS before you type a password.","ar":"ابحث عن HTTPS قبل أن تكتب كلمة المرور."}}}]}
