{"version":"0.2","scenes":[{"id":"title","template":"title-hook","narration":{"en":"What happens inside a connected device? Let's follow the current, the pins and the numbers.","ar":"ماذا يحدث داخل جهاز متصل؟ لنتتبّع التيار والأطراف والأرقام."},"content":{"title":{"en":"Inside a connected device","ar":"داخل جهاز متصل"},"icon":"chip"}},{"id":"loop","template":"canvas","narration":{"en":"A torch is a battery, a switch and a lamp in one loop. Close the switch, and current flows round the loop: the lamp lights. Open it, and the flow stops everywhere.","ar":"المصباح اليدوي بطارية ومفتاح ومصباح في حلقة واحدة. أغلق المفتاح فيسري التيار في الحلقة ويضيء المصباح. افتحه فيتوقف السريان في كل مكان."},"content":{"elements":[{"id":"h","type":"text","x":60,"y":44,"w":1160,"size":48,"weight":800,"text":{"en":"Current needs a closed loop","ar":"التيار يحتاج إلى حلقة مغلقة"},"anim":[{"prop":"y","keys":[{"at":0.1,"value":84},{"at":0.6,"value":44,"ease":"out"}]},{"prop":"opacity","keys":[{"at":0.1,"value":0},{"at":0.4,"value":1,"ease":"out"}]}]},{"id":"c","x":40,"y":140,"w":1200,"h":540,"type":"circuit","parts":[{"id":"bat","kind":"battery","a":[0,0],"b":[0,2],"label":{"en":"3 V","ar":"3 V"},"value":3,"side":"left"},{"id":"sw","kind":"switch","a":[1,0],"b":[3,0],"label":{"en":"switch","ar":"مفتاح"},"side":"above"},{"id":"lamp","kind":"lamp","a":[4,0],"b":[4,2],"label":{"en":"lamp","ar":"مصباح"},"side":"right","show":["V"]}],"wires":[[[0,0],[1,0]],[[3,0],[4,0]],[[4,2],[0,2]]],"frames":[{"closed":{"sw":0},"on":{"lamp":0},"values":{"lamp":"0 V"},"flow":[[0],[0],[0]]},{"closed":{"sw":1},"on":{"lamp":0.99},"values":{"lamp":"3.0 V"},"flow":[[298.21],[298.21],[298.21]]},{"closed":{"sw":0},"on":{"lamp":0},"values":{"lamp":"0 V"},"flow":[[0],[0],[0]]}],"anim":[{"prop":"reveal","keys":[{"at":0.3,"value":0},{"at":1.7,"value":1,"ease":"linear"}]},{"prop":"frame","keys":[{"at":{"word":{"en":"Close","ar":"أغلق"}},"value":0},{"at":{"word":{"en":"Close","ar":"أغلق"},"offset":0.4},"value":1,"ease":"in-o