ration":{"en":"Eight bits make a byte. Each bit has a place value: one, two, four, up to one hundred and twenty-eight. The letter A is stored as sixty-five: sixty-four plus one.","ar":"ثماني بتات تصنع بايتًا. لكل بت قيمة منزلية: واحد، اثنان، أربعة، حتى مئة وثمانية وعشرين. يُخزَّن الحرف A على أنه خمسة وستون: أربعة وستون زائد واحد."},"content":{"elements":[{"id":"h","type":"text","x":60,"y":44,"w":1160,"size":48,"weight":800,"text":{"en":"Place values: 1, 2, 4 … 128","ar":"القيم المنزلية: 1، 2، 4 … 128"},"anim":[{"prop":"y","keys":[{"at":0.1,"value":84},{"at":0.6,"value":44,"ease":"out"}]},{"prop":"opacity","keys":[{"at":0.1,"value":0},{"at":0.4,"value":1,"ease":"out"}]}]},{"id":"b","x":40,"y":210,"w":1200,"h":400,"type":"bits","n":8,"frames":[1,2,4,128,65],"sum":true,"label":{"en":"1 byte","ar":"بايت واحد"},"notes":[null,null,null,null,{"en":"the letter A","ar":"الحرف A"}],"anim":[{"prop":"reveal","keys":[{"at":0.3,"value":0},{"at":1.3,"value":1,"ease":"linear"}]},{"prop":"frame","keys":[{"at":{"word":{"en":"two","ar":"اثنان"}},"value":0},{"at":{"word":{"en":"two","ar":"اثنان"},"offset":0.35},"value":1,"ease":"in-out"},{"at":{"word":{"en":"four","ar":"أربعة"}},"value":1},{"at":{"word":{"en":"four","ar":"أربعة"},"offset":0.35},"value":2,"ease":"in-out"},{"at":{"word":{"en":"hundred","ar":"مئة"}},"value":2},{"at":{"word":{"en":"hundred","ar":"مئة"},"offset":0.35},"value":3,"ease":"in-out"},{"at":{"word":{"en":"letter","ar":"الحرف"}},"value":3},{"at":{"word":{"en":"letter","ar":"الحرف"},"offset":0.35},"value":4,"ease":"in-out"}]}]}]}},{"id":"summary","template":"summary","narration":{"en":"Current in a loop, pins with names, readings turned into numbers, and logic that decides: that's every smart device.","ar":"تيار في حلقة، وأطراف لها أسماء، وقراءات تتحول إلى أرقام، ومنطق يقرّر: هذا هو كل جهاز ذكي."},"content":{"title":{"en":"Remember","ar":"تذكّر"},"points":[{"en":"Current flows only round a closed loop","ar":"يسري التيار في حلقة مغلقة فقط"},{"en":"A resistor keeps an LED safe","ar":"المقاومة تحمي الثنائي LED"},{"en":"Sensors become numbers; thresholds become decisions","ar":"الحساسات تصير أرقامًا، والعتبات تصير قرارات"}],"takeaway":{"en":"Every smart device is a loop, a few pins and some logic.","ar":"كل جهاز ذكي حلقة وبضعة أطراف وقليل من المنطق."}}}]}
